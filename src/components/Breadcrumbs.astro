---
interface Props { items: { name: string; path: string }[]; lang?: 'es' | 'en'; }
const { items, lang = 'es' } = Astro.props;
---
<nav class="breadcrumbs" aria-label={lang === 'en' ? 'Breadcrumb' : 'Ruta de navegación'}>
  <ol>{items.map((item, index) => <li>{index === items.length - 1
    ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}</li>)}</ol>
</nav>
<style>
  .breadcrumbs{margin-bottom:22px;font-size:13px;line-height:1.6}
  ol{display:flex;flex-wrap:wrap;gap:6px 10px;list-style:none;padding:0;margin:0}
  li+li::before{content:'/';margin-right:10px;opacity:.55}
  a{text-decoration:underline;text-underline-offset:3px}a:hover{color:var(--orange)}
  [aria-current]{opacity:.8}
</style>
