---
const mobileMedia = '(max-width: 767px), (max-width: 1024px) and (hover: none) and (pointer: coarse)';
const desktopImages = [
  '/slider/hero-controle-teinte.jpeg',
  '/slider/hero-car-o-liner-benchrack.webp',
  '/slider/hero-preparation-peinture.jpeg',
  '/slider/hero-inspection-carrosserie.jpeg',
  '/slider/hero-cabine-peinture.jpeg',
  '/slider/desktop/car-o-liner-medicion.webp',
  '/slider/desktop/sata-equipo-pintura.webp',
  '/slider/desktop/sata-jet-x.webp',
  '/slider/desktop/car-o-liner-benchrack.webp',
];
const mobileImages = [
  '/slider/mobile/sata-equipo-taller.webp',
  '/slider/mobile/sata-inspeccion-carroceria.webp',
  '/slider/mobile/sata-especialista-pintura.webp',
];
// Hidden desktop slides use a tiny local fallback on mobile to avoid downloading them.
const emptyImage = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<div class="hero-slider" aria-hidden="true">
  {desktopImages.map((desktop, index) => (
    <picture style={`--slide-image:url("${desktop}")`} class:list={['hero-slide', {
      'desktop-only': index >= mobileImages.length,
    }]}>
      <source media={mobileMedia} srcset={mobileImages[index] || emptyImage} />
      <img src={desktop} alt="" fetchpriority={index === 0 ? 'high' : 'auto'} />
    </picture>
  ))}
</div>

<style>
  .hero-slider{position:absolute;inset:0;z-index:0;background:#050720}
  .hero-slide{position:absolute;inset:0;opacity:0;animation:heroFade 54s infinite;transform:scale(1.03)}
  .hero-slide img{display:block;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center}
  .hero-slide:nth-child(2){animation-delay:6s}
  .hero-slide:nth-child(3){animation-delay:12s}
  .hero-slide:nth-child(4){animation-delay:18s}
  .hero-slide:nth-child(5){animation-delay:24s}
  .hero-slide:nth-child(6){animation-delay:30s}
  .hero-slide:nth-child(7){animation-delay:36s}
  .hero-slide:nth-child(8){animation-delay:42s}
  .hero-slide:nth-child(9){animation-delay:48s}
  .hero-slider:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,11,47,.72),rgba(7,11,47,.34))}
  @keyframes heroFade{0%{opacity:0}1.7778%{opacity:1}11.1111%{opacity:1}12.8889%{opacity:0}100%{opacity:0}}

  /* Preserve the complete photograph behind the copy. A blurred extension of
     the same photo fills wide screens without enlarging or cutting the subject. */
  @media (min-width:768px) and (hover:hover), (min-width:768px) and (pointer:fine), (min-width:1025px){
    .hero-slide{transform:none}
    .hero-slide:before{
      content:"";
      position:absolute;
      inset:-24px;
      background:var(--slide-image) center/cover no-repeat;
      filter:blur(24px);
      opacity:.65;
    }
    .hero-slide img{position:relative;object-fit:contain;object-position:center}
  }

  @media (max-width:767px), (max-width:1024px) and (hover:none) and (pointer:coarse){
    .hero-slider{position:relative;inset:auto;width:100%;aspect-ratio:4/3;max-height:420px;overflow:hidden}
    .hero-slider:after{background:linear-gradient(180deg,transparent 75%,rgba(7,11,47,.15))}
    .hero-slide{animation-name:heroFadeMobile;animation-duration:18s;transform:none}
    .hero-slide.desktop-only{display:none;animation:none}
    .hero-slide:nth-child(1) img{object-position:50% 90%}
    .hero-slide:nth-child(2) img{object-position:50% 12%}
    .hero-slide:nth-child(3) img{object-position:50% 12%}
  }
  @media (min-width:600px) and (max-width:1024px) and (hover:none) and (pointer:coarse){
    .hero-slide:nth-child(1) img{object-position:50% 65%}
  }
  @keyframes heroFadeMobile{0%{opacity:0}5.3333%{opacity:1}33.3333%{opacity:1}38.6667%{opacity:0}100%{opacity:0}}
</style>

<style is:global>
  @media (max-width:767px), (max-width:1024px) and (hover:none) and (pointer:coarse){
    .home-hero.hero{padding:0!important;margin:0;background:#070b2f}
    .home-hero.hero:before,.home-hero.hero:after{display:none!important}
    .home-hero.hero .hero-inner{display:block!important;padding:26px 20px 32px!important}
    .home-hero.hero .hero-inner .eyebrow{padding:0;border:0;background:none;font-size:9px;line-height:1.5;letter-spacing:.08em}
    .home-hero.hero .hero-inner .dot{width:6px;height:6px;box-shadow:none}
    .home-hero.hero .hero-inner .hero-title{margin:16px 0;font-size:clamp(30px,8.4vw,42px);line-height:1.08;letter-spacing:-.045em}
    .home-hero.hero .hero-inner .hero-title span{white-space:normal}
    .home-hero.hero .hero-inner>div:first-child>p{max-width:calc(100% - 64px);padding:0!important;border:0!important;background:none!important;box-shadow:none!important;backdrop-filter:none!important;font-size:15px;line-height:1.6;color:#dbe4f2}
    .home-hero.hero .hero-inner .hero-actions{display:grid;grid-template-columns:1fr;gap:12px;margin-top:24px;margin-right:64px}
    .home-hero.hero .hero-inner .hero-actions .btn{min-height:50px;width:100%;padding:12px 14px;font-size:11px;letter-spacing:.03em;text-align:center}
    .home-hero.hero>.hero-features,.home-hero.hero>.home-feature-strip{margin:0;grid-template-columns:1fr 1fr;background:#0b1145;backdrop-filter:none}
    .home-hero.hero .hero-feature,.home-hero.hero .home-feature-strip a{min-height:56px;padding:12px 16px;font-size:10px;line-height:1.45}
  }
</style>
