---
import { catalogProducts, productDetailPath } from '../data/products';
import { productFamilies } from '../data/productLines';

interface Props {
  familySlug?: string;
}

const { familySlug } = Astro.props as Props;
const initialProducts = familySlug
  ? catalogProducts.filter((product) => product.familySlug === familySlug)
  : catalogProducts;
const activeFamily = familySlug ? productFamilies.find((family) => family.slug === familySlug) : undefined;
const interests = Array.from(new Set(initialProducts.map((product) => product.interest || product.category))).sort();
const patterns = Array.from(new Set(initialProducts.map((product) => product.sprayPattern || 'Standard'))).sort();
const nozzleTechnologies = Array.from(new Set(initialProducts.map((product) => product.nozzleTechnology || product.technology))).sort();
const defaultInterest = interests.includes('Pistolas con vaso de gravedad')
  ? 'Pistolas con vaso de gravedad'
  : interests[0];
---

<style is:global>
  .catalog-section{background:#fff;padding:92px 28px}
  .catalog-section .container{max-width:1180px;margin:0 auto}
  .catalog-section .section-head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:38px}
  .catalog-section .label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:#d96e12;margin-bottom:10px}
  .catalog-section .section-head h2,.catalog-section .section-title{font-size:clamp(34px,4.2vw,56px);line-height:.98;letter-spacing:-.065em;margin:0;color:#070b2f;max-width:760px}
  .catalog-section .section-head p{max-width:520px;margin:0;color:#657183;line-height:1.7}
  .catalog-shell{background:#eaf6ff;border:0;box-shadow:none;padding:28px}
  .filter-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:20px}
  .filter-btn{min-height:66px;border:1px solid #cfd8e6;background:#fff;padding:12px 16px;font-size:13px;font-weight:900;text-transform:uppercase;color:#070b2f;cursor:pointer;line-height:1.2}
  .filter-btn.active,.filter-btn:hover{border-color:#070b2f;box-shadow:inset 0 0 0 1px #070b2f}
  .catalog-toolbar{display:flex;gap:14px;justify-content:space-between;align-items:end;border-bottom:1px solid #e8edf5;background:#fff;padding:26px 0 26px;margin-top:30px;flex-wrap:wrap}
  .catalog-count{font-size:30px;font-weight:950;color:#070b2f;letter-spacing:-.04em}
  .field{height:48px;border:1px solid #dbe3ef;padding:0 14px;background:#fff;color:#111827;min-width:230px;font:inherit}
  .select-row{display:flex;gap:12px;flex-wrap:wrap;background:#fff;padding:20px 0 0}
  .chips{display:flex;gap:8px;flex-wrap:wrap;background:#fff;padding-top:14px}
  .chips button{border:0;background:#edf1f7;color:#24314d;padding:9px 12px;font-weight:800;cursor:pointer;border-radius:999px}
  .catalog-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;background:#fff;padding-top:30px}
  .product-card{min-height:420px;overflow:hidden;background:#fff;border:1px solid #dbe3ef;box-shadow:none;transition:.2s ease}
  .product-card:hover{transform:translateY(-3px);border-color:#070b2f}
  .product-card a{height:100%;display:flex;flex-direction:column;text-decoration:none;color:inherit}
  .product-image{height:260px;display:flex;align-items:center;justify-content:center;background:#f6f6f6;padding:20px}
  .product-image img{max-width:100%;max-height:100%;width:100%;height:100%;object-fit:contain}
  .product-body{padding:20px;display:flex;flex:1;flex-direction:column}
  .product-body small{color:#657183;font-size:14px;line-height:1.5}
  .product-body h3{margin:8px 0 10px;color:#070b2f;font-size:21px;line-height:1.05;letter-spacing:-.03em}
  .product-body p{color:#647083;line-height:1.55;font-size:14px;margin:0 0 18px}
  .arrow{margin-top:auto;align-self:flex-end;width:46px;height:46px;background:#050720;color:#fff;display:grid;place-items:center;font-size:24px}
  .empty{display:none;border:1px solid #e8edf5;background:#fff;padding:18px;margin-top:20px;color:#647083;font-weight:800}
  .hidden{display:none!important}
  @media(max-width:980px){
    .catalog-section .section-head{display:block}
    .catalog-section .section-head p{margin-top:18px}
    .filter-grid,.catalog-grid{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:640px){
    .catalog-section{padding:72px 20px}
    .filter-grid,.catalog-grid{grid-template-columns:1fr}
    .catalog-shell{padding:18px}
  }
</style>

<section id="catalogo-productos" class="catalog-section">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="label">Catálogo de productos</div>
        <h2>{activeFamily ? activeFamily.shortTitle : 'Productos Etapel'}</h2>
      </div>
      <p>Filtra por tipo de producto, forma del abanico y tecnología. Cada tarjeta abre una ficha con galería, datos técnicos y recursos.</p>
    </div>

    <div class="catalog-shell" data-product-catalog data-default-interest={defaultInterest}>
      <h3 class="section-title" style="font-size:32px">¿Qué te interesa?</h3>
      <div class="filter-grid">
        {interests.map((interest) => (
          <button
            type="button"
            value={interest}
            data-interest-filter
            class={`filter-btn ${interest === defaultInterest ? 'active' : ''}`}
          >
            {interest}
          </button>
        ))}
      </div>

      <div class="catalog-toolbar">
        <div class="catalog-count"><span data-catalog-count>{initialProducts.length}</span> Resultados</div>
        <label>
          <span class="label">Buscar</span>
          <input type="search" data-catalog-search class="field" placeholder="Buscar por producto, uso o marca" />
        </label>
      </div>

      <div class="select-row">
        <select data-pattern-filter class="field">
          <option value="">Forma del abanico</option>
          {patterns.map((pattern) => <option value={pattern}>{pattern}</option>)}
        </select>
        <select data-nozzle-filter class="field">
          <option value="">Tecnología de boquillas</option>
          {nozzleTechnologies.map((technology) => <option value={technology}>{technology}</option>)}
        </select>
      </div>

      <div class="chips" data-active-filters></div>

      <div class="catalog-grid" data-catalog-grid>
        {initialProducts.map((product) => (
          <article
            data-catalog-card
            data-interest={product.interest || product.category}
            data-pattern={product.sprayPattern || 'Standard'}
            data-nozzle={product.nozzleTechnology || product.technology}
            data-search={`${product.name} ${product.brand} ${product.category} ${product.technology} ${product.application} ${product.summary}`.toLowerCase()}
            class="product-card"
          >
            <a href={productDetailPath(product)}>
              <div class="product-image">
                <img src={product.image} alt={product.name} loading="lazy" />
              </div>
              <div class="product-body">
                <small>{product.interest || product.category}</small>
                <h3>{product.name}</h3>
                <p>{product.summary}</p>
                <span class="arrow">→</span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <p class="empty" data-catalog-empty>No hay productos con estos filtros.</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-product-catalog]').forEach((catalog) => {
    const interestButtons = Array.from(catalog.querySelectorAll('[data-interest-filter]'));
    const patternSelect = catalog.querySelector('[data-pattern-filter]');
    const nozzleSelect = catalog.querySelector('[data-nozzle-filter]');
    const searchInput = catalog.querySelector('[data-catalog-search]');
    const countNode = catalog.querySelector('[data-catalog-count]');
    const activeFilters = catalog.querySelector('[data-active-filters]');
    const emptyNode = catalog.querySelector('[data-catalog-empty]');
    const cards = Array.from(catalog.querySelectorAll('[data-catalog-card]'));
    let selectedInterest = catalog.dataset.defaultInterest || '';

    const applyFilters = () => {
      const term = searchInput.value.trim().toLowerCase();
      let count = 0;

      cards.forEach((card) => {
        const matches =
          (!selectedInterest || card.dataset.interest === selectedInterest) &&
          (!patternSelect.value || card.dataset.pattern === patternSelect.value) &&
          (!nozzleSelect.value || card.dataset.nozzle === nozzleSelect.value) &&
          (!term || card.dataset.search.includes(term));

        card.classList.toggle('hidden', !matches);
        if (matches) count += 1;
      });

      countNode.textContent = String(count);
      emptyNode.style.display = count > 0 ? 'none' : 'block';
      interestButtons.forEach((button) => button.classList.toggle('active', button.value === selectedInterest));
      activeFilters.innerHTML = '';
      [selectedInterest, patternSelect.value, nozzleSelect.value].filter(Boolean).forEach((value) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.textContent = `${value} x`;
        chip.addEventListener('click', () => {
          if (selectedInterest === value) selectedInterest = '';
          if (patternSelect.value === value) patternSelect.value = '';
          if (nozzleSelect.value === value) nozzleSelect.value = '';
          applyFilters();
        });
        activeFilters.appendChild(chip);
      });
    };

    interestButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedInterest = selectedInterest === button.value ? '' : button.value;
        applyFilters();
      });
    });
    patternSelect.addEventListener('change', applyFilters);
    nozzleSelect.addEventListener('change', applyFilters);
    searchInput.addEventListener('input', applyFilters);
    applyFilters();
  });
</script>
