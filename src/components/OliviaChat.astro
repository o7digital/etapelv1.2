---
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const lead = en ? {
  title: 'Receive more information', intro: 'Leave your details so the Etapel team can contact you.', firstName: 'First name', lastName: 'Last name', email: 'Email', phone: 'Phone', method: 'Preferred contact method', choose: 'Choose an option', emailOption: 'Email', phoneOption: 'Phone call', whatsapp: 'WhatsApp', consent: 'I accept the', submit: 'Send my request', sending: 'Sending…', success: 'Thank you! Your request was sent to Etapel. Our team will contact you using your preferred method.', error: 'Your request could not be sent. Your details are still here; please try again.', dismiss: 'Continue chatting',
} : {
  title: 'Recibe más información', intro: 'Déjanos tus datos para que el equipo Etapel pueda contactarte.', firstName: 'Nombre', lastName: 'Apellidos', email: 'Correo electrónico', phone: 'Teléfono', method: 'Medio de contacto preferido', choose: 'Selecciona una opción', emailOption: 'Correo electrónico', phoneOption: 'Llamada telefónica', whatsapp: 'WhatsApp', consent: 'Acepto el', submit: 'Enviar mi solicitud', sending: 'Enviando…', success: '¡Gracias! Tu solicitud fue enviada a Etapel. Nuestro equipo te contactará por el medio que elegiste.', error: 'No se pudo enviar tu solicitud. Tus datos siguen aquí; intenta de nuevo.', dismiss: 'Seguir conversando',
};
const copy = en ? {
  open: 'Chat with Olivia', close: 'Close chat', status: 'Etapel assistant', welcome: 'Hello! I’m Olivia, your Etapel assistant. How can I help you with equipment, training or technical support?', placeholder: 'Write your question…', send: 'Send', thinking: 'Olivia is typing…', error: 'I couldn’t answer right now. Please try again or contact our team.', consent: 'By sending a message, you accept our', privacy: 'Privacy Policy', contact: 'Contact an advisor', prompts: ['Explore equipment', 'CEDETEC training', 'Technical support'], retry: 'Try again',
} : {
  open: 'Habla con Olivia', close: 'Cerrar chat', status: 'Asistente Etapel', welcome: '¡Hola! Soy Olivia, tu asistente Etapel. ¿Cómo puedo ayudarte con equipos, capacitación o soporte técnico?', placeholder: 'Escribe tu pregunta…', send: 'Enviar', thinking: 'Olivia está escribiendo…', error: 'No pude responder en este momento. Intenta de nuevo o contacta a nuestro equipo.', consent: 'Al enviar un mensaje, aceptas nuestro', privacy: 'Aviso de Privacidad', contact: 'Contactar a un asesor', prompts: ['Conocer equipos', 'Capacitación CEDETEC', 'Soporte técnico'], retry: 'Reintentar',
};
const sata = en ? {
  title: 'Request a SATA spare-parts quote', intro: 'Share the SATA model, part reference if known or a description, quantity and your contact details here. Etapel will confirm compatibility, price and availability.',
  model: 'SATA model *', reference: 'Part reference, if known', serial: 'Serial number, if available', quantity: 'Quantity *', details: 'Describe the part or your request',
  greeting: 'I can help you prepare a SATA spare-parts quote request. Complete the form here with the model and the part reference or description. You can keep asking me questions while you fill it in.', submit: 'Send my SATA quote request', sources: 'Website sources', help: 'Enter a part reference or describe the part you need.',
} : {
  title: 'Cotiza tus refacciones SATA', intro: 'Comparte aquí el modelo SATA, la referencia si la conoces o una descripción de la pieza, la cantidad y tus datos. Etapel confirmará la compatibilidad, el precio y la disponibilidad.',
  model: 'Modelo SATA *', reference: 'Referencia de la pieza, si la conoces', serial: 'Número de serie, si lo tienes', quantity: 'Cantidad *', details: 'Describe la pieza o tu solicitud',
  greeting: 'Te ayudo a preparar una solicitud de cotización de refacciones SATA. Completa aquí el formulario con el modelo y la referencia o descripción de la pieza. Puedes seguir preguntándome mientras lo llenas.', submit: 'Enviar mi solicitud de refacciones SATA', sources: 'Fuentes del sitio', help: 'Indica una referencia o describe la pieza que necesitas.',
};
---
<div class="olivia-chat" data-lang={lang} data-error={copy.error} data-thinking={copy.thinking} data-retry={copy.retry} data-lead-sending={lead.sending} data-lead-success={lead.success} data-lead-error={lead.error}>
  <div hidden class="olivia-intent-copy"><span data-sata-title>{sata.title}</span><span data-sata-intro>{sata.intro}</span><span data-sata-greeting>{sata.greeting}</span><span data-sata-submit>{sata.submit}</span><span data-source-label>{sata.sources}</span><span data-human-waiting>{en ? "An Etapel advisor is handling your conversation. You can continue writing here." : "Un asesor de Etapel está atendiendo tu conversación. Puedes seguir escribiendo aquí."}</span></div>
  <div class="olivia-panel" id="olivia-panel" role="dialog" aria-labelledby="olivia-title" hidden>
    <div class="olivia-header">
      <div class="olivia-avatar" aria-hidden="true">O<span></span></div>
      <div><strong id="olivia-title">Olivia AI</strong><div class="olivia-status"><i aria-hidden="true"></i>{copy.status}</div></div>
      <button class="olivia-close" type="button" aria-label={copy.close}>×</button>
    </div>
    <div class="olivia-messages" role="log" aria-live="polite" aria-relevant="additions" tabindex="0"><div class="olivia-message assistant">{copy.welcome}</div>
      <form class="olivia-lead" action="https://formspree.io/f/xeewlkng" method="POST" aria-labelledby="olivia-lead-title" hidden>
        <strong id="olivia-lead-title">{lead.title}</strong><p class="olivia-lead-intro">{lead.intro}</p>
        <fieldset class="olivia-sata-fields" hidden disabled>
          <legend>SATA</legend>
          <div class="olivia-lead-grid">
            <label class="olivia-lead-wide" for="olivia-sata-model">{sata.model}<input id="olivia-sata-model" name="modelo_sata" maxlength="160" required /></label>
            <label for="olivia-sata-reference">{sata.reference}<input id="olivia-sata-reference" name="referencia_sata" maxlength="160" /></label>
            <label for="olivia-sata-quantity">{sata.quantity}<input id="olivia-sata-quantity" name="cantidad" type="number" min="1" max="9999" step="1" value="1" required /></label>
            <label class="olivia-lead-wide" for="olivia-sata-serial">{sata.serial}<input id="olivia-sata-serial" name="numero_de_serie_sata" maxlength="160" /></label>
            <label class="olivia-lead-wide" for="olivia-sata-details">{sata.details}<textarea id="olivia-sata-details" name="detalles_refaccion" rows="3" maxlength="2000"></textarea></label>
          </div>
          <p class="olivia-sata-help">{sata.help}</p>
        </fieldset>
        <div class="olivia-lead-grid">
          <label for="olivia-first-name">{lead.firstName}<input id="olivia-first-name" name="nombre" autocomplete="given-name" maxlength="80" required /></label>
          <label for="olivia-last-name">{lead.lastName}<input id="olivia-last-name" name="apellidos" autocomplete="family-name" maxlength="100" required /></label>
          <label for="olivia-email">{lead.email}<input id="olivia-email" name="email" type="email" autocomplete="email" maxlength="254" required /></label>
          <label for="olivia-phone">{lead.phone}<input id="olivia-phone" name="telefono" type="tel" autocomplete="tel" minlength="7" maxlength="30" pattern={String.raw`[+0-9\(\) .\-]{7,30}`} required /></label>
          <label class="olivia-lead-wide" for="olivia-contact-method">{lead.method}<select id="olivia-contact-method" name="medio_de_contacto" required><option value="">{lead.choose}</option><option value="Email">{lead.emailOption}</option><option value="Teléfono">{lead.phoneOption}</option><option value="WhatsApp">{lead.whatsapp}</option></select></label>
        </div>
        <label class="olivia-lead-consent"><input type="checkbox" name="consentimiento" value="Aceptado" required /><span>{lead.consent} <a href={en ? '/en/privacy-policy' : '/aviso-de-privacidad'} target="_blank" rel="noopener noreferrer">{copy.privacy}</a>.</span></label>
        <input type="hidden" name="_subject" value="Solicitud de información — Olivia AI Etapel" />
        <button class="olivia-lead-submit" type="submit">{lead.submit}</button>
        <p class="olivia-lead-feedback" role="status" hidden></p>
        <button class="olivia-lead-dismiss" type="button">{lead.dismiss}</button>
      </form>
    </div>
    <div class="olivia-prompts">{copy.prompts.map(prompt => <button type="button">{prompt}<span aria-hidden="true">↗</span></button>)}</div>
    <div class="olivia-feedback" role="status" hidden></div>
    <form class="olivia-form"><label class="olivia-sr" for="olivia-input">{copy.placeholder}</label><input id="olivia-input" name="message" placeholder={copy.placeholder} maxlength="2000" required autocomplete="off" /><button type="submit" aria-label={copy.send}><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 14-7-5 14-3-6-6-1Z"/><path d="m11 13 8-8"/></svg></button></form>
    <div class="olivia-consent">{copy.consent} <a href={en ? '/en/privacy-policy' : '/aviso-de-privacidad'} target="_blank" rel="noopener noreferrer">{copy.privacy}</a>.</div>
    <button class="olivia-contact" type="button">{copy.contact}<span aria-hidden="true">↗</span></button>
  </div>
  <button class="olivia-toggle" type="button" aria-label={copy.open} aria-controls="olivia-panel" aria-expanded="false"><span class="olivia-avatar" aria-hidden="true">O<span></span></span><span>{copy.open}</span><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-1 1v-9.5A8.5 8.5 0 0 1 11.5 3h1a8.5 8.5 0 0 1 8.5 8.5Z"/></svg></button>
</div>
<script>
  import { requestsInformation } from '../lib/oliviaLead.js';
  const root = document.querySelector<HTMLElement>('.olivia-chat')!;
  const toggle = root.querySelector<HTMLButtonElement>('.olivia-toggle')!;
  const panel = root.querySelector<HTMLElement>('.olivia-panel')!;
  const input = root.querySelector<HTMLInputElement>('#olivia-input')!;
  const form = root.querySelector<HTMLFormElement>('.olivia-form')!;
  const submit = form.querySelector<HTMLButtonElement>('button')!;
  const messages = root.querySelector<HTMLElement>('.olivia-messages')!;
  const prompts = root.querySelector<HTMLElement>('.olivia-prompts')!;
  const feedback = root.querySelector<HTMLElement>('.olivia-feedback')!;
  const leadForm = root.querySelector<HTMLFormElement>('.olivia-lead')!;
  const leadFeedback = root.querySelector<HTMLElement>('.olivia-lead-feedback')!;
  const leadSubmit = root.querySelector<HTMLButtonElement>('.olivia-lead-submit')!;
  const sataFields = root.querySelector<HTMLFieldSetElement>('.olivia-sata-fields')!;
  const leadTitle = root.querySelector<HTMLElement>('#olivia-lead-title')!;
  const leadIntro = root.querySelector<HTMLElement>('.olivia-lead-intro')!;
  const intentCopy = (name: string) => root.querySelector<HTMLElement>(`[data-${name}]`)!.textContent!;
  const transcript: string[] = [];
  let leadSent = false;
  let leadBusy = false;
  let requestMessage = '';
  let intent: 'sata-parts' | undefined;
  let sataIntroduced = false;
  const sataReference = root.querySelector<HTMLInputElement>('#olivia-sata-reference')!;
  const sataDetails = root.querySelector<HTMLTextAreaElement>('#olivia-sata-details')!;
  const requirePart = () => { sataDetails.required = intent === 'sata-parts' && !sataReference.value.trim(); };
  sataReference.addEventListener('input', requirePart);
  function showLead() {
    prompts.hidden = true;
    if (!leadSent) { leadForm.hidden = false; messages.append(leadForm); }
    if (!leadSent) leadForm.scrollIntoView({ block: 'start' });
    else messages.scrollTop = messages.scrollHeight;
  }
  root.querySelector('.olivia-contact')!.addEventListener('click', () => {
    showLead();
    if (!leadSent) leadForm.querySelector<HTMLInputElement>('input:not(:disabled):not([type="hidden"])')!.focus();
  });
  root.querySelector('.olivia-lead-dismiss')!.addEventListener('click', () => { leadForm.hidden = true; input.focus(); });
  document.addEventListener('click', (event) => {
    const finder = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-olivia-sata="true"]') : null;
    if (!finder || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    open(true);
    if (leadBusy) return;
    if (leadSent) { leadSent = false; sataIntroduced = false; leadForm.reset(); }
    intent = 'sata-parts';
    sataFields.hidden = false; sataFields.disabled = false;
    requirePart();
    leadTitle.textContent = intentCopy('sata-title'); leadIntro.textContent = intentCopy('sata-intro'); leadSubmit.textContent = intentCopy('sata-submit');
    requestMessage = intentCopy('sata-title');
    if (!sataIntroduced) { add('assistant', intentCopy('sata-greeting')); sataIntroduced = true; }
    showLead();
    root.querySelector<HTMLInputElement>('#olivia-sata-model')!.focus({ preventScroll: true });
  });
  leadForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy || leadBusy || leadSent || !leadForm.reportValidity()) return;
    // Reject whitespace-only names as well as empty fields.
    for (const field of leadForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type="checkbox"]):not([type="hidden"]),textarea')) {
      field.value = field.value.trim();
    }
    requirePart();
    if (!leadForm.reportValidity()) return;
    leadBusy = true; leadSubmit.disabled = true; input.disabled = true; submit.disabled = true;
    const label = leadSubmit.textContent;
    leadSubmit.textContent = root.dataset.leadSending!;
    leadFeedback.hidden = true;
    const payload = Object.fromEntries(new FormData(leadForm));
    Object.assign(payload, { origen: intent === 'sata-parts' ? 'Buscador de refacciones SATA — Olivia AI Etapel' : 'Olivia AI Etapel', idioma: root.dataset.lang!, pagina: window.location.href, mensaje: requestMessage || 'Solicitud de contacto desde Olivia AI', conversacion: transcript.slice(-8).join('\n') });
    if (intent === 'sata-parts') payload._subject = leadTitle.textContent || '';
    try {
      const need = [requestMessage || transcript.filter(line => line.startsWith('user: ')).at(-1)?.slice(6) || 'Solicitud de contacto desde Olivia AI', ...['modelo_sata','referencia_sata','cantidad','numero_de_serie_sata','detalles_refaccion'].filter(key => payload[key]).map(key => `${key}: ${payload[key]}`)].join('\n').slice(0, 4000);
      const receipt = await fetch('/api/olivia', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'contact', language: root.dataset.lang, conversation, page: window.location.pathname, intent, requestId: contactRequestId, contact: { name: `${payload.nombre} ${payload.apellidos}`.trim(), email: payload.email, phone: payload.telefono, need, method: payload.medio_de_contacto, consent: payload.consentimiento === 'Aceptado' } }), signal: AbortSignal.timeout(20000) });
      const saved = await receipt.json();
      if (typeof saved.conversation === 'string') conversation = saved.conversation;
      if (!receipt.ok || saved.saved !== true) throw new Error('Contact intake unavailable');
      const response = await fetch(leadForm.action, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload), signal: AbortSignal.timeout(20000) });
      if (!response.ok) throw new Error('Lead delivery failed');
      leadSent = true; contactRequestId = crypto.randomUUID(); leadForm.hidden = true; leadForm.reset(); add('assistant', root.dataset.leadSuccess!);
    } catch {
      leadFeedback.textContent = root.dataset.leadError!; leadFeedback.hidden = false;
      leadFeedback.scrollIntoView({ block: 'nearest' });
    } finally { leadBusy = false; leadSubmit.disabled = busy; input.disabled = busy; submit.disabled = busy; leadSubmit.textContent = label; }
  });
  let conversation: string | undefined;
  let contactRequestId = crypto.randomUUID();
  let pendingRequestId = '';
  let humanStatus = false;
  let polling = false;
  const operatorMessages = new Set<string>();
  let busy = false;
  let pending = '';
  function open(value: boolean) { panel.hidden = !value; toggle.setAttribute('aria-expanded', String(value)); if (value) { input.focus(); void poll(); } else toggle.focus(); }
  toggle.addEventListener('click', () => open(panel.hidden));
  root.querySelector('.olivia-close')!.addEventListener('click', () => open(false));
  root.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !panel.hidden) open(false);
  });
  function add(role: string, text: string, sources: { title: string; url: string }[] = []) {
    const el = document.createElement('div'); el.className = `olivia-message ${role}`; el.textContent = text;
    if (role === 'assistant' && Array.isArray(sources)) {
      const links = document.createElement('div'); links.className = 'olivia-sources'; links.setAttribute('aria-label', intentCopy('source-label'));
      for (const source of sources.slice(0, 4)) {
        try {
          const url = new URL(source.url);
          if (url.origin !== 'https://www.etapel.com' || typeof source.title !== 'string') continue;
          const link = document.createElement('a'); link.href = url.href; link.textContent = source.title; link.target = '_blank'; link.rel = 'noopener noreferrer'; links.append(link);
        } catch { /* Invalid source links cannot become interactive. */ }
      }
      if (links.children.length) el.append(links);
    }
    const editingLead = leadForm.contains(document.activeElement);
    if (!leadForm.hidden) messages.insertBefore(el, leadForm); else messages.append(el);
    transcript.push(`${role}: ${text}`);
    if (!editingLead) {
      if (!leadForm.hidden) el.scrollIntoView({ block: 'nearest' });
      else messages.scrollTop = messages.scrollHeight;
    }
  }
  async function send(message: string, retry = false) {
    if (busy || leadBusy || !message.trim()) return;
    busy = true; leadSubmit.disabled = true; pending = message; input.value = ''; submit.disabled = true; input.disabled = true; prompts.hidden = true;
    if (!retry) { pendingRequestId = crypto.randomUUID(); add('user', message); }
    if (requestsInformation(message)) requestMessage = message;
    feedback.hidden = false; feedback.textContent = root.dataset.thinking!;
    try {
      const response = await fetch('/api/olivia', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message, requestId: pendingRequestId, language: root.dataset.lang, conversation, page: window.location.pathname, intent }), signal: AbortSignal.timeout(60000) });
      const data = await response.json();
      if (typeof data.conversation === 'string') conversation = data.conversation;
      if (!response.ok) throw new Error('Unavailable');
      if (typeof data.answer !== 'string' || typeof data.conversation !== 'string') throw new Error('Invalid response');
      conversation = data.conversation; if (data.answer) add('assistant', data.answer, data.sources); pending = '';
      humanStatus = data.status === 'manual'; showHumanStatus();
    } catch {
      feedback.textContent = root.dataset.error!;
      const retryButton = document.createElement('button'); retryButton.type = 'button'; retryButton.textContent = root.dataset.retry!;
      retryButton.addEventListener('click', () => send(pending, true)); feedback.append(retryButton);
    } finally { busy = false; leadSubmit.disabled = leadBusy; submit.disabled = leadBusy; input.disabled = leadBusy; if (!panel.hidden && leadForm.hidden) input.focus(); }
  }
  function showHumanStatus() {
    feedback.hidden = !humanStatus;
    feedback.textContent = humanStatus ? intentCopy('human-waiting') : '';
  }
  async function poll() {
    if (!conversation || panel.hidden || document.hidden || busy || polling) return;
    polling = true;
    try {
      const response = await fetch(`/api/olivia?conversation=${encodeURIComponent(conversation)}`, { cache: 'no-store', signal: AbortSignal.timeout(12000) });
      if (!response.ok) return;
      const data = await response.json();
      for (const message of Array.isArray(data.messages) ? data.messages : []) {
        if (typeof message.id !== 'string' || typeof message.content !== 'string' || operatorMessages.has(message.id)) continue;
        operatorMessages.add(message.id); add('assistant', `Etapel: ${message.content}`);
      }
      humanStatus = data.status === 'manual';
      if (!busy && !pending) showHumanStatus();
    } catch { /* Keep the conversation visible and retry on the next poll. */ }
    finally { polling = false; }
  }
  window.setInterval(() => { void poll(); }, 3000);
  form.addEventListener('submit', (event) => { event.preventDefault(); void send(input.value.trim()); });
  prompts.querySelectorAll('button').forEach(button => button.addEventListener('click', () => { void send(button.firstChild!.textContent!.trim()); }));
</script>
<style is:global>
.olivia-sata-help{margin:10px 0 0;font-size:11px;color:#b9c3df}.olivia-sata-fields{margin:0 0 18px;padding:0 0 18px;min-width:0;border:0;border-bottom:1px solid #ffffff26}.olivia-sata-fields legend{padding:0;font-weight:800;color:#fba555;font-size:12px}.olivia-lead-grid textarea{box-sizing:border-box;width:100%;min-width:0;padding:10px;border:1px solid #ffffff26;border-radius:9px;background:#0c122b;color:#fff;font:inherit;font-size:14px;resize:vertical}.olivia-sources{display:grid;gap:6px;margin-top:12px;padding-top:10px;border-top:1px solid #ffffff20;white-space:normal}.olivia-sources a{color:#ffbd85;font-size:11px;line-height:1.5;text-decoration:underline;overflow-wrap:anywhere}
@media(max-width:767px),(max-width:1024px) and (hover:none) and (pointer:coarse){
  .olivia-chat .olivia-toggle{width:52px;height:52px;padding:0;justify-content:center;animation:none}
  .olivia-chat .olivia-toggle>.olivia-avatar{width:46px;height:46px}
  .olivia-chat .olivia-toggle>span:not(.olivia-avatar),.olivia-chat .olivia-toggle>svg{display:none}
}
.olivia-lead{flex-shrink:0;padding:16px;border:1px solid #f5822055;border-radius:18px;background:#171e3b;color:#e1e6f2}.olivia-lead>strong{font-size:15px}.olivia-lead>p{margin:7px 0 14px;font-size:12px;color:#b9c3df}.olivia-lead-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.olivia-lead-grid label{display:grid;gap:5px;font-size:11px;color:#c9d2e8;min-width:0}.olivia-lead-grid input,.olivia-lead-grid select{box-sizing:border-box;width:100%;min-width:0;padding:10px;border:1px solid #ffffff26;border-radius:9px;background:#0c122b;color:white;font:inherit;font-size:14px}.olivia-lead-wide{grid-column:1/-1}.olivia-lead-consent{display:flex;align-items:flex-start;gap:8px;margin:14px 0;font-size:11px;color:#c9d2e8}.olivia-lead-consent input{flex:0 0 auto;margin:3px 0 0;accent-color:#f58220}.olivia-lead a{color:#e1e6f2;text-decoration:underline}.olivia-lead-submit{width:100%;padding:11px;border:0;border-radius:10px;background:#f58220;color:#10142d;font-weight:700!important}.olivia-lead-submit:disabled{opacity:.5;cursor:wait}.olivia-lead-dismiss{display:block;margin:10px auto 0;border:0;background:none;color:#bac5df;font-size:11px!important;text-decoration:underline}.olivia-lead .olivia-lead-feedback{color:#ffcbab;margin:10px 0 0}.olivia-panel:has(.olivia-lead:not([hidden])){animation:none}
@media(max-width:640px){.olivia-lead-grid input,.olivia-lead-grid select{font-size:16px}.olivia-lead-grid{grid-template-columns:1fr}}

