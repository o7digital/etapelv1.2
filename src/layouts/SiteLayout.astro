---
interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
}

const { title, description, lang = 'es' } = Astro.props as Props;
const english = lang === 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/etapel-logo.svg" />
    <style is:global>
      :root{--navy:#070b2f;--navy-2:#0b1145;--navy-3:#101a5f;--ink:#111827;--muted:#5f6b7a;--line:#e8edf5;--white:#fff;--soft:#f5f7fb;--orange:#f58220;--orange-dark:#d96e12;--green:#559a17;--shadow:0 26px 70px rgba(7,11,47,.18);--shadow-soft:0 16px 44px rgba(7,11,47,.10);--max:1180px}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}.nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px;position:relative}.brand img{width:168px;height:auto}.menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;white-space:nowrap}.menu a{opacity:.86}.menu a:hover{opacity:1;color:var(--orange-dark)}.nav-actions{display:flex;align-items:center;gap:12px}.lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;transition:.2s ease;cursor:pointer}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}.btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}.btn.outline{background:transparent;color:#fff;border-color:rgba(255,255,255,.28)}.btn.outline:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.44)}.btn.outline-dark{background:#fff;color:var(--navy);border-color:var(--line)}.mobile-menu{display:none}.mobile-menu summary{width:46px;height:46px;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;list-style:none;background:#fff}.mobile-menu summary::-webkit-details-marker{display:none}.hamburger,.hamburger:before,.hamburger:after{display:block;width:22px;height:2px;background:var(--navy);content:"";transition:.2s ease}.hamburger:before{transform:translateY(-7px)}.hamburger:after{transform:translateY(5px)}.mobile-menu[open] .hamburger{background:transparent}.mobile-menu[open] .hamburger:before{transform:translateY(2px) rotate(45deg)}.mobile-menu[open] .hamburger:after{transform:translateY(0) rotate(-45deg)}.mobile-panel{position:absolute;right:28px;top:calc(100% + 12px);width:min(88vw,360px);background:#fff;border:1px solid var(--line);box-shadow:0 22px 60px rgba(7,11,47,.18);padding:12px;display:grid;gap:4px}.mobile-panel a{padding:14px 16px;font-weight:850;color:#17203b}.mobile-panel a:hover{background:#f6f8fc;color:var(--orange-dark)}.mobile-panel .mobile-cta{margin-top:6px;background:var(--orange);color:#fff;text-align:center}.container{max-width:var(--max);margin:0 auto}.page-hero{position:relative;overflow:hidden;background:radial-gradient(circle at 78% 24%,rgba(245,130,32,.16),transparent 31%),linear-gradient(135deg,#070b2f 0%,#0b1145 48%,#050720 100%);color:#fff}.page-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(to bottom,#000,transparent 88%);opacity:.7}.page-hero-inner{position:relative;z-index:1;max-width:var(--max);margin:0 auto;padding:88px 28px;display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}.eyebrow{display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#f8fafc}.dot{width:8px;height:8px;background:var(--orange);box-shadow:0 0 0 6px rgba(245,130,32,.17)}h1{font-size:clamp(42px,5.5vw,72px);line-height:.94;letter-spacing:-.07em;margin:24px 0 18px}.page-hero p{font-size:18px;line-height:1.7;color:#dbe4f2;margin:0;max-width:720px}.hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:32px}.hero-panel{background:#fff;color:var(--navy);box-shadow:var(--shadow);border-left:8px solid var(--orange);padding:30px}.hero-panel-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.hero-chip{border:1px solid var(--line);background:#f7f8fb;padding:16px;font-weight:900;color:var(--navy)}section{padding:86px 28px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:38px}.label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:10px}.section-head h2,.section-title{font-size:clamp(34px,4.2vw,56px);line-height:.98;letter-spacing:-.065em;margin:0;color:var(--navy);max-width:760px}.section-head p{max-width:430px;margin:0;color:#657183;line-height:1.7}.grid-families{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.family-tile,.catalog-shell,.product-card,.detail-panel{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft)}.family-tile{display:grid;grid-template-columns:1fr 240px;gap:24px;min-height:310px;overflow:hidden}.family-copy{padding:30px}.family-copy h3{font-size:32px;line-height:1;letter-spacing:-.05em;color:var(--navy);margin:8px 0 14px}.family-copy p{color:#606b7a;line-height:1.65}.family-copy ul{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:8px;color:#364152;font-size:14px;font-weight:750}.family-copy li:before{content:"-";color:var(--orange);margin-right:8px;font-weight:900}.family-media{display:flex;align-items:center;justify-content:center;background:#f6f8fc;padding:22px}.catalog-section{background:var(--soft)}.catalog-shell{padding:28px}.filter-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:20px}.filter-btn{min-height:62px;border:1px solid var(--line);background:#fff;padding:12px;font-size:12px;font-weight:900;text-transform:uppercase;color:var(--navy);cursor:pointer}.filter-btn.active,.filter-btn:hover{border-color:var(--navy);box-shadow:inset 0 0 0 1px var(--navy)}.catalog-toolbar{display:flex;gap:14px;justify-content:space-between;align-items:end;border-bottom:1px solid var(--line);padding:26px 0;margin-top:24px;flex-wrap:wrap}.catalog-count{font-size:30px;font-weight:950;color:var(--navy);letter-spacing:-.04em}.field{height:48px;border:1px solid var(--line);padding:0 14px;background:#fff;color:var(--ink);min-width:230px}.select-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips button{border:0;background:#edf1f7;color:#24314d;padding:9px 12px;font-weight:800;cursor:pointer}.catalog-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:30px}.product-card{min-height:420px;overflow:hidden;transition:.2s ease}.product-card:hover{transform:translateY(-3px);border-color:var(--navy)}.product-card a{height:100%;display:flex;flex-direction:column}.product-image{height:230px;display:flex;align-items:center;justify-content:center;background:#f6f6f6;padding:20px}.product-image img{max-height:100%;object-fit:contain}.product-body{padding:20px;display:flex;flex:1;flex-direction:column}.product-body small{color:#657183}.product-body h3{margin:8px 0 10px;color:var(--navy);font-size:21px;line-height:1.05;letter-spacing:-.03em}.product-body p{color:#647083;line-height:1.55;font-size:14px}.arrow{margin-top:auto;align-self:flex-end;width:46px;height:46px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:24px}.empty{display:none;border:1px solid var(--line);background:#fff;padding:18px;margin-top:20px;color:#647083;font-weight:800}.hidden{display:none!important}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:38px}.gallery-box{background:#f7f7f7;padding:22px}.gallery-main{min-height:460px;display:flex;align-items:center;justify-content:center}.gallery-main img{max-height:440px;object-fit:contain}.thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:14px}.thumbs button{aspect-ratio:1;border:1px solid var(--line);background:#fff;padding:8px;cursor:pointer}.thumbs button.active{border-color:var(--navy);box-shadow:inset 0 0 0 1px var(--navy)}.detail-copy h1{font-size:clamp(34px,4vw,54px);color:var(--navy)}.badges{display:flex;gap:8px;flex-wrap:wrap}.badge{background:rgba(245,130,32,.12);color:var(--orange-dark);padding:8px 10px;font-size:11px;font-weight:950;text-transform:uppercase;letter-spacing:.1em}.option-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.option-grid button{min-height:48px;border:1px solid var(--line);background:#fff;font-weight:850;color:var(--navy)}.option-grid button.selected{border-color:var(--navy);box-shadow:inset 0 0 0 1px var(--navy)}.option-grid button:disabled{background:#f1f3f7;color:#a6adba}.tabs{display:flex;gap:26px;border-bottom:1px solid var(--line);margin-top:70px;flex-wrap:wrap}.tab{border:0;border-bottom:3px solid transparent;background:transparent;padding:0 0 16px;font-size:18px;font-weight:900;color:#6b7280;cursor:pointer}.tab.active{border-color:var(--navy);color:var(--navy)}.panel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:24px}.info-row{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding:16px 0}.related{background:#f6f8fc}.footer{padding:34px 28px;background:#050720;color:#aeb8cf}.footer-inner{max-width:var(--max);margin:0 auto;display:flex;justify-content:space-between;gap:20px;align-items:center}.footer img{width:128px;filter:brightness(0) invert(1)}
      @media(max-width:1040px){.menu{display:none}.nav-actions{display:none}.mobile-menu{display:block}.page-hero-inner,.detail-grid{grid-template-columns:1fr}.grid-families,.catalog-grid{grid-template-columns:repeat(2,1fr)}.filter-grid{grid-template-columns:repeat(2,1fr)}.family-tile{grid-template-columns:1fr}.family-media{min-height:220px}}@media(max-width:640px){.nav{height:70px;padding:0 18px}.brand img{width:140px}.mobile-panel{right:18px}.page-hero-inner{padding:58px 20px}.hero-panel{padding:22px}.hero-panel-grid,.grid-families,.catalog-grid,.panel-grid{grid-template-columns:1fr}.filter-grid{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:18px}.option-grid{grid-template-columns:1fr}.info-row{display:block}.info-row dd{text-align:left!important;margin-top:8px!important}.footer-inner{flex-direction:column;align-items:flex-start}}
    </style>
  </head>
  <body>
    <div class="topline"></div>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href={english ? '/en' : '/'}><img src="/etapel-logo.svg" alt="Etapel" /></a>
        <div class="menu">
          <a href={english ? '/en' : '/'}>Home</a>
          <a href={english ? '/en/product-lines' : '/linea-de-producto'}>{english ? 'Product Lines' : 'Línea de Producto'}</a>
          <a href={english ? '/en/about-us' : '/#quienes'}>{english ? 'About Us' : '¿Quiénes Somos?'}</a>
          <a href={english ? '/en/training' : '/#capacitacion'}>{english ? 'Training' : 'Capacitación'}</a>
          <a href={english ? '/en/after-sales' : '/#postventa'}>{english ? 'After-Sales' : 'Posventa'}</a>
          <a href={english ? '/en/contact' : '/contacto'}>{english ? 'Contact' : 'Contacto'}</a>
        </div>
        <div class="nav-actions"><a class="lang" href={english ? '/' : '/en'} aria-label={english ? 'Cambiar idioma a español' : 'Cambiar idioma a inglés'}>{english ? 'ES' : 'EN'}</a><a class="btn orange" href={english ? '/en/contact' : '/contacto'}>{english ? 'Request information' : 'Solicitar información'}</a></div>
        <details class="mobile-menu">
          <summary aria-label="Abrir menú"><span class="hamburger"></span></summary>
          <div class="mobile-panel">
            <a href={english ? '/en' : '/'}>Home</a>
            <a href={english ? '/en/product-lines' : '/linea-de-producto'}>{english ? 'Product Lines' : 'Línea de Producto'}</a>
            <a href={english ? '/en/about-us' : '/#quienes'}>{english ? 'About Us' : '¿Quiénes Somos?'}</a>
            <a href={english ? '/en/training' : '/#capacitacion'}>{english ? 'Training' : 'Capacitación'}</a>
            <a href={english ? '/en/after-sales' : '/#postventa'}>{english ? 'After-Sales' : 'Posventa'}</a>
            <a href={english ? '/en/contact' : '/contacto'}>{english ? 'Contact' : 'Contacto'}</a>
            <a href={english ? '/' : '/en'}>{english ? 'ES' : 'EN'}</a>
            <a class="mobile-cta" href={english ? '/en/contact' : '/contacto'}>{english ? 'Request information' : 'Solicitar información'}</a>
          </div>
        </details>
      </nav>
    </header>
    <slot />
    {english ? (
      <footer class="footer footer-full">
        <div class="footer-grid">
          <div><img src="/etapel-logo.svg" alt="Etapel" /><p>At Etapel, we are more than suppliers: we are partners in the growth of your business.</p><p>Discover how we can help you reach new levels of success.</p></div>
          <div><h3>Product lines</h3><ul><li><a href="/linea-de-producto/pintura">Paint</a></li><li><a href="/linea-de-producto/cabinas-y-preparacion">Spray Booths & Preparation</a></li><li><a href="/linea-de-producto/soldadura-y-enderezado">Welding & Body Repair</a></li><li><a href="/linea-de-producto/mecanica-y-aire">Mechanics & Air</a></li></ul></div>
          <div><h3>Services</h3><ul><li><a href="/en/training">Training</a></li><li><a href="/en/after-sales">After-Sales</a></li></ul></div>
          <div><h3>Contact</h3><ul><li><a href="mailto:ventas@etapel.com.mx">ventas@etapel.com.mx</a></li><li><a href="tel:+525556895055">55 5689 5055</a></li><li><a href="https://wa.link/oowyzu">WhatsApp</a></li></ul></div>
        </div>
        <div class="footer-bottom"><span>Copyright © 2026 Etapel. All rights reserved.</span><div><a href="/en/contact">Need help? Contact us</a><a href="/en/privacy-policy">Privacy Policy</a><a href="/">Versión en español</a></div></div>
      </footer>
    ) : (
      <footer class="footer"><div class="footer-inner"><img src="/etapel-logo.svg" alt="Etapel" /><span>Copyright © 2026 Etapel. Todos los derechos reservados.</span></div></footer>
    )}
    <style is:global>
      .footer-full{padding:58px 28px 28px}.footer-full>.footer-grid,.footer-full>.footer-bottom{max-width:var(--max);margin-left:auto;margin-right:auto}.footer-full .footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer-full img{width:150px}.footer-full p{color:#aeb8cf;line-height:1.7}.footer-full h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer-full ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer-full a{color:#c8d2e5}.footer-full .footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer-full .footer-bottom div{display:flex;gap:18px;flex-wrap:wrap}@media(max-width:800px){.footer-full .footer-grid{grid-template-columns:1fr}}
    </style>
  </body>
</html>
