---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { catalogProducts, productDetailPath, type CatalogProduct } from '../../../data/products';
import { productFamilies } from '../../../data/productLines';
import type { ProductDownload } from '../../../data/productTypes';

export function getStaticPaths() {
  return catalogProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product, lang = 'es' } = Astro.props as { product: CatalogProduct; lang?: 'es' | 'en' };
const en = lang === 'en';
const translations: Array<[RegExp, string]> = [
  [/\bProducto SATA incluido en el catálogo de Etapel\.?/gi, 'SATA product included in the Etapel catalog.'],
  [/\bDisponible para cotización y asesoría técnica\.?/gi, 'Available for quotation and technical advice.'],
  [/\bSelección recomendada según proceso, material y operación del taller\.?/gi, 'Recommended selection based on process, material and workshop operation.'],
  [/\bPistola(s)? de pintura\b/gi, 'Paint spray gun$1'],
  [/\brepintado automotriz\b/gi, 'automotive refinishing'],
  [/\bAplicación\b/gi, 'Application'], [/\bTecnología\b/gi, 'Technology'], [/\bOrientación\b/gi, 'Purpose'], [/\bSoporte\b/gi, 'Support'],
  [/\bUso recomendado\b/gi, 'Recommended use'], [/\bCómo lo trabaja Etapel\b/gi, 'How Etapel supports it'],
  [/\bFicha técnica\b/gi, 'Technical data sheet'], [/\bManual de operación\b/gi, 'Operating manual'],
  [/\bKit de mantenimiento\b/gi, 'Maintenance kit'], [/\bJuntas\b/gi, 'Seals'], [/\bAccesorios\b/gi, 'Accessories'],
  [/\bForma del abanico\b/gi, 'Spray pattern'], [/\bTamaño de la boquilla\b/gi, 'Nozzle size'], [/\bTecnología de boquillas\b/gi, 'Nozzle technology'],
  [/\bVersión de unidad digital\b/gi, 'Digital unit version'], [/\b¿Qué\b/gi, 'Which'], [/\bes la adecuada para mí\?/gi, 'is right for me?'],
  [/\bFondos, bases y barnices\b/gi, 'Primers, basecoats and clearcoats'], [/\bAcabado fino y repetible\b/gi, 'Fine, repeatable finish'],
  [/\bAsesoría Etapel para selección\b/gi, 'Etapel selection advice'], [/\bDescripción\b/gi, 'Description'],
];
const tr = (value?: string) => {
  if (!value || !en) return value || '';
  return translations.reduce((text, [pattern, replacement]) => text.replace(pattern, replacement), value);
};
const familyNameEn: Record<string, string> = {
  pintura: 'paint and refinishing',
  'cabinas-y-preparacion': 'spray booth and preparation',
  'soldadura-y-enderezado': 'welding and body repair',
  'mecanica-y-aire': 'mechanics and compressed air',
  consumibles: 'workshop consumables',
};
const productArea = familyNameEn[product.familySlug] || 'automotive workshop';
const displaySummary = en ? `${product.name}: professional ${productArea} solution.` : product.summary;
const displayDescription = en
  ? `${product.name} is part of Etapel’s professional product range. Our team provides product selection guidance, technical advice and quotation support according to your workshop process and application requirements.`
  : product.description;
const slides = product.highlightSlides || product.highlights;
const displaySlides = en
  ? [
      `Professional solution selected for ${productArea} applications.`,
      'Technical guidance and quotation support are available from Etapel.',
      'Configuration and accessories can be selected according to the workshop process.',
    ]
  : slides;
const displaySpecs = en
  ? [
      { label: 'Brand', value: product.brand },
      { label: 'Product area', value: productArea },
      { label: 'Technology', value: product.technology || 'Professional workshop technology' },
      { label: 'Application', value: 'Automotive workshop use' },
    ]
  : product.specs;
const family = productFamilies.find((item) => item.slug === product.familySlug);
const relatedProducts = catalogProducts
  .filter((item) => item.familySlug === product.familySlug && item.slug !== product.slug)
  .slice(0, 4);
const productDownloads = product.downloads || ['Ficha técnica', 'Manual de operación'];
const getDownloadLabel = (download: string | ProductDownload) => typeof download === 'string' ? download : download.label;
const getDownloadHref = (download: string | ProductDownload) => typeof download === 'string' ? '/contacto' : download.url;
const isLinkedDownload = (download: string | ProductDownload) => typeof download !== 'string';
---

<SiteLayout title={`${product.name} | ${en ? 'Etapel Catalog' : 'Catálogo Etapel'}`} description={displaySummary} lang={lang}>
  <main data-product-detail>
    <section class="page-hero">
      <div class="page-hero-inner">
        <div>
          <span class="eyebrow"><span class="dot"></span> {product.brand} / {family?.shortTitle}</span>
          <h1>{product.name}</h1>
          <p>{displaySummary}</p>
          <div class="hero-actions">
            <a class="btn orange" href={en ? '/en/contact#contact-form' : '/contacto#formulario-contacto'}>{en ? 'Ask now' : 'Pregunte ahora'}</a>
            {family && <a class="btn outline" href={en ? '/en/product-lines#product-catalog' : `${family.href}#catalogo-productos`}>{en ? 'Back to catalog' : 'Volver al catálogo'}</a>}
          </div>
        </div>
        <div class="hero-panel"><img src={product.image} alt={product.name} /></div>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="detail-grid">
          <div class="gallery-box">
            <div class="gallery-main">
              <img src={product.gallery[0] || product.image} alt={product.name} data-gallery-main />
            </div>
            <div class="thumbs">
              {product.gallery.map((image, index) => (
                <button type="button" class={index === 0 ? 'active' : ''} data-gallery-thumb data-image={image} aria-label={`Imagen ${index + 1}`}>
                  <img src={image} alt={product.name} loading="lazy" />
                </button>
              ))}
            </div>
          </div>

          <div class="detail-copy">
            <div class="badges">{product.badges.map((badge) => <span class="badge">{badge}</span>)}</div>
            <h1>{displaySummary}</h1>
            <p style="color:#647083;line-height:1.8;font-size:17px">{displayDescription}</p>

            {(product.optionGroups || []).map((group) => (
              <div style="margin-top:26px">
                <h3 style="color:var(--navy);margin:0 0 8px">{tr(group.label)}</h3>
                <div class="option-grid">
                  {group.options.map((option) => (
                    <button type="button" class={option.selected ? 'selected' : ''} disabled={option.disabled} data-option-button>{option.label}</button>
                  ))}
                </div>
                {group.help && <a href={en ? '/en/contact#contact-form' : '/contacto#formulario-contacto'} style="display:inline-block;margin-top:10px;color:var(--orange-dark);font-weight:800">{tr(group.help)}</a>}
              </div>
            ))}

            <div style="margin-top:34px">
              <h2 style="color:var(--navy);font-size:32px;letter-spacing:-.04em">{en ? 'Highlights' : 'Aspectos destacados'}</h2>
              <p style="min-height:86px;color:#4b5563;line-height:1.75;font-size:18px" data-highlight-text>{displaySlides[0]}</p>
              <div style="display:flex;gap:12px;align-items:center">
                <button class="btn outline-dark" type="button" data-highlight-prev>‹</button>
                <strong><span data-highlight-index>1</span>/{displaySlides.length}</strong>
                <button class="btn outline-dark" type="button" data-highlight-next>›</button>
              </div>
            </div>
          </div>
        </div>

        <div class="tabs" role="tablist">
          {(en ? ['Description', 'Technical data', 'Downloads', 'Spare parts'] : ['Descripción', 'Datos técnicos', 'Descargas', 'Piezas de recambio']).map((tab, index) => (
            <button type="button" data-detail-tab data-panel={`panel-${index}`} class={`tab ${index === 0 ? 'active' : ''}`}>{tab}</button>
          ))}
        </div>

        <div data-detail-panel id="panel-0">
          <div class="panel-grid">
            {(en ? [
              { title: 'Recommended use', body: `Professional ${productArea} processes requiring reliable equipment and consistent results.` },
              { title: 'Etapel support', body: 'Contact Etapel for configuration, compatible accessories, technical guidance and quotation support.' },
            ] : product.detailBlocks).map((block) => (
              <article class="detail-panel" style="padding:24px">
                <h3 style="color:var(--navy);margin-top:0">{tr(block.title)}</h3>
                <p style="color:#647083;line-height:1.7">{tr(block.body)}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="hidden" data-detail-panel id="panel-1">
          <dl style="margin-top:24px">
            {displaySpecs.map((spec) => (
              <div class="info-row">
                <dt style="font-weight:900;color:var(--navy)">{tr(spec.label)}</dt>
                <dd style="margin:0;text-align:right;color:#4b5563">{tr(spec.value)}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="hidden" data-detail-panel id="panel-2">
          <div class="catalog-grid" style="margin-top:24px">
            {productDownloads.map((download) => (
              <a class="detail-panel" style="padding:22px;font-weight:900;color:var(--navy)" href={getDownloadHref(download)} target={isLinkedDownload(download) ? '_blank' : undefined} rel={isLinkedDownload(download) ? 'noopener noreferrer' : undefined}>
                {tr(getDownloadLabel(download))}
              </a>
            ))}
          </div>
        </div>

        <div class="hidden" data-detail-panel id="panel-3">
          <div class="catalog-grid" style="margin-top:24px">
            {(product.spareParts || ['Kit de mantenimiento', 'Juntas', 'Accesorios']).map((part) => (
              <a class="detail-panel" style="padding:22px;font-weight:900;color:var(--navy)" href={en ? '/en/contact#contact-form' : '/contacto#formulario-contacto'}>{tr(part)}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {relatedProducts.length > 0 && (
      <section class="related">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="label">{en ? 'You may also be interested in' : 'También puede interesarte'}</div>
              <h2>{en ? 'Related products' : 'Productos relacionados'}</h2>
            </div>
          </div>
          <div class="catalog-grid">
            {relatedProducts.map((item) => (
              <article class="product-card">
                <a href={en ? `/en/product-lines/products/${item.slug}` : productDetailPath(item)}>
                  <div class="product-image"><img src={item.image} alt={item.name} loading="lazy" /></div>
                  <div class="product-body"><small>{en ? (familyNameEn[item.familySlug] || 'Automotive workshop') : (item.interest || item.category)}</small><h3>{item.name}</h3><span class="arrow">→</span></div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</SiteLayout>

<script define:vars={{ slides: displaySlides }}>
  document.querySelectorAll('[data-product-detail]').forEach((detail) => {
    const mainImage = detail.querySelector('[data-gallery-main]');
    const thumbs = Array.from(detail.querySelectorAll('[data-gallery-thumb]'));
    let imageIndex = 0;
    const setImage = (index) => {
      if (!thumbs.length) return;
      imageIndex = (index + thumbs.length) % thumbs.length;
      const active = thumbs[imageIndex];
      mainImage.src = active.dataset.image;
      thumbs.forEach((thumb, thumbIndex) => thumb.classList.toggle('active', thumbIndex === imageIndex));
    };
    thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => setImage(index)));

    detail.querySelectorAll('[data-option-button]').forEach((button) => {
      button.addEventListener('click', () => {
        const group = button.closest('.option-grid');
        group.querySelectorAll('[data-option-button]').forEach((item) => item.classList.remove('selected'));
        button.classList.add('selected');
      });
    });

    const highlightText = detail.querySelector('[data-highlight-text]');
    const highlightIndex = detail.querySelector('[data-highlight-index]');
    let slideIndex = 0;
    const setSlide = (index) => {
      slideIndex = (index + slides.length) % slides.length;
      highlightText.textContent = slides[slideIndex];
      highlightIndex.textContent = String(slideIndex + 1);
    };
    detail.querySelector('[data-highlight-prev]')?.addEventListener('click', () => setSlide(slideIndex - 1));
    detail.querySelector('[data-highlight-next]')?.addEventListener('click', () => setSlide(slideIndex + 1));

    const tabs = Array.from(detail.querySelectorAll('[data-detail-tab]'));
    const panels = Array.from(detail.querySelectorAll('[data-detail-panel]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((item) => item.classList.toggle('active', item === tab));
        panels.forEach((panel) => panel.classList.toggle('hidden', panel.id !== tab.dataset.panel));
      });
    });
  });
</script>
