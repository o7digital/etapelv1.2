---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import ProductFamilyMenu from '../../components/ProductFamilyMenu.astro';
import { legacyFamilyRoutes, productFamilies, type ProductFamily } from '../../data/productLines';

export function getStaticPaths() {
  const currentPaths = productFamilies.map((family) => ({ params: { slug: family.slug }, props: { family } }));
  const legacyPaths = Object.entries(legacyFamilyRoutes).map(([slug, target]) => ({
    params: { slug },
    props: { family: productFamilies.find((item) => item.slug === target)! }
  }));
  return [...currentPaths, ...legacyPaths];
}

const { family } = Astro.props as { family: ProductFamily };
---

<SiteLayout title={`${family.title} para taller automotriz CDMX | Etapel`} description={family.pageDescription}>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <div>
          <span class="eyebrow"><span class="dot"></span> {family.title}</span>
          <h1>{family.title}</h1>
          <p>{family.pageDescription}</p>
          <div class="hero-actions">
            <a class="btn orange" href="#lineas-de-producto">Ver líneas de producto</a>
            <a class="btn outline" href="/linea-de-producto">Todas las líneas</a>
          </div>
        </div>
        <div class="hero-panel"><img src={family.image} alt={family.title} /></div>
      </div>
    </section>

    <ProductFamilyMenu family={family} />

    <ProductCatalog familySlug={family.slug} />
  </main>
</SiteLayout>
