---
import { familyEnglish } from '../../data/familyEnglish';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import ProductFamilyMenu from '../../components/ProductFamilyMenu.astro';
import { legacyFamilyRoutes, productFamilies, type ProductFamily } from '../../data/productLines';

export function getStaticPaths() {
  const currentPaths = productFamilies.map((family) => ({ params: { slug: family.slug }, props: { family } }));
  const legacyPaths = Object.entries(legacyFamilyRoutes).map(([slug, target]) => ({
    params: { slug },
    props: { family: productFamilies.find((item) => item.slug === target)! }
  }));
  return [...currentPaths, ...legacyPaths];
}

const { family, lang = 'es' } = Astro.props as { family: ProductFamily; lang?: 'es' | 'en' };
const en = lang === 'en';
const title = en ? familyEnglish[family.slug]?.title || family.title : family.title;
const description = en ? familyEnglish[family.slug]?.description || family.pageDescription : family.pageDescription;
---

<SiteLayout title={`${title} | Etapel`} description={description} lang={lang}>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <div>
          <span class="eyebrow"><span class="dot"></span> {title}</span>
          <h1>{title}</h1>
          <p>{description}</p>
          <div class="hero-actions">
            <a class="btn orange" href={en ? "#families" : "#lineas-de-producto"}>{en ? "View product lines" : "Ver líneas de producto"}</a>
            <a class="btn outline" href={en ? "/en/product-lines" : "/linea-de-producto"}>{en ? "All product lines" : "Todas las líneas"}</a>
          </div>
        </div>
        <div class="hero-panel"><img src={family.image} alt={title} /></div>
      </div>
    </section>

    <ProductFamilyMenu family={family} lang={lang} />

    <ProductCatalog familySlug={family.slug} lang={lang} />
  </main>
</SiteLayout>
