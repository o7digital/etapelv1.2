---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import ProductFamilyMenu from '../../components/ProductFamilyMenu.astro';
import { productFamilies } from '../../data/productLines';
---

<SiteLayout
  title="Línea de Producto para taller automotriz CDMX | Etapel"
  description="Explora líneas de producto Etapel para taller automotriz: pintura, cabinas y preparación, soldadura, mecánica y productos SATA con asesoría especializada."
>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <div>
          <span class="eyebrow"><span class="dot"></span> Línea de Producto</span>
          <h1>Soluciones organizadas por familias para talleres profesionales.</h1>
          <p>Navega desde cuatro grandes familias hacia cada línea de producto y consulta después las fichas, marcas y datos técnicos disponibles.</p>
          <div class="hero-actions">
            <a class="btn orange" href="#catalogo-productos">Ver productos</a>
            <a class="btn outline" href="#familias">Ver familias</a>
          </div>
        </div>
        <div class="hero-panel">
          <div class="hero-panel-grid">
            {productFamilies.map((family) => <a class="hero-chip" href={family.href}>{family.shortTitle}</a>)}
          </div>
        </div>
      </div>
    </section>

    <ProductFamilyMenu />

    <ProductCatalog />
  </main>
</SiteLayout>
