---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import ProductFamilyMenu from '../../components/ProductFamilyMenu.astro';
import { productFamilies } from '../../data/productLines';
---

<SiteLayout
  title="Equipos y consumibles de pintura en CDMX, México | Etapel"
  description="Catálogo de pintura automotriz e industrial, cabinas USI Italia, pistolas SATA, lijadoras, pulimentos y consumibles. Asesoría en CDMX y distribución en México."
>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <div>
          <span class="eyebrow"><span class="dot"></span> Línea de Producto</span>
          <h1>Catálogo organizado según las familias de producto.</h1>
          <p>Encuentra pintura automotriz e industrial, pistolas de pintura SATA, cabinas USI Italia, lijadoras, pulimentos y materiales para enmascarar. Consulta también soldadoras, bancos de enderezado y sistemas de aire comprimido, con atención en CDMX y distribución en México.</p>
          <div class="hero-actions">
            <a class="btn orange" href="#catalogo-productos">Ver productos</a>
            <a class="btn outline" href="#familias">Ver familias</a>
          </div>
        </div>
        <div class="hero-panel">
          <div class="hero-panel-grid">
            {productFamilies.map((family) => <a class="hero-chip" href={family.href}>{family.shortTitle}</a>)}
          </div>
        </div>
      </div>
    </section>

    <ProductFamilyMenu />

    <ProductCatalog />
  </main>
</SiteLayout>
