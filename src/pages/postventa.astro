---
import BackToTop from '../components/BackToTop.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Posventa Etapel | Servicio técnico especializado</title>
  <meta name="description" content="Posventa Etapel: levantamientos, mantenimientos, reparaciones, instalaciones, desinstalaciones, capacitaciones y demostraciones." />
  <style>
    :root{--navy:#070b2f;--navy-2:#0b1145;--ink:#111827;--line:#e8edf5;--soft:#f5f7fb;--orange:#f58220;--orange-dark:#d96e12;--green:#559a17;--shadow:0 26px 70px rgba(7,11,47,.18);--shadow-soft:0 16px 44px rgba(7,11,47,.1);--max:1180px}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}.nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px}.brand{min-width:190px}.brand img{width:168px}.menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;white-space:nowrap}.menu a:hover{color:var(--orange-dark)}.nav-actions{display:flex;align-items:center;gap:12px}.lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;transition:.2s ease}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}.btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}.btn.outline-dark{background:#fff;color:var(--navy);border-color:var(--line)}.btn.outline-dark:hover{border-color:var(--navy);transform:translateY(-1px)}
    main{background:linear-gradient(180deg,#f6f8fc 0%,#fff 100%)}section{padding:92px 28px}.container{max-width:var(--max);margin:0 auto}.label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:12px}.post-hero{display:grid;grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.post-copy{padding:56px}.post-copy h1{font-size:clamp(42px,5vw,64px);line-height:.96;letter-spacing:-.07em;margin:0 0 18px;color:var(--navy)}.post-copy p{color:#647083;line-height:1.75;font-size:17px}.post-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.post-media{min-height:430px;background:#f6f8fc}.post-media img{width:100%;height:100%;object-fit:cover;object-position:center 38%}.section-head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin:44px 0 28px}.section-head h2{font-size:clamp(34px,4vw,56px);line-height:.98;letter-spacing:-.065em;margin:0;color:var(--navy)}.section-head p{max-width:430px;color:#647083;line-height:1.7}.services-intro{display:grid;grid-template-columns:.8fr 1.2fr;min-height:300px;background:#fff}.services-intro-copy{display:flex;flex-direction:column;justify-content:center;padding:42px}.services-intro-copy h2{margin:0 0 15px;color:var(--navy);font-size:clamp(32px,3.5vw,48px);line-height:1;letter-spacing:-.055em}.services-intro-copy p{margin:0 0 22px;color:#647083;line-height:1.6}.services-intro-photo{background:#e8edf5}.services-title{text-align:center;margin:27px 0 16px}.services-title .label{color:#2864d8;margin-bottom:5px}.services-title h3{margin:0;color:var(--navy);font-size:27px}.services{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.service{position:relative;isolation:isolate;overflow:hidden;min-height:210px;padding:24px 24px 20px 48%;display:flex;flex-direction:column;justify-content:flex-end;background-color:#071526;color:#fff;border:0;box-shadow:none}.service::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(3,12,25,.12) 0%,rgba(3,12,25,.64) 42%,rgba(3,12,25,.98) 72%)}.service span{position:absolute;top:18px;left:18px;display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(255,255,255,.2);background:#235bd1;color:#fff;font-weight:950}.service h3{margin:0;color:#fff;font-size:18px;line-height:1.15;letter-spacing:-.025em}.service p{margin:9px 0 0;color:#dbe5f4;font-size:12px;line-height:1.45}.process-band{margin-top:16px;background:#06172d;color:#fff;padding:30px 38px 34px;text-align:center}.process-band .label{color:#4d7ee9;margin-bottom:4px}.process-band h2{font-size:clamp(26px,3vw,38px);line-height:1.05;letter-spacing:-.045em;margin:0}.maintenance-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:24px}.maintenance-step{position:relative;padding:61px 20px 0;border:0}.maintenance-step::before{content:"";position:absolute;top:20px;left:0;width:100%;border-top:1px dashed rgba(119,154,217,.5)}.maintenance-step:first-child::before{left:50%;width:50%}.maintenance-step:last-child::before{width:50%}.maintenance-icon{position:absolute;z-index:1;top:0;left:50%;transform:translateX(-50%);display:grid;place-items:center;width:43px;height:43px;border-radius:50%;background:#245bd2;box-shadow:0 0 0 5px #06172d;color:#fff}.maintenance-icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.maintenance-step b{display:block;color:#fff;font-size:12px;letter-spacing:0;text-transform:none;margin-bottom:7px}.maintenance-step h3{display:none}.maintenance-step p{max-width:230px;margin:0 auto;color:#c8d4e8;font-size:11px;line-height:1.45}.benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.benefit{background:#fff;border:1px solid var(--line);padding:22px;box-shadow:var(--shadow-soft)}.benefit strong{display:block;color:var(--navy);font-size:19px;margin-bottom:8px}.benefit p{margin:0;color:#647083;line-height:1.55}.coverage-box{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:34px;margin-top:44px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:34px}.coverage-box h2{font-size:clamp(32px,4vw,48px);line-height:1;letter-spacing:-.055em;color:var(--navy);margin:0 0 14px}.coverage-box p{color:#647083;line-height:1.7}.coverage-locations{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.coverage-locations span{border:1px solid var(--line);padding:10px 13px;color:var(--navy);font-weight:850}.coverage-box img{width:100%;max-height:310px;object-fit:contain}.form-box{margin-top:34px;display:grid;grid-template-columns:.85fr 1.15fr;gap:30px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);padding:34px}.form-box h2{font-size:38px;line-height:1;letter-spacing:-.055em;margin:0 0 14px;color:var(--navy)}.form-box p{color:#647083;line-height:1.7}.form-grid{display:grid;gap:12px}.form-grid input,.form-grid select,.form-grid textarea{width:100%;border:1px solid var(--line);background:#f7f8fb;padding:14px 15px;font:inherit;color:var(--ink)}.form-grid textarea{min-height:140px;resize:vertical}
    .footer{padding:58px 28px 28px;background:linear-gradient(145deg,#050720 0%,var(--navy) 58%,#0b1145 100%);color:#d8e0ef}.footer-shell{max-width:var(--max);margin:0 auto}.footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer img{width:150px;filter:brightness(0) invert(1)}.footer p{color:#aeb8cf;line-height:1.7}.footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer a{color:#c8d2e5}.footer a:hover{color:#fff}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;color:#aeb8cf;font-size:13px}.footer-bottom-links{display:flex;gap:18px;flex-wrap:wrap}.footer-keywords{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);font-size:11px;line-height:1.8;color:#8f9ab2;text-align:center}
    @media(max-width:980px){.menu{display:none}.post-hero,.form-box,.coverage-box,.services-intro{grid-template-columns:1fr}.services-intro-photo{min-height:300px}.services,.maintenance-steps,.benefits,.footer-grid{grid-template-columns:repeat(2,1fr)}.post-copy{padding:36px}}@media(max-width:640px){.nav{height:auto;padding:18px;align-items:flex-start}.nav-actions .btn{display:none}.brand img{width:140px}.services,.maintenance-steps,.benefits,.footer-grid{grid-template-columns:1fr}.service{min-height:220px;padding-left:46%}.section-head{display:block}.post-copy h1{font-size:40px}.process-band,.coverage-box{padding:24px}.footer-bottom{align-items:flex-start;flex-direction:column}}
    .mobile-menu{display:none}.mobile-menu summary{width:46px;height:46px;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;list-style:none;background:#fff}.mobile-menu summary::-webkit-details-marker{display:none}.hamburger,.hamburger:before,.hamburger:after{display:block;width:22px;height:2px;background:var(--navy);content:"";transition:.2s ease}.hamburger:before{transform:translateY(-7px)}.hamburger:after{transform:translateY(5px)}.mobile-menu[open] .hamburger{background:transparent}.mobile-menu[open] .hamburger:before{transform:translateY(2px) rotate(45deg)}.mobile-menu[open] .hamburger:after{transform:translateY(0) rotate(-45deg)}.mobile-panel{position:absolute;right:28px;top:calc(100% + 12px);width:min(88vw,360px);background:#fff;border:1px solid var(--line);box-shadow:0 22px 60px rgba(7,11,47,.18);padding:12px;display:grid;gap:4px}.mobile-panel a{padding:14px 16px;font-weight:850;color:#17203b}.mobile-panel a:hover{background:#f6f8fc;color:var(--orange-dark)}.mobile-panel .mobile-cta{margin-top:6px;background:var(--orange);color:#fff;text-align:center}@media(max-width:980px){.nav{position:relative}.nav-actions{display:none}.mobile-menu{display:block}}@media(max-width:640px){.nav{height:70px!important;padding:0 18px!important;align-items:center!important}.brand{min-width:0!important}.mobile-panel{right:18px}section{padding-left:20px!important;padding-right:20px!important}.field,.form-grid input,.form-grid select,.form-grid textarea{min-width:0;width:100%}.catalog-shell,.training-copy,.post-copy,.contact-copy,.about-copy,.product-copy{padding:24px!important}}
    .support-page{padding-top:0}.post-hero{position:relative;display:block;min-height:520px;border:0;box-shadow:none;background:#06101f url('/images/postventa.webp') center 42%/cover no-repeat;isolation:isolate}.post-hero::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(2,8,18,.97) 0%,rgba(2,8,18,.88) 40%,rgba(2,8,18,.3) 70%,rgba(2,8,18,.08) 100%)}.post-copy{max-width:620px;padding:70px 54px;color:#fff}.post-copy .label{color:#4d7ee9}.post-copy h1{max-width:540px;font-size:clamp(42px,4.5vw,60px);line-height:1;color:#fff}.post-copy p{max-width:510px;color:#eef3fb;font-size:17px;line-height:1.6}.post-copy .btn.orange{background:var(--orange);box-shadow:0 14px 32px rgba(245,130,32,.28)}.post-copy .btn.orange:hover{background:var(--orange-dark)}.post-copy .btn.outline-dark{background:rgba(4,10,22,.55);color:#fff;border-color:rgba(255,255,255,.65)}.support-features{display:grid;grid-template-columns:repeat(5,1fr);background:#06172d;color:#fff;border-top:1px solid rgba(87,135,225,.35)}.support-feature{display:flex;align-items:center;justify-content:center;gap:13px;min-height:82px;padding:14px;border-right:1px solid rgba(87,135,225,.35)}.support-feature:last-child{border-right:0}.support-feature svg{width:34px;height:34px;flex:0 0 34px;color:#9ab5e4;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;fill:none}.support-feature b{font-size:11px;line-height:1.35}.post-media{display:none}
    @media(max-width:980px){.support-features{grid-template-columns:repeat(3,1fr)}.support-feature{border-bottom:1px solid rgba(87,135,225,.35)}}
    @media(max-width:640px){.support-page{padding:0!important}.post-hero{min-height:600px;background-position:72% center}.post-hero::before{background:linear-gradient(90deg,rgba(2,8,18,.96),rgba(2,8,18,.6))}.post-copy{padding:52px 24px!important}.post-copy h1{font-size:42px}.support-features{grid-template-columns:1fr 1fr}.support-feature{justify-content:flex-start}}
    .benefits-heading{text-align:center;margin:30px 0 18px}.benefits-heading .label{color:#2864d8;margin-bottom:5px}.benefits-heading h2{margin:0;color:var(--navy);font-size:clamp(27px,3vw,38px);line-height:1.05;letter-spacing:-.045em}.benefits{gap:13px}.benefit{display:grid;grid-template-columns:58px 1fr;gap:16px;align-items:start;min-height:148px;padding:24px 20px;box-shadow:none}.benefit-icon{color:#2864d8}.benefit-icon svg{width:52px;height:52px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.benefit strong{font-size:16px;line-height:1.15}.benefit p{font-size:12px;line-height:1.45}.coverage-box{grid-template-columns:.78fr 1.5fr .72fr;gap:14px;margin-top:18px;padding:28px 32px;background:#06172d;border:0;color:#fff;box-shadow:none}.coverage-copy h2{max-width:340px;margin-bottom:13px;color:#fff;font-size:clamp(30px,3.2vw,45px)}.coverage-copy p{margin:0;color:#d1dced;font-size:13px;line-height:1.55}.coverage-cities{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.city-card{position:relative;min-height:180px;background:#d8e0ec;overflow:hidden}.city-card::after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(2,9,20,.92))}.city-card b{position:absolute;z-index:1;left:12px;bottom:10px;font-size:12px}.coverage-map{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.coverage-map img{width:100%;max-height:190px;object-fit:contain;filter:grayscale(1) brightness(1.8);opacity:.9}.coverage-map p{margin:8px 0 0;color:#d1dced;font-size:12px;line-height:1.45}.coverage-locations{display:none}
    @media(max-width:980px){.coverage-box{grid-template-columns:1fr 1fr}.coverage-copy{grid-column:1/-1}.coverage-map img{max-height:220px}}@media(max-width:640px){.benefit{grid-template-columns:50px 1fr}.benefit-icon svg{width:44px;height:44px}.coverage-box{grid-template-columns:1fr;padding:28px 20px}.coverage-copy{grid-column:auto}.coverage-cities{grid-template-columns:1fr}.city-card{min-height:190px}.coverage-map img{max-height:240px}}
    .photo-placeholder{position:relative;background:#e8edf5!important;background-image:none!important;color:#7d879a}.photo-placeholder::after{content:attr(data-placeholder);position:absolute;inset:0;display:grid;place-items:center;font-size:15px;font-weight:900;letter-spacing:.16em}.services-intro-photo.photo-placeholder{min-height:300px}.service.photo-placeholder{min-height:290px;padding:178px 22px 22px;display:block;background:#fff!important;border:1px solid var(--line);color:var(--navy)}.service.photo-placeholder::before{z-index:-1;inset:0 0 auto;height:155px;background:#e8edf5}.service.photo-placeholder::after{inset:0 0 auto;height:155px;color:#7d879a}.service.photo-placeholder span{z-index:2}.service.photo-placeholder h3{color:var(--navy)}.service.photo-placeholder p{color:#647083}.city-card.photo-placeholder{background:#d8e0ec!important;color:#647083}.city-card.photo-placeholder::after{inset:0;display:grid;place-items:center;background:none;color:#647083;font-size:13px;font-weight:900;letter-spacing:.12em}.city-card.photo-placeholder b{z-index:2;color:#fff;background:#06172d;padding:5px 8px;left:0;bottom:0}
  </style>
</head>
<body id="top">
  <div class="topline"></div>
  <header class="site-header">
    <nav class="nav">
      <a class="brand" href="/"><img src="/etapel-logo.svg" alt="Etapel"></a>
      <div class="menu">
        <a href="/">INICIO</a><a href="/linea-de-producto">LÍNEA DE PRODUCTO</a><a href="/capacitacion">CEDETEC</a><a href="/postventa">SOPORTE TÉCNICO</a><a href="/quienes-somos">NOSOTROS</a><a href="/contacto">CONTACTO</a>
      </div>
      <div class="nav-actions"><a class="lang" href="/en/after-sales" aria-label="Cambiar idioma a inglés">EN</a><a class="btn orange" href="/contacto#formulario-contacto">Solicitar información</a></div>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú"><span class="hamburger"></span></summary>
        <div class="mobile-panel">
          <a href="/">INICIO</a>
          <a href="/linea-de-producto">LÍNEA DE PRODUCTO</a>
          <a href="/capacitacion">CEDETEC</a>
          <a href="/postventa">SOPORTE TÉCNICO</a>
          <a href="/quienes-somos">NOSOTROS</a>
          <a href="/contacto">CONTACTO</a>
          <a href="/en/after-sales" aria-label="Cambiar idioma a inglés">EN</a>
          <a class="mobile-cta" href="/contacto#formulario-contacto">Solicitar información</a>
        </div>
      </details>

    </nav>
  </header>

  <main>
    <section class="support-page">
      <div class="container">
        <div class="post-hero">
          <div class="post-copy">
            <div class="label">Servicio técnico</div>
            <h1>Servicio técnico que protege tu inversión.</h1>
            <p>Acompañamos tus equipos después de la compra para mantenerlos operando de manera segura, eficiente y productiva.</p>
            <div class="post-actions">
              <a class="btn orange" href="#formulario-postventa">Solicita servicio técnico</a>
              <a class="btn outline-dark" href="#mantenimiento">Cotiza un plan de mantenimiento</a>
            </div>
          </div>
        </div>
        <div class="support-features">
          <div class="support-feature"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M29 7a11 11 0 0 0-9 15L7 35a4 4 0 0 0 6 6l13-13a11 11 0 0 0 15-9l-7 5-7-7 5-7a11 11 0 0 0-3-3Z"/><path d="m10 37 2 2"/></svg><b>Instalación<br>especializada</b></div>
          <div class="support-feature"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5 39 11v11c0 10-6 17-15 21-9-4-15-11-15-21V11l15-6Z"/><path d="m17 23 5 5 10-11"/></svg><b>Mantenimiento<br>preventivo</b></div>
          <div class="support-feature"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 27v-5a16 16 0 0 1 32 0v5"/><path d="M8 25h5v13H9a4 4 0 0 1-4-4v-5a4 4 0 0 1 3-4Zm32 0h-5v13h4a4 4 0 0 0 4-4v-5a4 4 0 0 0-3-4ZM35 38c-2 4-5 5-10 5"/></svg><b>Soporte<br>técnico</b></div>
          <div class="support-feature"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M39 20c0 11-15 23-15 23S9 31 9 20a15 15 0 1 1 30 0Z"/><circle cx="24" cy="20" r="5"/></svg><b>Cobertura<br>nacional</b></div>
          <div class="support-feature"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="m4 19 9-9 7 4 8-2 16 13-7 8-12-9-6 5-7-6-3 3-5-7Z"/><path d="m28 12-9 8c2 3 5 3 8 1l4-3M37 33l-4-3m0 7-4-4m0 7-4-4"/></svg><b>Atención<br>posventa</b></div>
        </div>

        <div class="services-intro">
          <div class="services-intro-copy">
            <div class="label">Posventa Etapel</div>
            <h2>Más que reparaciones, somos tu socio estratégico.</h2>
            <p>Nuestro servicio técnico va más allá de la solución de fallas. Acompañamos a nuestros clientes para proteger el desempeño de sus equipos, garantizar la seguridad de sus operaciones y maximizar su disponibilidad.</p>
            <a class="btn orange" href="#servicios" style="align-self:flex-start">Conoce más sobre nuestro servicio →</a>
          </div>
          <div class="services-intro-photo photo-placeholder" data-placeholder="FOTO PRINCIPAL" role="img" aria-label="Espacio reservado para la foto principal proporcionada por la cliente"></div>
        </div>
        <div class="services-title" id="servicios"><div class="label">Nuestros servicios</div><h3>Soluciones técnicas integrales para tu operación.</h3></div>
        <div class="services">
          <article class="service photo-placeholder" data-placeholder="FOTO 1"><span>01</span><h3>Instalación y puesta en marcha</h3><p>Configuración, instalación y puesta en operación de equipos.</p></article>
          <article class="service photo-placeholder" data-placeholder="FOTO 2"><span>02</span><h3>Mantenimiento de equipos mayores</h3><p>Servicio preventivo y correctivo para prolongar su vida útil.</p></article>
          <article class="service photo-placeholder" data-placeholder="FOTO 3"><span>03</span><h3>Servicio especializado de cabinas</h3><p>Revisión de componentes y condiciones de operación.</p></article>
          <article class="service photo-placeholder" data-placeholder="FOTO 4"><span>04</span><h3>Cambio de filtros</h3><p>Suministro y cambio para conservar el flujo de aire adecuado.</p></article>
          <article class="service photo-placeholder" data-placeholder="FOTO 5"><span>05</span><h3>Armado y desarmado de cabinas</h3><p>Desmontaje, reubicación, reinstalación y pruebas.</p></article>
          <article class="service photo-placeholder" data-placeholder="FOTO 6"><span>06</span><h3>Diagnóstico y reparación</h3><p>Evaluación técnica, reparación y acciones correctivas.</p></article>
        </div>

        <div class="process-band" id="mantenimiento">
          <div class="label">Nuestro enfoque</div>
          <h2>Mantenimiento preventivo para mantener tu operación en marcha.</h2>
          <div class="maintenance-steps">
            <article class="maintenance-step"><span class="maintenance-icon"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="14" cy="14" r="8"/><path d="m20 20 7 7"/></svg></span><b>1. Diagnóstico</b><p>Evaluamos el estado actual de tus equipos y detectamos riesgos potenciales.</p></article>
