  <style>
    :root{--navy:#070b2f;--navy-2:#0b1145;--ink:#111827;--line:#e8edf5;--soft:#f5f7fb;--orange:#f58220;--orange-dark:#d96e12;--green:#559a17;--shadow:0 26px 70px rgba(7,11,47,.18);--shadow-soft:0 16px 44px rgba(7,11,47,.1);--max:1180px}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}.nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px}.brand{min-width:190px}.brand img{width:168px}.menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;white-space:nowrap}.menu a:hover{color:var(--orange-dark)}.nav-actions{display:flex;align-items:center;gap:12px}.lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;transition:.2s ease}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}.btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}.btn.outline-dark{background:#fff;color:var(--navy);border-color:var(--line)}.btn.outline-dark:hover{border-color:var(--navy);transform:translateY(-1px)}
    main{background:linear-gradient(180deg,#f6f8fc 0%,#fff 100%)}section{padding:92px 28px}.container{max-width:var(--max);margin:0 auto}.label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:12px}.training-hero{display:grid;grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.training-copy{padding:56px}.training-copy h1{font-size:clamp(42px,5vw,64px);line-height:.96;letter-spacing:-.07em;margin:0 0 18px;color:var(--navy)}.training-copy p{color:#647083;line-height:1.75;font-size:17px}.training-media{min-height:430px;background:#f6f8fc}.training-media img{width:100%;height:100%;object-fit:cover;object-position:center 38%}.training-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.training-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:34px}.training-card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);overflow:hidden;display:grid;grid-template-columns:.85fr 1.15fr}.training-card img{width:100%;height:100%;min-height:230px;object-fit:cover}.training-card div{padding:26px}.training-card h2{margin:0 0 12px;color:var(--navy);font-size:25px;letter-spacing:-.04em}.training-card p{margin:0;color:#647083;line-height:1.65}.training-cta{margin-top:34px;background:var(--navy);color:#fff;padding:36px;border-left:8px solid var(--orange);box-shadow:var(--shadow)}.training-cta h2{font-size:34px;letter-spacing:-.05em;margin:0 0 12px}.training-cta p{color:#d6deee;line-height:1.7;margin:0;max-width:820px}
    .footer{padding:58px 28px 28px;background:linear-gradient(145deg,#050720 0%,var(--navy) 58%,#0b1145 100%);color:#d8e0ef}.footer-shell{max-width:var(--max);margin:0 auto}.footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer img{width:150px;filter:brightness(0) invert(1)}.footer p{color:#aeb8cf;line-height:1.7}.footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer a{color:#c8d2e5}.footer a:hover{color:#fff}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;color:#aeb8cf;font-size:13px}.footer-bottom-links{display:flex;gap:18px;flex-wrap:wrap}.footer-keywords{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);font-size:11px;line-height:1.8;color:#8f9ab2;text-align:center}
    @media(max-width:980px){.menu{display:none}.training-hero{grid-template-columns:1fr}.training-grid,.footer-grid{grid-template-columns:repeat(2,1fr)}.training-card{grid-template-columns:1fr}.training-copy{padding:36px}}@media(max-width:640px){.nav{height:auto;padding:18px;align-items:flex-start}.nav-actions .btn{display:none}.brand img{width:140px}.training-grid,.footer-grid{grid-template-columns:1fr}.training-copy h1{font-size:40px}.footer-bottom{align-items:flex-start;flex-direction:column}}
