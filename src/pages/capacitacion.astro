---
import BackToTop from '../components/BackToTop.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Capacitación Etapel | Servicios de formación automotriz</title>
  <meta name="description" content="Servicios de capacitación Etapel para uso de equipos, limpieza, procesos homologados, seguridad del personal y eficiencia operativa." />
  <style>
    :root{--navy:#070b2f;--navy-2:#0b1145;--ink:#111827;--line:#e8edf5;--soft:#f5f7fb;--orange:#f58220;--orange-dark:#d96e12;--green:#559a17;--shadow:0 26px 70px rgba(7,11,47,.18);--shadow-soft:0 16px 44px rgba(7,11,47,.1);--max:1180px}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}.nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px}.brand{min-width:190px}.brand img{width:168px}.menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;white-space:nowrap}.menu a:hover{color:var(--orange-dark)}.nav-actions{display:flex;align-items:center;gap:12px}.lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;transition:.2s ease}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}.btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}.btn.outline-dark{background:#fff;color:var(--navy);border-color:var(--line)}.btn.outline-dark:hover{border-color:var(--navy);transform:translateY(-1px)}
    main{background:linear-gradient(180deg,#f6f8fc 0%,#fff 100%)}section{padding:92px 28px}.container{max-width:var(--max);margin:0 auto}.label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:12px}.training-hero{display:grid;grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.training-copy{padding:56px}.training-copy h1{font-size:clamp(42px,5vw,64px);line-height:.96;letter-spacing:-.07em;margin:0 0 18px;color:var(--navy)}.training-copy p{color:#647083;line-height:1.75;font-size:17px}.training-media{min-height:430px;background:#f6f8fc}.training-media img{width:100%;height:100%;object-fit:cover;object-position:center 38%}.training-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.training-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:34px}.training-card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);overflow:hidden;display:grid;grid-template-columns:.85fr 1.15fr}.training-card img{width:100%;height:100%;min-height:230px;object-fit:cover}.training-card div{position:relative;padding:26px;background:#fff}.training-card h2{margin:0 0 12px;color:var(--navy);font-size:25px;line-height:1.05;letter-spacing:-.04em}.training-card p{margin:0;color:#647083;line-height:1.65}.training-cta{margin-top:34px;background:var(--navy);color:#fff;padding:36px;border-left:8px solid var(--orange);box-shadow:var(--shadow)}.training-cta h2{font-size:34px;letter-spacing:-.05em;margin:0 0 12px}.training-cta p{color:#d6deee;line-height:1.7;margin:0;max-width:820px}
    .learning-intro{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:center;margin-top:34px}.learning-copy{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:34px}.learning-copy h2,.section-title{font-size:clamp(34px,4vw,52px);line-height:.98;letter-spacing:-.06em;color:var(--navy);margin:0 0 18px}.learning-copy p{color:#647083;line-height:1.7}.learning-image img{width:100%;height:390px;object-fit:cover}.process-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:28px}.process-step{border:1px solid rgba(255,255,255,.14);padding:20px}.process-step strong{display:grid;place-items:center;width:38px;height:38px;background:var(--orange);margin-bottom:15px}.process-step b{display:block}.process-step p{font-size:13px;margin-top:8px}.service-grid{grid-template-columns:repeat(3,1fr)}.service-grid .training-card{display:block}.service-grid .training-card img{height:240px;min-height:0}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.gallery img{width:100%;height:220px;object-fit:cover}.benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:28px}.learning-points{grid-template-columns:repeat(3,1fr)}.benefit{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:24px}.benefit span{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);color:var(--orange-dark);font-weight:950;margin-bottom:16px}.benefit h3{color:var(--navy);margin:0 0 10px}.benefit p{color:#647083;line-height:1.6;font-size:14px}
    .footer{padding:58px 28px 28px;background:linear-gradient(145deg,#050720 0%,var(--navy) 58%,#0b1145 100%);color:#d8e0ef}.footer-shell{max-width:var(--max);margin:0 auto}.footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer img{width:150px;filter:brightness(0) invert(1)}.footer p{color:#aeb8cf;line-height:1.7}.footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer a{color:#c8d2e5}.footer a:hover{color:#fff}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;color:#aeb8cf;font-size:13px}.footer-bottom-links{display:flex;gap:18px;flex-wrap:wrap}.footer-keywords{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);font-size:11px;line-height:1.8;color:#8f9ab2;text-align:center}
    @media(max-width:980px){.menu{display:none}.training-hero,.learning-intro{grid-template-columns:1fr}.training-grid,.footer-grid,.process-grid,.benefits{grid-template-columns:repeat(2,1fr)}.training-card{grid-template-columns:1fr}.training-copy{padding:36px}}@media(max-width:640px){.nav{height:auto;padding:18px;align-items:flex-start}.nav-actions .btn{display:none}.brand img{width:140px}.training-grid,.footer-grid,.process-grid,.gallery,.benefits,.learning-points{grid-template-columns:1fr}.training-copy h1{font-size:40px}.footer-bottom{align-items:flex-start;flex-direction:column}.training-hero{box-shadow:none}.training-media{display:none}.training-grid{gap:26px;margin-top:28px}.training-card{display:block;box-shadow:none}.training-card img{width:100%;height:230px;min-height:0;object-fit:cover}.training-card div{padding:22px 20px 24px!important}.training-card h2{font-size:25px;margin-bottom:10px}.training-card p{font-size:16px;line-height:1.65;color:#596579}.training-actions .btn{width:100%;text-align:center}.training-cta{padding:28px 22px}.training-cta h2{font-size:28px;line-height:1.05}}
    .mobile-menu{display:none}.mobile-menu summary{width:46px;height:46px;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;list-style:none;background:#fff}.mobile-menu summary::-webkit-details-marker{display:none}.hamburger,.hamburger:before,.hamburger:after{display:block;width:22px;height:2px;background:var(--navy);content:"";transition:.2s ease}.hamburger:before{transform:translateY(-7px)}.hamburger:after{transform:translateY(5px)}.mobile-menu[open] .hamburger{background:transparent}.mobile-menu[open] .hamburger:before{transform:translateY(2px) rotate(45deg)}.mobile-menu[open] .hamburger:after{transform:translateY(0) rotate(-45deg)}.mobile-panel{position:absolute;right:28px;top:calc(100% + 12px);width:min(88vw,360px);background:#fff;border:1px solid var(--line);box-shadow:0 22px 60px rgba(7,11,47,.18);padding:12px;display:grid;gap:4px}.mobile-panel a{padding:14px 16px;font-weight:850;color:#17203b}.mobile-panel a:hover{background:#f6f8fc;color:var(--orange-dark)}.mobile-panel .mobile-cta{margin-top:6px;background:var(--orange);color:#fff;text-align:center}@media(max-width:980px){.nav{position:relative}.nav-actions{display:none}.mobile-menu{display:block}}@media(max-width:640px){.nav{height:70px!important;padding:0 18px!important;align-items:center!important}.brand{min-width:0!important}.mobile-panel{right:18px}section{padding-left:20px!important;padding-right:20px!important}.field,.form-grid input,.form-grid select,.form-grid textarea{min-width:0;width:100%}.catalog-shell,.training-copy,.post-copy,.contact-copy,.about-copy,.product-copy{padding:24px!important}}
    .training-page{padding-top:0}.training-hero{position:relative;display:block;min-height:535px;border:0;box-shadow:none;background:#06101f url('/images/capacitacion-1.webp') center 42%/cover no-repeat;isolation:isolate}.training-hero::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(2,8,18,.97) 0%,rgba(2,8,18,.86) 42%,rgba(2,8,18,.26) 72%,rgba(2,8,18,.08) 100%)}.training-copy{max-width:660px;padding:66px 54px;color:#fff}.training-copy h1{font-size:clamp(34px,3.1vw,46px);line-height:1.02;color:#fff;text-transform:uppercase;letter-spacing:-.035em;margin-bottom:10px}.training-subtitle{max-width:540px;color:#fff;font-size:22px;line-height:1.25;font-weight:800;margin:0 0 18px}.training-copy>p:not(.training-subtitle){max-width:570px;color:#eef3fb;font-size:16px;line-height:1.6}.training-copy .btn.outline-dark,.closing-training-cta .btn.outline-dark{background:rgba(4,10,22,.55);color:#fff;border-color:rgba(255,255,255,.65)}.training-features{display:grid;grid-template-columns:repeat(5,1fr);background:#06172d;color:#fff;border-top:1px solid rgba(87,135,225,.35)}.training-feature{display:flex;align-items:center;justify-content:center;gap:11px;min-height:82px;padding:14px;border-right:1px solid rgba(87,135,225,.35)}.training-feature:last-child{border-right:0}.training-feature i{display:grid;place-items:center;width:38px;height:38px;border:1px solid #4974c9;border-radius:50%;color:#73a0f1;font-style:normal;font-size:19px}.training-feature b{font-size:11px;line-height:1.35;text-transform:uppercase}.learning-intro{gap:0;margin-top:0;background:#fff;border:1px solid var(--line)}.learning-copy{border:0;box-shadow:none;padding:46px}.learning-copy>.label{color:#315ed0}.learning-copy h2{font-size:38px}.learning-points{gap:0;margin-top:28px}.learning-points .benefit{border:0;border-right:1px solid var(--line);box-shadow:none;padding:14px}.learning-points .benefit:last-child{border-right:0}.learning-points .benefit span{width:38px;height:38px;border:2px solid #3168d8;border-radius:50%;color:#3168d8;margin-bottom:11px}.learning-points .benefit h3{font-size:12px;text-transform:uppercase;color:#245bbf}.learning-points .benefit p{margin:7px 0 0;color:#647083;font-size:9px;line-height:1.45}.learning-image img{height:470px}.training-cta{margin-top:0;border-left:0;box-shadow:none;background:linear-gradient(135deg,#031426,#061d38);padding:40px 46px}.training-cta .label{color:#5684df}.training-cta h2{max-width:620px;font-size:31px}.process-grid{gap:0}.process-step{position:relative;border:0;border-right:1px solid rgba(255,255,255,.14);text-align:center;padding:14px 20px}.process-step:last-child{border-right:0}.process-step strong{border-radius:50%;margin:0 auto 14px;background:#1764df}.process-step b{font-size:13px}.process-step p{color:#b9c9dc;line-height:1.45}.service-grid{gap:16px;margin-top:18px}.service-grid .training-card{position:relative;border:0;box-shadow:none;background:#061426}.service-grid .training-card img{height:285px}.service-grid .training-card div{min-height:168px;background:#061426;color:#fff;padding:24px}.service-grid .training-card div::before{content:'◇';position:absolute;top:-28px;left:22px;display:grid;place-items:center;width:48px;height:48px;background:#1764df;color:#fff;font-size:24px}.service-grid .training-card h2{color:#fff;text-transform:uppercase;font-size:20px}.service-grid .training-card p{color:#c8d4e3;font-size:13px}.action-gallery{position:relative;margin-top:26px;padding-bottom:12px}.action-gallery .section-title{display:none}.carousel-head{display:flex;align-items:center;justify-content:space-between;gap:18px}.carousel-controls{display:flex;gap:7px}.carousel-button{width:38px;height:38px;border:1px solid #cad5e8;background:#fff;color:#1764df;font-size:21px;cursor:pointer}.carousel-button:hover{background:#1764df;color:#fff}.action-gallery .gallery{display:flex;gap:8px;margin-top:12px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}.action-gallery .gallery::-webkit-scrollbar{display:none}.action-gallery .gallery img{flex:0 0 calc((100% - 24px)/4);width:calc((100% - 24px)/4);height:205px;object-fit:cover;scroll-snap-align:start}.benefit-band{display:grid;grid-template-columns:1.25fr 3fr;align-items:center;margin-top:36px;padding:26px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.benefit-band .benefit-heading{padding-right:30px}.benefit-band .benefit-heading .section-title{font-size:29px;margin:0}.benefit-band .benefits{margin:0;gap:0}.benefit-band .benefit{min-height:145px;border:0;border-left:1px solid var(--line);box-shadow:none;padding:15px 18px}.benefit-band .benefit span{border:0;color:#1764df;font-size:28px;margin-bottom:8px}.benefit-band .benefit h3{font-size:14px}.benefit-band .benefit p{font-size:11px}.closing-training-cta{position:relative;margin-top:0!important;background:linear-gradient(90deg,rgba(2,12,25,.98),rgba(2,12,25,.78)),url('/images/capacitacion-4.webp') center/cover no-repeat!important;display:grid;grid-template-columns:1fr auto;align-items:center;gap:28px}.closing-training-cta h2{margin-bottom:8px}.closing-training-cta .training-actions{margin:0}.closing-training-cta .btn{white-space:nowrap}
    @media(max-width:980px){.training-features{grid-template-columns:repeat(3,1fr)}.training-feature{border-bottom:1px solid rgba(87,135,225,.35)}.learning-intro{grid-template-columns:1fr}.benefit-band{grid-template-columns:1fr}.benefit-band .benefit-heading{padding:0 0 24px}.closing-training-cta{grid-template-columns:1fr}.closing-training-cta .training-actions{margin-top:10px}}
    @media(max-width:640px){.training-page{padding:0!important}.training-hero{min-height:610px;background-position:58% center}.training-hero::before{background:linear-gradient(90deg,rgba(2,8,18,.96),rgba(2,8,18,.64))}.training-copy{padding:48px 24px!important}.training-copy h1{font-size:38px}.training-features{grid-template-columns:1fr 1fr}.training-feature{justify-content:flex-start}.learning-copy{padding:30px 22px}.learning-copy h2{font-size:32px}.learning-points{grid-template-columns:1fr}.learning-points .benefit{border-right:0;border-bottom:1px solid var(--line)}.learning-image img{height:290px}.training-cta{padding:32px 22px}.service-grid{padding:0 20px}.action-gallery .gallery img{flex-basis:82%;width:82%;height:210px}.action-gallery,.benefit-band{margin-left:20px;margin-right:20px}.benefit-band .benefits{grid-template-columns:1fr 1fr}.closing-training-cta{margin-left:0!important;margin-right:0!important}.closing-training-cta .btn{width:100%}}
  </style>
</head>
<body id="top">
  <div class="topline"></div>
  <header class="site-header">
    <nav class="nav">
      <a class="brand" href="/"><img src="/etapel-logo.svg" alt="Etapel"></a>
      <div class="menu">
        <a href="/">INICIO</a><a href="/linea-de-producto">LÍNEA DE PRODUCTO</a><a href="/capacitacion">CDTECH</a><a href="/postventa">POSVENTA</a><a href="/quienes-somos">NOSOTROS</a><a href="/contacto">CONTACTO</a>
      </div>
      <div class="nav-actions"><a class="lang" href="/en/training" aria-label="Cambiar idioma a inglés">EN</a><a class="btn orange" href="/contacto#formulario-contacto">Solicitar información</a></div>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú"><span class="hamburger"></span></summary>
        <div class="mobile-panel">
          <a href="/">INICIO</a>
          <a href="/linea-de-producto">LÍNEA DE PRODUCTO</a>
          <a href="/capacitacion">CDTECH</a>
          <a href="/postventa">POSVENTA</a>
          <a href="/quienes-somos">NOSOTROS</a>
          <a href="/contacto">CONTACTO</a>
          <a href="/en/training" aria-label="Cambiar idioma a inglés">EN</a>
          <a class="mobile-cta" href="/contacto#formulario-contacto">Solicitar información</a>
        </div>
      </details>

    </nav>
  </header>

  <main>
    <section class="training-page">
      <div class="container">
        <div class="training-hero">
          <div class="training-copy">
            <h1>CDTECH<br>Centro de Entrenamiento Etapel</h1>
            <p class="training-subtitle">La tecnología se aprovecha mejor cuando las personas saben cómo utilizarla.</p>
            <p>Capacitaciones prácticas y especializadas en productos, procesos y tecnología avanzada para que tu equipo opere con seguridad, eficiencia y excelencia.</p>
            <div class="training-actions">
              <a class="btn orange" href="https://wa.link/oowyzu" target="_blank" rel="noreferrer">Agenda una capacitación</a>
              <a class="btn outline-dark" href="/contacto">Solicita una demostración</a>
            </div>
          </div>
        </div>
        <div class="training-features"><div class="training-feature"><i>♙</i><b>Capacitación<br>especializada</b></div><div class="training-feature"><i>♧</i><b>Personal<br>actualizado</b></div><div class="training-feature"><i>⚙</i><b>Tecnología<br>de punta</b></div><div class="training-feature"><i>⌁</i><b>Enfoque<br>práctico</b></div><div class="training-feature"><i>⌖</i><b>Cobertura<br>nacional</b></div></div>

        <div class="learning-intro"><article class="learning-copy"><div class="label">Aprendemos de quienes desarrollan la tecnología</div><h2>Aprendemos de quienes desarrollan la tecnología.</h2><p>Nuestro personal recibe capacitación directamente de nuestros proveedores y se actualiza constantemente para transferir ese conocimiento a nuestros clientes.</p><div class="benefits learning-points"><div class="benefit"><span>01</span><h3>Actualización constante</h3><p>Nos mantenemos al día con nuevas tecnologías, productos y procesos.</p></div><div class="benefit"><span>02</span><h3>Conocimiento aplicado</h3><p>Convertimos la teoría en buenas prácticas que generan resultados medibles.</p></div><div class="benefit"><span>03</span><h3>Entrenamiento por especialistas</h3><p>Aprende de técnicos e instructores con amplia experiencia en la industria.</p></div></div></article><div class="learning-image"><img src="/images/capacitacion-6.webp" alt="Formación técnica impartida por especialistas Etapel" loading="lazy"></div></div>

        <div class="training-cta"><div class="label">Nuestro proceso</div><h2>No empezamos por capacitar. Empezamos por entender tu operación.</h2><div class="process-grid"><div class="process-step"><strong>1</strong><b>Levantamiento</b><p>Visitamos tus instalaciones y conocemos tus procesos.</p></div><div class="process-step"><strong>2</strong><b>Detectamos oportunidades</b><p>Identificamos cuellos de botella y áreas de mejora.</p></div><div class="process-step"><strong>3</strong><b>Diseñamos la capacitación</b><p>Definimos productos, equipos y procesos.</p></div><div class="process-step"><strong>4</strong><b>Entrenamos a tu equipo</b><p>Capacitación teórica y práctica.</p></div><div class="process-step"><strong>5</strong><b>Implementamos procesos</b><p>Ayudamos a estandarizar la forma de trabajar.</p></div></div></div>

        <div class="training-grid service-grid">
          <article class="training-card"><img src="/images/capacitacion-1.webp" alt="Capacitación" loading="lazy"><div><h2>Capacitación</h2><p>Uso correcto de herramientas, productos y equipos de tecnología de punta.</p></div></article>
          <article class="training-card"><img src="/images/capacitacion-3.webp" alt="Demostraciones" loading="lazy"><div><h2>Demostraciones</h2><p>Prueba equipos y conoce su funcionamiento antes de tomar una decisión.</p></div></article>
          <article class="training-card"><img src="/images/capacitacion-4.webp" alt="Optimización de procesos" loading="lazy"><div><h2>Optimización de procesos</h2><p>Levantamientos y recomendaciones para incrementar eficiencia, calidad y productividad.</p></div></article>
        </div>

        <div class="action-gallery"><div class="carousel-head"><div class="label">CDTECH en acción</div><div class="carousel-controls"><button class="carousel-button carousel-prev" type="button" aria-label="Images précédentes">‹</button><button class="carousel-button carousel-next" type="button" aria-label="Images suivantes">›</button></div></div><h2 class="section-title">Conocimiento aplicado en el taller.</h2><div class="gallery"><img src="/images/capacitacion-1.webp" alt="CDTECH en acción" loading="lazy"><img src="/images/capacitacion-2.webp" alt="Formación Etapel" loading="lazy"><img src="/images/capacitacion-3.webp" alt="Demostración Etapel" loading="lazy"><img src="/images/capacitacion-4.webp" alt="Procesos Etapel" loading="lazy"><img src="/images/capacitacion-5.webp" alt="Seguridad en capacitación" loading="lazy"><img src="/images/capacitacion-6.webp" alt="Equipo en capacitación" loading="lazy"><img src="/images/capacitacion-1.webp" alt="Capacitación especializada" loading="lazy"><img src="/images/capacitacion-6.webp" alt="Trabajo técnico en equipo" loading="lazy"></div></div>

        <div class="benefit-band"><div class="benefit-heading"><div class="label">¿Por qué importa?</div><h2 class="section-title">El conocimiento también impacta tu productividad.</h2></div><div class="benefits"><article class="benefit"><span>✓</span><h3>Estandarización de procesos</h3><p>Obtenemos resultados más consistentes.</p></article><article class="benefit"><span>⚙</span><h3>Mejor uso de equipos</h3><p>Tu equipo opera como fue diseñado.</p></article><article class="benefit"><span>♙</span><h3>Mayor seguridad</h3><p>Equipos y procesos utilizados correctamente.</p></article><article class="benefit"><span>▥</span><h3>Más eficiencia y calidad</h3><p>Menos retrabajo y mejores acabados.</p></article></div></div>

