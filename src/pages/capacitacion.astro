  <script>
    const carousel = document.querySelector('.action-gallery .gallery');
    const moveCarousel = (direction) => {
      if (!carousel) return;
      const slide = carousel.querySelector('img');
      const distance = slide ? slide.getBoundingClientRect().width + 8 : carousel.clientWidth;
      carousel.scrollBy({ left: direction * distance, behavior: 'smooth' });
    };
    document.querySelector('.carousel-prev')?.addEventListener('click', () => moveCarousel(-1));
    document.querySelector('.carousel-next')?.addEventListener('click', () => moveCarousel(1));
  </script>
