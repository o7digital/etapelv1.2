---
import ProductCatalog from '../components/ProductCatalog.astro';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Etapel | Soluciones premium para talleres automotrices</title>
  <meta name="description" content="Etapel ofrece soluciones certificadas para talleres automotrices: pintura, cabinas, soldadura, aire comprimido, capacitación y postventa especializada." />
  <style>
    :root{
      --navy:#070b2f;
      --navy-2:#0b1145;
      --navy-3:#101a5f;
      --ink:#111827;
      --muted:#5f6b7a;
      --line:#e8edf5;
      --white:#ffffff;
      --soft:#f5f7fb;
      --orange:#f58220;
      --orange-dark:#d96e12;
      --green:#559a17;
      --shadow: 0 26px 70px rgba(7,11,47,.18);
      --shadow-soft: 0 16px 44px rgba(7,11,47,.10);
      --max:1180px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;color:var(--ink);background:#fff;}
    a{text-decoration:none;color:inherit}
    img{max-width:100%;display:block}
    .topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}
    .site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}
    .nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px}
    .brand{display:flex;align-items:center;gap:12px;min-width:190px}
    .brand img{width:168px;height:auto}
    .menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;letter-spacing:-.01em;white-space:nowrap}
    .menu a{opacity:.86}.menu a:hover{opacity:1;color:var(--orange-dark)}
    .nav-actions{display:flex;align-items:center;gap:12px}
    .lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;letter-spacing:-.01em;transition:.2s ease;cursor:pointer}
    .btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}
    .btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}
    .btn.white{background:#fff;color:var(--navy);border-color:rgba(255,255,255,.2)}
    .btn.outline{background:transparent;color:#fff;border-color:rgba(255,255,255,.28)}
    .btn.outline-dark{background:#fff;color:var(--navy);border-color:var(--line)}
    .btn.outline-dark:hover{border-color:var(--navy);transform:translateY(-1px)}
    .hero{position:relative;overflow:hidden;background:radial-gradient(circle at 78% 24%,rgba(245,130,32,.18),transparent 31%),linear-gradient(135deg,#070b2f 0%,#0b1145 48%,#050720 100%);color:#fff}
    .hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(to bottom,#000,transparent 88%);opacity:.7}
    .hero:after{content:"";position:absolute;width:540px;height:540px;border:1px solid rgba(245,130,32,.24);right:-130px;top:50px;transform:rotate(22deg);opacity:.72}
    .hero-inner{position:relative;z-index:1;max-width:var(--max);margin:0 auto;padding:86px 28px 92px;display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#f8fafc}
    .dot{width:8px;height:8px;background:var(--orange);box-shadow:0 0 0 6px rgba(245,130,32,.17)}
    h1{font-size:clamp(42px,6vw,76px);line-height:.93;letter-spacing:-.075em;margin:26px 0 22px;max-width:720px}
    .hero p{font-size:18px;line-height:1.7;color:#dbe4f2;margin:0;max-width:630px}
    .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}
    .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:42px;max-width:680px}
    .metric{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.07);padding:20px 18px;backdrop-filter: blur(12px)}
    .metric strong{display:block;font-size:30px;letter-spacing:-.04em;color:#fff}.metric span{display:block;margin-top:5px;font-size:12px;line-height:1.35;color:#b7c3d8;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
    .visual{position:relative;min-height:560px}
    .machine-card{position:absolute;right:0;top:36px;width:min(520px,100%);min-height:430px;background:linear-gradient(145deg,#fff,#f4f7fb);box-shadow:var(--shadow);border:1px solid rgba(255,255,255,.75);padding:28px;overflow:hidden}
    .machine-card:before{content:"";position:absolute;inset:auto -90px -120px auto;width:310px;height:310px;background:var(--orange);opacity:.13;transform:rotate(25deg)}
    .card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding-bottom:20px;color:var(--navy)}
    .chip{display:inline-flex;align-items:center;gap:8px;background:rgba(245,130,32,.12);color:var(--orange-dark);padding:8px 10px;font-size:11px;font-weight:950;text-transform:uppercase;letter-spacing:.12em}
    .machine-title{margin:14px 0 0;font-size:30px;line-height:1.03;letter-spacing:-.045em;color:var(--navy)}
    .spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:26px}
    .spec{background:#fff;border:1px solid var(--line);padding:18px;min-height:118px}.spec small{display:block;font-weight:900;font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:#7a8494}.spec b{display:block;margin-top:10px;font-size:22px;color:var(--navy);letter-spacing:-.035em}.spec p{margin:6px 0 0;color:#667085;font-size:13px;line-height:1.45}
    .orange-rule{height:6px;width:110px;background:var(--orange);margin-top:26px}
    .gys-card{position:absolute;left:0;bottom:28px;width:330px;background:#fff;color:var(--navy);box-shadow:var(--shadow);border-left:8px solid var(--orange);padding:24px;z-index:4}
    .gys-card .kicker{font-weight:950;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark)}
    .gys-card h3{font-size:36px;line-height:.9;margin:12px 0 10px;letter-spacing:-.07em;color:var(--navy)}
    .gys-card p{font-size:14px;line-height:1.55;color:#4b5563;margin:0}.gys-card .mini{display:flex;gap:8px;margin-top:16px}.mini span{height:8px;width:38px;background:var(--orange)}.mini span:nth-child(2){background:var(--green)}.mini span:nth-child(3){background:var(--navy)}
    .brands{background:#fff;border-bottom:1px solid var(--line)}
    .brands-inner{max-width:var(--max);margin:0 auto;padding:26px 28px;display:flex;align-items:center;gap:24px;justify-content:space-between;color:#7b8495;font-weight:900;letter-spacing:.06em;text-transform:uppercase;font-size:13px}.brands-list{display:flex;gap:34px;align-items:center;flex-wrap:wrap;color:#101a5f;font-size:15px}.brands-list span{opacity:.72}
    section{padding:92px 28px}.container{max-width:var(--max);margin:0 auto}.section-head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:38px}.section-head .label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:10px}.section-head h2{font-size:clamp(34px,4.2vw,56px);line-height:.98;letter-spacing:-.065em;margin:0;color:var(--navy);max-width:720px}.section-head p{max-width:410px;margin:0;color:#657183;line-height:1.7}
    .families{background:var(--soft)}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.family-card{position:relative;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:26px;min-height:280px;overflow:hidden}.family-card:before{content:"";position:absolute;top:0;left:0;width:100%;height:5px;background:var(--orange)}.family-card:nth-child(2):before{background:var(--navy-3)}.family-card:nth-child(3):before{background:var(--green)}.family-card:nth-child(4):before{background:var(--orange)}.icon{width:54px;height:54px;border:1px solid var(--line);display:grid;place-items:center;font-weight:950;color:var(--orange-dark);margin-bottom:28px;background:#fff}.family-card h3{font-size:23px;letter-spacing:-.035em;line-height:1.05;margin:0 0 12px;color:var(--navy)}.family-card p{font-size:14px;line-height:1.65;color:#606b7a;margin:0 0 24px}.family-card ul{list-style:none;padding:0;margin:0;display:grid;gap:8px;color:#364152;font-size:13px;font-weight:750}.family-card li:before{content:"—";color:var(--orange);margin-right:8px;font-weight:900}
    .catalog-section{background:#fff}.catalog-shell{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);padding:28px}.section-title{font-size:clamp(34px,4.2vw,56px);line-height:.98;letter-spacing:-.065em;margin:0;color:var(--navy)}.filter-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:20px}.filter-btn{min-height:62px;border:1px solid var(--line);background:#fff;padding:12px;font-size:12px;font-weight:900;text-transform:uppercase;color:var(--navy);cursor:pointer}.filter-btn.active,.filter-btn:hover{border-color:var(--navy);box-shadow:inset 0 0 0 1px var(--navy)}.catalog-toolbar{display:flex;gap:14px;justify-content:space-between;align-items:end;border-bottom:1px solid var(--line);padding:26px 0;margin-top:24px;flex-wrap:wrap}.catalog-count{font-size:30px;font-weight:950;color:var(--navy);letter-spacing:-.04em}.field{height:48px;border:1px solid var(--line);padding:0 14px;background:#fff;color:var(--ink);min-width:230px}.select-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips button{border:0;background:#edf1f7;color:#24314d;padding:9px 12px;font-weight:800;cursor:pointer}.catalog-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:30px}.product-card{min-height:420px;overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);transition:.2s ease}.product-card:hover{transform:translateY(-3px);border-color:var(--navy)}.product-card a{height:100%;display:flex;flex-direction:column}.product-image{height:230px;display:flex;align-items:center;justify-content:center;background:#f6f6f6;padding:20px}.product-image img{max-height:100%;object-fit:contain}.product-body{padding:20px;display:flex;flex:1;flex-direction:column}.product-body small{color:#657183}.product-body h3{margin:8px 0 10px;color:var(--navy);font-size:21px;line-height:1.05;letter-spacing:-.03em}.product-body p{color:#647083;line-height:1.55;font-size:14px}.arrow{margin-top:auto;align-self:flex-end;width:46px;height:46px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:24px}.empty{display:none;border:1px solid var(--line);background:#fff;padding:18px;margin-top:20px;color:#647083;font-weight:800}.hidden{display:none!important}
    .about-intro{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start;margin-bottom:44px}.about-lead{background:linear-gradient(145deg,var(--navy),var(--navy-2));color:#fff;padding:42px;border-left:8px solid var(--orange);box-shadow:var(--shadow)}.about-lead h2{font-size:52px;line-height:.96;letter-spacing:-.06em;margin:10px 0 18px}.about-lead p{color:#d9e2f3;line-height:1.75;margin:0}.about-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.about-card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:24px}.about-card h3{margin:0 0 12px;color:var(--navy);font-size:24px;letter-spacing:-.04em}.about-card p{margin:0;color:#647083;line-height:1.7;font-size:15px}.about-card.wide{grid-column:1/-1}.offer-list{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:16px}.offer-list span{background:#f7f8fb;border:1px solid var(--line);padding:11px 12px;color:#26314f;font-weight:850;font-size:13px}.split{display:grid;grid-template-columns:.95fr 1.05fr;gap:42px;align-items:stretch}.dark-panel{background:linear-gradient(145deg,var(--navy),var(--navy-2));color:#fff;padding:44px;position:relative;overflow:hidden;min-height:520px}.dark-panel:before{content:"";position:absolute;right:-80px;bottom:-100px;width:310px;height:310px;border:40px solid rgba(245,130,32,.16);transform:rotate(18deg)}.dark-panel h2{font-size:50px;line-height:.98;letter-spacing:-.06em;margin:14px 0 18px}.dark-panel p{color:#d9e2f3;line-height:1.7;max-width:520px}.proofs{display:grid;gap:14px;margin-top:34px}.proof{display:flex;gap:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);padding:18px}.proof b{display:block;color:#fff}.proof span{display:block;color:#b7c4dc;font-size:13px;margin-top:3px}.tick{width:28px;height:28px;background:var(--orange);display:grid;place-items:center;font-weight:950;flex:0 0 28px}
    .white-stack{display:grid;gap:18px}.service{border:1px solid var(--line);background:#fff;box-shadow:var(--shadow-soft);padding:30px;display:grid;grid-template-columns:100px 1fr;gap:24px;align-items:center}.service .num{font-size:56px;line-height:.9;font-weight:950;letter-spacing:-.08em;color:rgba(245,130,32,.28)}.service h3{font-size:26px;letter-spacing:-.04em;margin:0 0 8px;color:var(--navy)}.service p{margin:0;color:#647083;line-height:1.65}.training,.after-sales{background:linear-gradient(180deg,#f6f8fc 0%,#fff 100%)}.training-hero,.after-sales-hero{display:grid;grid-template-columns:1fr 1fr;gap:0;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.training-copy,.after-sales-copy{padding:50px}.training-copy h2,.after-sales-copy h2{font-size:54px;line-height:.96;letter-spacing:-.07em;margin:0 0 18px;color:var(--navy)}.training-copy p,.after-sales-copy p{color:#647083;line-height:1.75;font-size:17px}.training-media,.after-sales-media{min-height:430px;background:#f6f8fc}.training-media img,.after-sales-media img{width:100%;height:100%;object-fit:cover;object-position:center 38%}.training-actions,.after-sales-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.training-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:34px}.training-card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);overflow:hidden;display:grid;grid-template-columns:.85fr 1.15fr}.training-card img{width:100%;height:100%;min-height:230px;object-fit:cover}.training-card div{padding:26px}.training-card h3{margin:0 0 12px;color:var(--navy);font-size:25px;letter-spacing:-.04em}.training-card p{margin:0;color:#647083;line-height:1.65}.training-cta{margin-top:34px;background:var(--navy);color:#fff;padding:36px;border-left:8px solid var(--orange);box-shadow:var(--shadow)}.training-cta h3{font-size:34px;letter-spacing:-.05em;margin:0 0 12px}.training-cta p{color:#d6deee;line-height:1.7;margin:0;max-width:820px}.after-sales-services{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:34px}.after-sales-item{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:24px}.after-sales-item span{display:inline-grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);color:var(--orange-dark);font-weight:950;margin-bottom:18px}.after-sales-item h3{margin:0;color:var(--navy);font-size:22px;letter-spacing:-.035em}.after-sales-form{margin-top:34px;display:grid;grid-template-columns:.85fr 1.15fr;gap:30px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);padding:34px}.after-sales-form h3{font-size:38px;line-height:1;letter-spacing:-.055em;margin:0 0 14px;color:var(--navy)}.after-sales-form p{color:#647083;line-height:1.7}.form-grid{display:grid;gap:12px}.form-grid input,.form-grid select,.form-grid textarea{width:100%;border:1px solid var(--line);background:#f7f8fb;padding:14px 15px;font:inherit;color:var(--ink)}.form-grid textarea{min-height:140px;resize:vertical}
    .product{background:linear-gradient(180deg,#fff 0%,#f6f8fc 100%)}.product-box{display:grid;grid-template-columns:1fr 1fr;gap:0;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.product-copy{padding:56px}.product-copy h2{font-size:54px;line-height:.96;letter-spacing:-.07em;margin:0 0 18px;color:var(--navy)}.product-copy p{color:#647083;line-height:1.75}.product-copy .bullets{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:28px 0}.bullet{background:#f7f8fb;border:1px solid var(--line);padding:15px;font-weight:850;color:#26314f}.product-visual{background:radial-gradient(circle at 70% 35%,rgba(245,130,32,.26),transparent 31%),linear-gradient(145deg,#070b2f,#121b62);min-height:430px;position:relative;overflow:hidden}.spray{position:absolute;left:50%;top:50%;width:300px;height:82px;background:linear-gradient(90deg,#dfe6ef,#fff 45%,#a8b1c2);transform:translate(-50%,-50%) rotate(-16deg);box-shadow:0 24px 55px rgba(0,0,0,.32)}.spray:before{content:"";position:absolute;right:-78px;top:20px;width:96px;height:32px;background:linear-gradient(90deg,#fff,#b6becc)}.spray:after{content:"";position:absolute;left:70px;bottom:-96px;width:76px;height:110px;background:linear-gradient(#dde4ee,#8d98aa);transform:skewX(-8deg)}.spark{position:absolute;width:8px;height:8px;background:var(--orange);box-shadow:0 0 28px var(--orange)}.s1{left:18%;top:24%}.s2{right:24%;top:19%}.s3{right:18%;bottom:26%}.s4{left:30%;bottom:21%}
    .contact{background:linear-gradient(180deg,#fff 0%,#f6f8fc 100%);padding-bottom:0}.contact-hero{display:grid;grid-template-columns:.94fr 1.06fr;gap:0;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.contact-copy{padding:52px}.contact-copy h2{font-size:56px;line-height:.96;letter-spacing:-.07em;margin:0 0 18px;color:var(--navy)}.contact-copy p{color:#647083;line-height:1.75;font-size:17px}.contact-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.contact-media{min-height:470px;background:#f6f8fc}.contact-media img{width:100%;height:100%;object-fit:cover;object-position:center 35%}.contact-main{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:34px}.office-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.office-card,.contact-data,.contact-form,.map-card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft)}.office-card{padding:22px;font-weight:950;color:var(--navy);text-transform:uppercase;letter-spacing:.12em;font-size:12px}.contact-data{padding:30px;margin-top:18px}.contact-data h3,.contact-form h3{margin:0 0 18px;color:var(--navy);font-size:30px;letter-spacing:-.045em}.contact-links{display:grid;grid-template-columns:1fr 1fr;gap:14px}.contact-link{background:#f7f8fb;border:1px solid var(--line);padding:18px}.contact-link small{display:block;color:var(--orange-dark);font-weight:950;letter-spacing:.16em;text-transform:uppercase}.contact-link a{display:block;margin-top:10px;color:var(--navy);font-weight:900}.map-card{overflow:hidden;min-height:360px}.map-card img{width:100%;height:100%;object-fit:cover;object-position:top}.contact-form{margin-top:34px;padding:36px;display:grid;grid-template-columns:.85fr 1.15fr;gap:28px}.contact-form p{color:#647083;line-height:1.7;margin:0}.footer{padding:58px 28px 28px;background:linear-gradient(145deg,#050720 0%,var(--navy) 58%,#0b1145 100%);color:#d8e0ef}.footer-shell{max-width:var(--max);margin:0 auto}.footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer img{width:150px;filter:brightness(0) invert(1)}.footer p{color:#aeb8cf;line-height:1.7}.footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer a{color:#c8d2e5}.footer a:hover{color:#fff}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;color:#aeb8cf;font-size:13px}.footer-bottom-links{display:flex;gap:18px;flex-wrap:wrap}.footer-keywords{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);font-size:11px;line-height:1.8;color:#8f9ab2;text-align:center}
    @media(max-width:980px){.menu{display:none}.hero-inner,.about-intro,.split,.product-box,.training-hero,.after-sales-hero,.after-sales-form,.contact-hero,.contact-main,.contact-form,.cta-box{grid-template-columns:1fr}.visual{min-height:530px}.cards,.catalog-grid,.training-grid,.after-sales-services,.footer-grid{grid-template-columns:repeat(2,1fr)}.filter-grid{grid-template-columns:repeat(2,1fr)}.brands-inner{align-items:flex-start;flex-direction:column}.service,.training-card{grid-template-columns:1fr}.product-copy,.training-copy,.after-sales-copy,.contact-copy{padding:36px}}
