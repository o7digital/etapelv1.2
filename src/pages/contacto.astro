<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Contacto Etapel | Atención comercial y soporte</title>
  <meta name="description" content="Contacta a Etapel para información comercial, soporte, cotización y seguimiento de soluciones para taller automotriz." />
  <style>
    :root{--navy:#070b2f;--navy-2:#0b1145;--ink:#111827;--line:#e8edf5;--soft:#f5f7fb;--orange:#f58220;--orange-dark:#d96e12;--green:#559a17;--shadow:0 26px 70px rgba(7,11,47,.18);--shadow-soft:0 16px 44px rgba(7,11,47,.1);--max:1180px}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#f6f8fc}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}.nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px}.brand{min-width:190px}.brand img{width:168px}.menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;white-space:nowrap}.menu a:hover{color:var(--orange-dark)}.nav-actions{display:flex;align-items:center;gap:12px}.lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;transition:.2s ease}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}.btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}.btn.outline-dark{background:#fff;color:var(--navy);border-color:var(--line)}.btn.outline-dark:hover{border-color:var(--navy);transform:translateY(-1px)}
    main{background:linear-gradient(180deg,#f6f8fc 0%,#fff 100%)}section{padding:92px 28px}.container{max-width:var(--max);margin:0 auto}.label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:12px}.contact-hero{display:grid;grid-template-columns:.94fr 1.06fr;gap:0;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.contact-copy{padding:52px}.contact-copy h1{font-size:clamp(42px,5vw,64px);line-height:.96;letter-spacing:-.07em;margin:0 0 18px;color:var(--navy)}.contact-copy p{color:#647083;line-height:1.75;font-size:17px}.contact-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.contact-media{min-height:470px;background:#f6f8fc;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px;text-align:center}.contact-media img{width:min(320px,75%);height:auto}.contact-media p{margin:36px 0 0;color:#14609d;font-size:clamp(25px,3vw,43px);font-weight:400;line-height:1.05;text-transform:uppercase}.contact-media p strong{display:block;font-size:1.12em}.contact-main{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:34px}.office-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.office-card,.contact-data,.contact-form,.map-card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft)}.office-card{padding:22px;font-weight:950;color:var(--navy);text-transform:uppercase;letter-spacing:.12em;font-size:12px}.contact-data{padding:30px;margin-top:18px}.contact-data h2,.contact-form h2{margin:0 0 18px;color:var(--navy);font-size:30px;letter-spacing:-.045em}.contact-links{display:grid;grid-template-columns:1fr 1fr;gap:14px}.contact-link{background:#f7f8fb;border:1px solid var(--line);padding:18px}.contact-link small{display:block;color:var(--orange-dark);font-weight:950;letter-spacing:.16em;text-transform:uppercase}.contact-link a{display:block;margin-top:10px;color:var(--navy);font-weight:900}.map-card{overflow:hidden;min-height:360px}.map-card img{width:100%;height:100%;object-fit:cover;object-position:top}.contact-form{margin-top:34px;padding:36px;display:grid;grid-template-columns:.85fr 1.15fr;gap:28px}.contact-form p{color:#647083;line-height:1.7;margin:0}.form-grid{display:grid;gap:12px}.form-grid input,.form-grid select,.form-grid textarea{width:100%;border:1px solid var(--line);background:#f7f8fb;padding:14px 15px;font:inherit;color:var(--ink)}.form-grid textarea{min-height:140px;resize:vertical}.footer{padding:58px 28px 28px;background:linear-gradient(145deg,#050720 0%,var(--navy) 58%,#0b1145 100%);color:#d8e0ef}.footer-shell{max-width:var(--max);margin:0 auto}.footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer img{width:150px;filter:brightness(0) invert(1)}.footer p{color:#aeb8cf;line-height:1.7}.footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer a{color:#c8d2e5}.footer a:hover{color:#fff}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;color:#aeb8cf;font-size:13px}.footer-bottom-links{display:flex;gap:18px;flex-wrap:wrap}
    @media(max-width:980px){.menu{display:none}.contact-hero,.contact-main,.contact-form,.footer-grid{grid-template-columns:1fr}.contact-copy{padding:36px}}@media(max-width:640px){.nav{height:auto;padding:18px;align-items:flex-start}.nav-actions .btn{display:none}.brand img{width:140px}.office-grid,.contact-links{grid-template-columns:1fr}.contact-copy h1{font-size:40px}.footer-bottom{align-items:flex-start;flex-direction:column}}
    .mobile-menu{display:none}.mobile-menu summary{width:46px;height:46px;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;list-style:none;background:#fff}.mobile-menu summary::-webkit-details-marker{display:none}.hamburger,.hamburger:before,.hamburger:after{display:block;width:22px;height:2px;background:var(--navy);content:"";transition:.2s ease}.hamburger:before{transform:translateY(-7px)}.hamburger:after{transform:translateY(5px)}.mobile-menu[open] .hamburger{background:transparent}.mobile-menu[open] .hamburger:before{transform:translateY(2px) rotate(45deg)}.mobile-menu[open] .hamburger:after{transform:translateY(0) rotate(-45deg)}.mobile-panel{position:absolute;right:28px;top:calc(100% + 12px);width:min(88vw,360px);background:#fff;border:1px solid var(--line);box-shadow:0 22px 60px rgba(7,11,47,.18);padding:12px;display:grid;gap:4px}.mobile-panel a{padding:14px 16px;font-weight:850;color:#17203b}.mobile-panel a:hover{background:#f6f8fc;color:var(--orange-dark)}.mobile-panel .mobile-cta{margin-top:6px;background:var(--orange);color:#fff;text-align:center}@media(max-width:980px){.nav{position:relative}.nav-actions{display:none}.mobile-menu{display:block}}@media(max-width:640px){.nav{height:70px!important;padding:0 18px!important;align-items:center!important}.brand{min-width:0!important}.mobile-panel{right:18px}section{padding-left:20px!important;padding-right:20px!important}.field,.form-grid input,.form-grid select,.form-grid textarea{min-width:0;width:100%}.catalog-shell,.training-copy,.post-copy,.contact-copy,.about-copy,.product-copy{padding:24px!important}}
  </style>
</head>
<body>
  <div class="topline"></div>
  <header class="site-header">
    <nav class="nav">
      <a class="brand" href="/"><img src="/etapel-logo.svg" alt="Etapel"></a>
      <div class="menu">
        <a href="/">Home</a><a href="/linea-de-producto">Línea de Producto</a><a href="/quienes-somos">¿Quiénes Somos?</a><a href="/capacitacion">Capacitación</a><a href="/postventa">Posventa</a><a href="/contacto">Contacto</a>
      </div>
      <div class="nav-actions"><a class="lang" href="/en/contact" aria-label="Cambiar idioma a inglés">EN</a><a class="btn orange" href="/contacto#formulario-contacto">Solicitar información</a></div>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú"><span class="hamburger"></span></summary>
        <div class="mobile-panel">
          <a href="/">Home</a>
          <a href="/linea-de-producto">Línea de Producto</a>
          <a href="/quienes-somos">¿Quiénes Somos?</a>
          <a href="/capacitacion">Capacitación</a>
          <a href="/postventa">Posventa</a>
          <a href="/contacto">Contacto</a>
          <a href="/en/contact" aria-label="Cambiar idioma a inglés">EN</a>
          <a class="mobile-cta" href="/contacto#formulario-contacto">Solicitar información</a>
        </div>
      </details>

    </nav>
  </header>

  <main>
    <section>
      <div class="container">
        <div class="contact-hero">
          <div class="contact-copy">
            <div class="label">Contacta con un experto</div>
            <h1>Estamos aquí para ayudarte</h1>
            <p>Escríbenos para recibir atención comercial, seguimiento y orientación sobre las soluciones de Etapel.</p>
            <div class="contact-actions">
              <a href="mailto:ventas@etapel.com.mx" class="btn orange">ventas@etapel.com.mx</a>
              <a href="https://wa.link/oowyzu" class="btn outline-dark" target="_blank" rel="noreferrer">WhatsApp</a>
            </div>
          </div>
          <div class="contact-media">
            <img src="/etapel-logo.svg" alt="Etapel" loading="eager">
            <p>Somos proveedores<strong>exclusivos a nivel nacional</strong></p>
          </div>
        </div>

        <div class="contact-main">
          <div>
            <div class="office-grid">
              <article class="office-card">Monterrey</article>
              <article class="office-card">CDMX</article>
              <article class="office-card">Veracruz</article>
            </div>
            <div class="contact-data">
              <h2>Datos de contacto</h2>
              <div class="contact-links">
                <div class="contact-link"><small>Email</small><a href="mailto:ventas@etapel.com.mx">ventas@etapel.com.mx</a></div>
                <div class="contact-link"><small>Teléfono</small><a href="tel:+525556895055">55 5689 5055</a></div>
              </div>
              <div style="margin-top:20px"><a href="https://wa.link/oowyzu" class="btn orange" target="_blank" rel="noreferrer">contactanos</a></div>
            </div>
          </div>
          <div class="map-card"><img src="/images/mapa-etapel.webp" alt="Mapa de referencia Etapel" loading="lazy"></div>
        </div>

        <div class="contact-form" id="formulario-contacto">
          <div>
            <div class="label">Formulario</div>
            <h2>Contactanos, estamos para servirte</h2>
            <p>Comparte tus datos y el tema sobre el cual requieres información.</p>
          </div>
          <form class="form-grid" action="https://formspree.io/f/xeewlkng" method="POST">
            <input type="text" name="nombre" placeholder="Nombre *" required>
            <input type="text" name="empresa" placeholder="Empresa">
            <input type="tel" name="telefono" placeholder="Teléfono">
            <input type="email" name="email" placeholder="Correo *" required>
            <select name="tema" required>
              <option value="">Seleccione el tema del cual requiere información *</option>
              <option>Suscripción a ofertas especiales</option>
              <option>Atención personalizada</option>
              <option>Quejas o sugerencias</option>
            </select>
            <textarea name="mensaje" placeholder="Mensaje opcional"></textarea>
            <input type="hidden" name="_subject" value="Nuevo contacto desde Etapel">
            <button type="submit" class="btn orange">Enviar</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-shell">
      <div class="footer-grid">
        <div>
          <img src="/etapel-logo.svg" alt="Etapel" loading="lazy">
          <p>En Etapel, no somos solo proveedores, somos socios en el crecimiento de tu negocio.</p>
          <p>Descubre cómo podemos ayudarte a alcanzar nuevos niveles de éxito.</p>
        </div>
        <div>
          <h3>Línea de producto</h3>
          <ul>
            <li><a href="/linea-de-producto/pintura">Pintura</a></li>
            <li><a href="/linea-de-producto/cabinas-y-preparacion">Cabinas y Preparación</a></li>
            <li><a href="/linea-de-producto/soldadura-y-enderezado">Soldadura y Enderezado</a></li>
            <li><a href="/linea-de-producto/mecanica-y-aire">Mecánica y Aire</a></li>
          </ul>
        </div>
        <div>
          <h3>Servicios</h3>
          <ul>
            <li><a href="/capacitacion">Capacitación</a></li>
            <li><a href="/postventa">Posventa</a></li>
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <ul>
            <li><a href="mailto:ventas@etapel.com.mx">ventas@etapel.com.mx</a></li>
            <li><a href="tel:+525556895055">55 5689 5055</a></li>
            <li><a href="https://wa.link/oowyzu" target="_blank" rel="noreferrer">WhatsApp</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Copyright © 2026 Etapel. Todos los derechos reservados.</p>
        <div class="footer-bottom-links">
          <a href="/contacto">¿Necesitas ayuda? ¡Contáctanos!</a>
          <a href="/aviso-de-privacidad">Aviso de Privacidad</a>
          <a href="/en/contact">English version</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
