---
import SiteLayout from '../../layouts/SiteLayout.astro';

export function getStaticPaths() {
  return [
    { params: { page: undefined } },
    { params: { page: 'about-us' } },
    { params: { page: 'training' } },
    { params: { page: 'after-sales' } },
    { params: { page: 'contact' } },
  ];
}

const page = Astro.params.page ?? '';
const validPages = ['', 'about-us', 'training', 'after-sales', 'contact'];
if (!validPages.includes(page)) return Astro.redirect('/en');

const pages = {
  '': {
    title: 'Etapel | Automotive solutions in Mexico',
    description: 'Automotive refinishing equipment, tools, training and technical support from Etapel.',
    eyebrow: 'Automotive solutions',
    heading: 'Technology, service and expertise for your business',
    intro: 'We help automotive professionals improve productivity with specialized equipment, reliable supplies and expert support.',
    image: '/images/hero-etapel.webp',
  },
  'about-us': {
    title: 'About Us | Etapel',
    description: 'Learn about Etapel, a Mexican company providing automotive solutions and specialized services.',
    eyebrow: 'About Etapel',
    heading: 'More than a supplier, a strategic partner',
    intro: 'For more than three decades, we have imported, marketed and supported solutions that improve our customers’ productivity and profitability.',
    image: '/images/quienes-somos.webp',
  },
  training: {
    title: 'Training | Etapel',
    description: 'Specialized Etapel training for equipment, processes, safety and operational efficiency.',
    eyebrow: 'Learning system',
    heading: 'Specialized training focused on results',
    intro: 'We strengthen equipment use, operational efficiency and workplace safety through practical, expert-led training.',
    image: '/images/capacitacion-1.webp',
  },
  'after-sales': {
    title: 'After-Sales Service | Etapel',
    description: 'Etapel technical support, maintenance, repairs, installation and demonstrations.',
    eyebrow: 'Technical service',
    heading: 'Support that keeps your operation moving',
    intro: 'Our specialized team provides installation, maintenance, repairs and technical follow-up for your equipment and processes.',
    image: '/images/postventa.webp',
  },
  contact: {
    title: 'Contact Etapel | Sales and support',
    description: 'Contact Etapel for sales information, technical support and automotive solutions.',
    eyebrow: 'Talk to an expert',
    heading: 'We are here to help',
    intro: 'Contact our team for commercial assistance, follow-up and guidance on the right solution for your business.',
    image: '/etapel-logo.svg',
  },
} as const;

const content = pages[page as keyof typeof pages];
const isContact = page === 'contact';
const isHome = page === '';
---

<SiteLayout title={content.title} description={content.description} lang="en">
  <main>
    {isHome ? (
      <>
        <section class="home-hero">
          <div class="home-inner">
            <div>
              <span class="home-eyebrow"><span></span> Certified automotive technology</span>
              <h1>Premium solutions for high-performance body shops.</h1>
              <p>Equipment, paint, spray booths, welding, compressed air and specialized training for automotive professionals seeking standardized processes and professional results.</p>
              <div class="en-actions"><a class="btn orange" href="/linea-de-producto">View product catalog</a><a class="btn outline" href="/en/contact">Talk to an advisor</a></div>
              <div class="home-metrics"><div><strong>48</strong><span>World-leading product lines</span></div><div><strong>360°</strong><span>Equipment, support and after-sales</span></div><div><strong>CDMX</strong><span>Specialized technical service</span></div></div>
            </div>
            <div class="home-visual">
              <div class="home-machine">
                <span class="home-chip">Complete process</span>
                <h2>Professional paint, bodywork and equipment.</h2>
                <div class="home-specs">
                  <div><small>Family 01</small><b>Spray Guns & Paint</b><p>Spray guns, consumables and finishing systems.</p></div>
                  <div><small>Family 02</small><b>Spray Booths</b><p>Preparation, mixing and refinishing areas.</p></div>
                  <div><small>Family 03</small><b>Welding</b><p>Equipment for structural repair.</p></div>
                  <div><small>Family 04</small><b>Mechanics</b><p>Compressed air and complementary equipment.</p></div>
                  <div class="wide"><small>Family 05</small><b>Consumables</b><p>Abrasives, masking, plastics, pads, compounds and paper.</p></div>
                </div>
              </div>
              <div class="home-gys"><span>Approvals / Partner</span><h3>GYS</h3><p>Solutions certified by international manufacturers for professional repair processes.</p><i></i><i></i><i></i></div>
            </div>
          </div>
        </section>
        <div class="home-brands"><b>Brands and technologies</b><span>SATA</span><span>GYS</span><span>3M</span><span>PPG</span><span>Farecla</span><span>Rupes</span><span>Polyvance</span></div>
      </>
    ) : (
    <section class="en-hero">
      <div class="en-shell">
        <div class="en-copy">
          <div class="label">{content.eyebrow}</div>
          <h1>{content.heading}</h1>
          <p>{content.intro}</p>
          <div class="en-actions">
            <a class="btn orange" href={isContact ? 'mailto:ventas@etapel.com.mx' : '/en/contact'}>{isContact ? 'ventas@etapel.com.mx' : 'Talk to an expert'}</a>
            <a class="btn outline-dark" href={isHome ? '/linea-de-producto' : 'https://wa.link/oowyzu'}>{isHome ? 'View product lines' : 'WhatsApp'}</a>
          </div>
        </div>
        <div class:list={['en-media', { 'logo-media': isContact }]}>
          <img src={content.image} alt={content.heading} loading="eager" />
          {isContact && <p>Exclusive nationwide supplier</p>}
        </div>
      </div>
    </section>
    )}

    {isHome && <section class="en-section"><div class="container"><div class="section-head"><div><div class="label">Featured product</div><h2>Have you discovered the SATAjet X 5500?</h2></div></div><div class="en-grid"><a href="/linea-de-producto"><h3>Product lines</h3><p>Paint, preparation, welding, body repair, mechanics and compressed air.</p></a><a href="/en/training"><h3>Training</h3><p>Practical knowledge to improve quality, safety and productivity.</p></a><a href="/en/after-sales"><h3>After-sales</h3><p>Technical support throughout the service life of your equipment.</p></a></div></div></section>}
    {page === 'about-us' && <section class="en-section"><div class="container"><div class="en-grid"><article><h3>Our mission</h3><p>To meet the industry’s product and service needs while building valuable, long-term relationships.</p></article><article><h3>Our team</h3><p>Qualified professionals and distributors committed to excellent service throughout Mexico.</p></article><article><h3>Our commitment</h3><p>Consumables, tools, major equipment, maintenance, installation and specialized advice.</p></article></div></div></section>}
    {page === 'training' && <section class="en-section"><div class="container"><div class="en-grid"><article><h3>Specialized training</h3><p>Proper equipment use to maximize performance, productivity and safety.</p></article><article><h3>Efficient processes</h3><p>Cleaning, maintenance and workspace layouts designed for reliable operations.</p></article><article><h3>Continuous improvement</h3><p>Process standardization, workplace safety and identification of improvement opportunities.</p></article></div></div></section>}
    {page === 'after-sales' && <section class="en-section"><div class="container"><div class="en-grid"><article><h3>Technical assessments</h3><p>On-site analysis and clear recommendations for your operation.</p></article><article><h3>Maintenance and repairs</h3><p>Specialized service to protect performance and equipment life.</p></article><article><h3>Installation and training</h3><p>Installation, removal, demonstrations and operator training.</p></article></div></div></section>}
    {isContact && <section class="en-section"><div class="container"><form class="en-form" action="https://formspree.io/f/xeewlkng" method="POST"><input name="name" placeholder="Name *" required /><input name="company" placeholder="Company" /><input type="tel" name="phone" placeholder="Phone" /><input type="email" name="email" placeholder="Email *" required /><textarea name="message" placeholder="How can we help?"></textarea><input type="hidden" name="_subject" value="New English website contact" /><button class="btn orange" type="submit">Send message</button></form></div></section>}
  </main>
</SiteLayout>

<style>
  main{background:linear-gradient(180deg,#f6f8fc,#fff)}.home-hero{background:radial-gradient(circle at 82% 18%,rgba(245,130,32,.16),transparent 30%),linear-gradient(135deg,#070b2f,#0b1145 58%,#050720);color:#fff;overflow:hidden}.home-inner{max-width:1180px;margin:auto;padding:94px 28px;display:grid;grid-template-columns:1.02fr .98fr;gap:60px;align-items:center}.home-eyebrow{display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.07);font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.home-eyebrow span{width:9px;height:9px;background:var(--orange)}.home-inner h1{font-size:clamp(50px,5.7vw,76px);line-height:.94;letter-spacing:-.07em;margin:28px 0 22px}.home-inner>div>p{font-size:18px;line-height:1.7;color:#dbe4f2}.home-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:42px}.home-metrics div{border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.07);padding:20px}.home-metrics strong{font-size:34px;display:block}.home-metrics span{font-size:12px;color:#c5d0e2}.home-visual{position:relative;min-height:650px;display:flex;align-items:center}.home-machine{background:#fff;color:var(--navy);padding:30px;box-shadow:var(--shadow);width:100%;border-left:8px solid var(--orange)}.home-chip,.home-gys>span{color:var(--orange-dark);font-size:11px;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.home-machine h2{font-size:34px;line-height:1;letter-spacing:-.05em}.home-specs{display:grid;grid-template-columns:1fr 1fr;gap:12px}.home-specs div{border:1px solid var(--line);padding:16px}.home-specs .wide{grid-column:1/-1}.home-specs small,.home-specs b{display:block}.home-specs small{color:#7b8495;font-weight:900;text-transform:uppercase}.home-specs b{font-size:20px;margin:8px 0}.home-specs p{font-size:13px;color:#687386;margin:0}.home-gys{position:absolute;top:0;right:0;width:72%;background:#fff;color:var(--navy);padding:24px;border-left:7px solid var(--orange);box-shadow:var(--shadow)}.home-gys h3{font-size:34px;margin:10px 0}.home-gys p{font-size:13px;color:#647083}.home-gys i{display:inline-block;width:38px;height:7px;background:var(--orange);margin-right:7px}.home-gys i:nth-of-type(2){background:var(--green)}.home-gys i:nth-of-type(3){background:var(--navy)}.home-brands{max-width:1180px;margin:auto;padding:26px 28px;display:flex;gap:32px;align-items:center;flex-wrap:wrap;color:#101a5f;font-weight:900}.home-brands b{color:#7b8495;text-transform:uppercase;font-size:12px;margin-right:auto}.en-hero{padding:92px 28px}.en-shell{max-width:1180px;margin:auto;display:grid;grid-template-columns:.94fr 1.06fr;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.en-copy{padding:56px;border-left:8px solid var(--orange)}.en-copy h1{color:var(--navy);font-size:clamp(42px,5vw,64px);line-height:.96;margin:0 0 20px}.en-copy p{color:#647083;font-size:17px;line-height:1.75}.en-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.en-media{min-height:470px;background:#f6f8fc}.en-media img{width:100%;height:100%;object-fit:cover}.logo-media{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:50px}.logo-media img{width:min(320px,75%);height:auto;object-fit:contain}.logo-media p{color:#14609d;text-transform:uppercase;font-size:30px;text-align:center}.en-section{padding:70px 28px 86px}.en-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.en-grid article,.en-grid a{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:30px}.en-grid h3{color:var(--navy);font-size:28px;margin:0 0 14px}.en-grid p{color:#647083;line-height:1.7}.en-form{max-width:760px;margin:auto;display:grid;gap:12px;background:#fff;padding:34px;border:1px solid var(--line);box-shadow:var(--shadow-soft)}.en-form input,.en-form textarea{width:100%;border:1px solid var(--line);background:#f7f8fb;padding:15px;font:inherit}.en-form textarea{min-height:150px}@media(max-width:800px){.home-inner,.en-shell,.en-grid{grid-template-columns:1fr}.home-visual{min-height:620px}.home-metrics{grid-template-columns:1fr}.en-copy{padding:32px}.en-media{min-height:320px}}
</style>
