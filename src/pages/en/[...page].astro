---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import ProductFamilyMenu from '../../components/ProductFamilyMenu.astro';
import BrandMarquee from '../../components/BrandMarquee.astro';
import { productFamilies } from '../../data/productLines';

export function getStaticPaths() {
  return [
    { params: { page: undefined } },
    { params: { page: 'product-lines' } },
    { params: { page: 'about-us' } },
    { params: { page: 'training' } },
    { params: { page: 'after-sales' } },
    { params: { page: 'contact' } },
    { params: { page: 'privacy-policy' } },
  ];
}

const page = Astro.params.page ?? '';
const validPages = ['', 'product-lines', 'about-us', 'training', 'after-sales', 'contact', 'privacy-policy'];
if (!validPages.includes(page)) return Astro.redirect('/en');

const pages = {
  '': {
    title: 'Etapel | Automotive solutions in Mexico',
    description: 'Automotive refinishing equipment, tools, training and technical support from Etapel.',
    eyebrow: 'Automotive solutions',
    heading: 'Technology, service and expertise for your business',
    intro: 'We help automotive professionals improve productivity with specialized equipment, reliable supplies and expert support.',
    image: '/images/hero-etapel.webp',
  },
  'product-lines': {
    title: 'Product Lines | Etapel',
    description: 'Explore Etapel product lines for automotive paint, preparation, welding, body repair, mechanics and compressed air.',
    eyebrow: 'Product catalog',
    heading: 'Solutions for every stage of automotive repair',
    intro: 'Explore our main equipment and supply families. Individual product specifications remain in the original Spanish catalog for now.',
    image: '/etapel-logo.svg',
  },
  'about-us': {
    title: 'About Us | Etapel',
    description: 'Learn about Etapel, a Mexican company providing automotive solutions and specialized services.',
    eyebrow: 'About Etapel',
    heading: 'More than a supplier, a strategic partner',
    intro: 'For more than three decades, we have imported, marketed and supported solutions that improve our customers’ productivity and profitability.',
    image: '/images/quienes-somos.webp',
  },
  training: {
    title: 'Training | Etapel',
    description: 'Specialized Etapel training for equipment, processes, safety and operational efficiency.',
    eyebrow: 'Learning system',
    heading: 'Specialized training focused on results',
    intro: 'We strengthen equipment use, operational efficiency and workplace safety through practical, expert-led training.',
    image: '/images/capacitacion-1.webp',
  },
  'after-sales': {
    title: 'After-Sales Service | Etapel',
    description: 'Etapel technical support, maintenance, repairs, installation and demonstrations.',
    eyebrow: 'Technical service',
    heading: 'Support that keeps your operation moving',
    intro: 'Our specialized team provides installation, maintenance, repairs and technical follow-up for your equipment and processes.',
    image: '/images/postventa.webp',
  },
  contact: {
    title: 'Contact Etapel | Sales and support',
    description: 'Contact Etapel for sales information, technical support and automotive solutions.',
    eyebrow: 'Talk to an expert',
    heading: 'We are here to help',
    intro: 'Contact our team for commercial assistance, follow-up and guidance on the right solution for your business.',
    image: '/etapel-logo.svg',
  },
  'privacy-policy': {
    title: 'Privacy Policy | Etapel',
    description: 'Etapel privacy policy regarding the collection, use and protection of personal data.',
    eyebrow: 'Legal information',
    heading: 'Privacy Policy',
    intro: 'How Etapel collects, uses and protects your personal information.',
    image: '/etapel-logo.svg',
  },
} as const;

const content = pages[page as keyof typeof pages];
const isContact = page === 'contact';
const isHome = page === '';
const isProductLines = page === 'product-lines';
const familyEnglish: Record<string, { short: string; title: string; description: string }> = {
  'pintura-y-aplicacion': { short: 'Paint & application', title: 'Paint & application', description: 'Professional paint application equipment and systems.' },
  'preparacion-y-acabado': { short: 'Preparation & finishing', title: 'Preparation & finishing', description: 'Sanding, extraction, polishing and finishing systems.' },
  'enderezado-de-carroceria': { short: 'Body straightening', title: 'Body straightening', description: 'Straightening, measuring and alignment equipment.' },
  'desabollado-de-carroceria': { short: 'Dent repair', title: 'Body dent repair', description: 'Dent repair, welding, pulling and plastic repair.' },
  'cargadores-y-arrancadores-de-baterias': { short: 'Battery service', title: 'Battery chargers & starters', description: 'Battery charging, starting and testing equipment.' },
  pintura: { short: 'Paint', title: 'Paint', description: 'Automotive, industrial and powder coatings.' },
  mecanica: { short: 'Mechanical service', title: 'Mechanical service', description: 'Lifting, diagnostics, wheel service, A/C and ADAS.' },
  'consumibles-de-pintura': { short: 'Paint consumables', title: 'Paint consumables', description: 'Abrasives, masking, polishing and protection.' },
  'consumibles-de-hojalateria': { short: 'Bodywork consumables', title: 'Bodywork consumables', description: 'Fillers, sealants and tool consumables.' },
  'herramientas-de-hojalateria': { short: 'Bodywork tools', title: 'Bodywork tools', description: 'Pneumatic, hydraulic and manual tools.' },
  detallado: { short: 'Detailing', title: 'Detailing', description: 'Professional polishers and pads.' },
};
---

<SiteLayout title={content.title} description={content.description} lang="en">
  <main>
    {isHome ? (
      <>
        <section class="hero">
          <div class="hero-slider" aria-hidden="true">
            <img class="hero-slide" src="/slider/david-glessner-photographer-director-c-ebQX7w9FI-unsplash.webp" alt="" /><img class="hero-slide" src="/slider/lorenzo-hamers-0wTxCwWBVfs-unsplash.webp" alt="" /><img class="hero-slide" src="/slider/lorenzo-hamers-4b2w2KAahwg-unsplash.webp" alt="" /><img class="hero-slide" src="/slider/lorenzo-hamers-K2bNjPOUzSQ-unsplash.webp" alt="" /><img class="hero-slide" src="/slider/mohammad-fathollahi-hXhbEFS48oM-unsplash.webp" alt="" />
          </div>
          <div class="hero-inner">
            <div>
              <span class="eyebrow"><span class="dot"></span> Comprehensive Etapel solutions</span>
              <h1>Technology that transforms your operation.</h1>
              <p>Comprehensive solutions for automotive workshops, collision centers, industry and heavy transport.</p>
              <div class="hero-actions"><a class="btn orange" href="#sectors">Discover our solutions</a><a class="btn outline" href="/en/contact#contact-form">Talk to an expert</a></div>
            </div>
          </div>
          <div class="home-feature-strip"><a href="/en/product-lines">Global technology</a><a href="/en/about-us">Local experience</a><a href="/en/contact">Nationwide distribution</a><a href="/en/training">Training</a><a href="/en/after-sales">Technical service</a></div>
        </section>
      </>
    ) : isProductLines ? (
      <section class="page-hero">
        <div class="page-hero-inner">
          <div><span class="eyebrow"><span class="dot"></span> Product Lines</span><h1>Solutions organized by family for professional body shops.</h1><p>Browse the catalog by category, subfamily and product page through a clear, professional structure.</p><div class="hero-actions"><a class="btn orange" href="#product-catalog">View products</a><a class="btn outline" href="#families">View families</a></div></div>
          <div class="hero-panel"><div class="hero-panel-grid">{productFamilies.map((family) => <a class="hero-chip" href={family.href}>{familyEnglish[family.slug]?.short ?? family.shortTitle}</a>)}</div></div>
        </div>
      </section>
    ) : page === 'about-us' ? (
      <section class="about-page">
        <div class="container">
          <div class="about-hero">
            <div class="about-copy"><h1>More than three decades evolving with Mexican industry.</h1><p>We have grown alongside the needs of Mexico’s automotive and industrial sectors, combining technology, knowledge and service to create real value in every operation.</p><div class="about-actions"><a class="btn orange" href="#history">Discover our history →</a><a class="btn ghost" href="/en/contact">Contact us</a></div></div>
            <div class="about-media" role="img" aria-label="Etapel team outside its facilities"></div>
          </div>
          <div class="about-cards"><article><h2>Vision</h2><p>To serve an increasing number of customers as a market leader by offering the best purchasing option and cost-benefit ratio through world-class technology, innovation and experience, while being the best organization for our employees.</p></article><article><h2>Mission</h2><p>To meet the industry’s product and service needs while fostering our philosophy and values, building valuable long-term relationships with customers, employees, suppliers, society, the environment and shareholders, and contributing to Mexico’s development.</p></article></div>
          <div class="about-policy"><article><h2>Policy</h2><p>ETAPEL S.A. DE C.V. sells paint, consumables, tools and major equipment, and provides maintenance and installation services.</p><p>We are committed to environmental, safety and quality standards, legal compliance, risk prevention, employee well-being, sustainable technologies and continuous improvement.</p><p>We protect the environment through preventive and corrective measures that reduce pollutant emissions, supported by training and follow-up for all employees.</p></article><div><img src="/images/quienes-etapel-equipo.webp" alt="Etapel facilities and team" loading="lazy" /></div></div>
          <article class="about-offer"><h2>What we offer</h2><p>Our direct personnel and distributors form a highly professional, qualified and up-to-date team committed to excellent service.</p><p>We serve the automotive, bodywork, aeronautical paint, marine, transport, woodworking, construction and general industrial sectors.</p><div><span>Bodywork</span><span>Paint</span><span>Powder coating</span><span>Mechanics</span><span>Parking</span><span>Woodworking</span><span>Detailing</span><span>Construction & Industry</span></div></article>
          <div class="parity-heading" id="history"><div class="label">Our history</div><h2>Three decades of growth and constant innovation.</h2><p>Since our beginnings, Etapel has maintained a firm commitment to its customers and the industry.</p></div>
          <div class="history-grid">{['Our beginnings','Growth','Expansion','New product lines','CDTECH today'].map((item,i)=><article><b>{i+1}</b><h3>{item}</h3><p>{['We began by providing quality technical solutions and equipment to Mexico’s automotive industry.','We expanded our portfolio and strengthened partnerships with leading brands.','We opened new branches and brought specialized technical support to more regions.','We integrated advanced technology and developed solutions for new industrial sectors.','We created CDTECH to promote knowledge and continue evolving with Mexican industry.'][i]}</p><div>PHOTO {i+1}</div></article>)}</div>
          <div class="values-block"><div><div class="label">Our values</div><h2>How we think, how we act.</h2></div><div class="values-grid">{[['Quality','We do things right, from the first contact through final service.'],['Innovation','We seek new ideas and technologies to deliver better solutions.'],['Service','We listen, understand and support our customers.'],['Knowledge','We share experience and provide training.'],['Commitment','We take ownership of every challenge.']].map(v=><article><h3>{v[0]}</h3><p>{v[1]}</p></article>)}</div></div>
        </div>
      </section>
    ) : page === 'training' ? (
      <section class="training-page">
        <div class="container">
          <div class="training-hero">
            <div class="training-copy"><h1>CDTECH<br />Etapel Training Center</h1><p class="training-subtitle">Technology works best when people know how to use it.</p><p>Practical, specialized training in products, processes and advanced technology so your team can operate safely, efficiently and with excellence.</p><div class="training-actions"><a class="btn orange" href="https://wa.link/oowyzu">Schedule training</a><a class="btn outline-dark" href="/en/contact#contact-form">Request a demonstration</a></div></div>
          </div>
          <div class="training-features"><div class="training-feature"><i>♙</i><b>Specialized<br />training</b></div><div class="training-feature"><i>♧</i><b>Up-to-date<br />staff</b></div><div class="training-feature"><i>⚙</i><b>Advanced<br />technology</b></div><div class="training-feature"><i>⌁</i><b>Practical<br />approach</b></div><div class="training-feature"><i>⌖</i><b>Nationwide<br />coverage</b></div></div>
          <div class="learning-intro-en"><article><div class="label">We learn from those who develop the technology</div><h2>We learn from those who develop the technology.</h2><p>Our staff receives training directly from our suppliers and stays constantly updated to transfer that knowledge to our customers.</p><div class="learning-points-en"><div><span>01</span><h3>Continuous updates</h3><p>We stay current with new technologies, products and processes.</p></div><div><span>02</span><h3>Applied knowledge</h3><p>We turn theory into good practices that produce measurable results.</p></div><div><span>03</span><h3>Expert-led training</h3><p>Learn from technicians and instructors with broad industry experience.</p></div></div></article><img src="/images/capacitacion-6.webp" alt="Technical training delivered by Etapel specialists" /></div>
          <div class="training-grid-full">
            <article><img src="/images/capacitacion-1.webp" alt="Specialized training" /><div><h2>Training</h2><p>Correct use of professional tools, products and advanced technology.</p></div></article>
            <article><img src="/images/capacitacion-3.webp" alt="Equipment demonstration" /><div><h2>Demonstrations</h2><p>Test equipment and understand how it works before making a decision.</p></div></article>
            <article><img src="/images/capacitacion-4.webp" alt="Process optimization" /><div><h2>Process optimization</h2><p>Assessment, opportunity identification and recommendations to improve efficiency and quality.</p></div></article>
          </div>
          <div class="training-process"><div class="label">Our process</div><h2>We do not start by training. We start by understanding your operation.</h2><div>{[['01','Assessment'],['02','Opportunities'],['03','Training design'],['04','Team training'],['05','Standardized processes']].map(s=><article><b>{s[0]}</b><h3>{s[1]}</h3></article>)}</div></div>
          <div class="parity-heading"><div class="label">Why it matters</div><h2>Knowledge also improves your productivity.</h2></div>
          <div class="training-benefits">{[['Process standardization','Consistent procedures and results.'],['Better equipment use','Your team operates equipment as designed.'],['Greater safety','Equipment and processes are used correctly.'],['Greater efficiency and quality','Less rework and more consistent finishes.']].map(v=><article><h3>{v[0]}</h3><p>{v[1]}</p></article>)}</div>
          <div class="training-cta"><h2>Our goal is to be your strategic partner on the path to business success.</h2><p>Contact us today to discover how Etapel can add outstanding value to your company. Together, we can achieve great things.</p><div class="training-actions"><a class="btn orange" href="https://wa.link/oowyzu">Click here to contact us</a><a class="btn outline-dark" href="/en/contact#contact-form">Contact form</a></div></div>
        </div>
      </section>
    ) : page === 'after-sales' ? (
      <section class="support-en">
        <div class="container">
          <div class="support-en-hero"><div><div class="label">Technical support</div><h1>Technical service that protects your investment.</h1><p>We support your equipment after purchase to keep it operating safely, efficiently and productively.</p><div class="training-actions"><a class="btn orange" href="/en/contact#contact-form">Request technical service</a><a class="btn outline" href="#maintenance">Request a maintenance plan</a></div></div></div>
          <div class="support-en-features">{['Specialized installation','Preventive maintenance','Technical support','Nationwide coverage','After-sales service'].map(v=><b>{v}</b>)}</div>
          <div class="support-en-intro"><div><div class="label">Etapel after-sales</div><h2>More than repairs, we are your strategic partner.</h2><p>Our technical service goes beyond troubleshooting. We protect equipment performance, operational safety and availability.</p></div><div class="client-photo">MAIN PHOTO</div></div>
          <div class="parity-heading"><div class="label">Our services</div><h2>Comprehensive technical solutions for your operation.</h2></div>
          <div class="support-en-services">{[['Installation and commissioning','Equipment configuration, installation and commissioning.'],['Major equipment maintenance','Preventive and corrective service to extend equipment life.'],['Specialized booth service','Component and operating-condition inspections.'],['Filter replacement','Supply and replacement to maintain proper airflow.'],['Booth assembly and disassembly','Removal, relocation, reinstallation and testing.'],['Diagnostics and repair','Technical evaluation, repair and corrective actions.']].map((v,i)=><article><div>PHOTO {i+1}</div><h3>{v[0]}</h3><p>{v[1]}</p></article>)}</div>
          <div class="training-process" id="maintenance"><div class="label">Our approach</div><h2>Preventive maintenance that keeps your operation moving.</h2><div>{[['01','Diagnostics'],['02','Maintenance plan'],['03','Service'],['04','Follow-up']].map(s=><article><b>{s[0]}</b><h3>{s[1]}</h3></article>)}</div></div>
          <div class="parity-heading"><div class="label">Why our technical service matters</div><h2>Benefits reflected in your operation.</h2></div>
          <div class="training-benefits">{[['Longer equipment life','Proper maintenance extends performance and service life.'],['Fewer unplanned stops','Failure prevention and timely attention.'],['Safe, efficient operation','Compliance with safety and quality standards.'],['Better performance','Optimized equipment improves productivity and quality.']].map(v=><article><h3>{v[0]}</h3><p>{v[1]}</p></article>)}</div>
          <div class="coverage-en"><div><div class="label">Nationwide coverage</div><h2>Close to you, across Mexico.</h2><p>We support customers nationwide through our Mexico City, Monterrey and Veracruz branches and our service and distribution network.</p></div><div class="coverage-photos"><span>PHOTO CDMX</span><span>PHOTO MONTERREY</span><span>PHOTO VERACRUZ</span></div><img src="/images/mapa-etapel.webp" alt="Etapel nationwide coverage" /></div>
        </div>
      </section>
    ) : isContact ? (
      <section class="contact-parity"><div class="container"><div class="contact-parity-hero"><div class="contact-parity-copy"><div class="label">Nationwide coverage</div><h1>We are in Mexico.<strong>We reach all of Mexico.</strong></h1><p>We are present in Mexico City, Monterrey and Veracruz, with shipping, distribution and support throughout the country.</p><div class="en-actions"><a class="btn orange" href="#contact-form">Contact a specialist</a><a class="btn outline-dark" href="#branches">View branches</a></div></div><div class="contact-parity-media"><img src="/images/mapa-etapel.webp" alt="Etapel coverage in Mexico" /></div></div><div class="contact-feature-strip"><div><b>Presence</b><span>Mexico City, Monterrey and Veracruz</span></div><div><b>Distribution</b><span>Shipping throughout Mexico</span></div><div><b>Service</b><span>Personalized specialist advice</span></div><div><b>Solutions</b><span>Commercial and technical support</span></div></div></div></section>
    ) : (
    <section class="en-hero">
      <div class="en-shell">
        <div class="en-copy">
          <div class="label">{content.eyebrow}</div>
          <h1>{content.heading}</h1>
          <p>{content.intro}</p>
          <div class="en-actions">
            <a class="btn orange" href={isContact ? 'mailto:ventas@etapel.com.mx' : '/en/contact'}>{isContact ? 'ventas@etapel.com.mx' : 'Talk to an expert'}</a>
            <a class="btn outline-dark" href={isHome ? '/en/product-lines' : 'https://wa.link/oowyzu'}>{isHome ? 'View product lines' : 'WhatsApp'}</a>
          </div>
        </div>
        <div class:list={['en-media', { 'logo-media': isContact }]}>
          <img src={content.image} alt={content.heading} loading="eager" />
          {isContact && <p>Exclusive nationwide supplier</p>}
        </div>
      </div>
    </section>
    )}

    {isHome && <div class="home-parity">
      <section class="home-sectors" id="sectors"><div class="container"><div class="section-head"><div><div class="label">Which industry can we help you with?</div><h2>Solutions for every sector.</h2></div><p>Select your sector to find equipment, consumables and services tailored to your operation.</p></div><div class="sector-grid">
        <article class="sector-card automotive"><b>01</b><h3>Automotive</h3><p>Equipment, tools and solutions for automotive maintenance and service.</p><a href="/en/product-lines">Explore solutions →</a></article>
        <article class="sector-card collision"><b>02</b><h3>Collision & refinishing</h3><p>Complete solutions for body repair, preparation and paint.</p><a href="/en/product-lines">Explore solutions →</a></article>
        <article class="sector-card industry"><b>03</b><h3>Industry</h3><p>Equipment, consumables and solutions for high-performance industrial applications.</p><a href="/en/product-lines">Explore solutions →</a></article>
        <article class="sector-card transport"><b>04</b><h3>Heavy transport</h3><p>Solutions for trucks, tractor-trailers and high-volume operations.</p><a href="/en/product-lines">Explore solutions →</a></article>
      </div></div></section>
      <section><div class="container home-process"><div class="process-copy"><div class="label">Comprehensive solutions</div><h2>From a need to a complete solution.</h2><p>We support you throughout the process so your investment delivers greater productivity, quality and profitability.</p>{[['01','Assessment','We understand your space, operation and objectives.'],['02','Solution design','We integrate equipment and tailored processes.'],['03','Implementation','We install and commission the solution.'],['04','Training','We prepare your team to operate with confidence.'],['05','After-sales','We maintain the performance of your investment.']].map(v=><div class="process-step"><b>{v[0]}</b><span><strong>{v[1]}</strong>{v[2]}</span></div>)}</div><img src="/slider/lorenzo-hamers-K2bNjPOUzSQ-unsplash.webp" alt="Vehicle in a professional workshop" /></div></section>
      <section class="featured-products"><div class="container"><div class="section-head"><div><div class="label">Technology you need to know</div><h2>Featured equipment.</h2></div><a class="btn outline-dark" href="/en/product-lines">View all equipment</a></div><div class="featured-grid">
        <a href="/en/product-lines/products/sata-jet-x"><div><img src="/images/products/sata/jet-x/1200394-main.webp" alt="SATA jet X" /></div><small>Paint & application</small><h3>SATA jet X</h3><p>Premium automotive refinishing spray gun with X-nozzle technology.</p><b>→</b></a>
        <a href="/en/product-lines/products/catalogo-irt-prep-x-ldp"><div><img src="/images/products/client-catalog/prepcure.webp" alt="IRT Prep X LDP" /></div><small>Preparation & finishing</small><h3>IRT Prep X LDP</h3><p>Professional infrared drying to optimize repair times.</p><b>→</b></a>
        <a href="/en/product-lines/products/catalogo-gyspot-pti-neo-complete-g1-g2-g4-208-240v"><div><img src="/images/products/client-catalog/gyspot-pti-neo-complete-g1-g2-g4-208-240v.webp" alt="GYS GYSPOT PTI NEO" /></div><small>Body repair</small><h3>GYS GYSPOT PTI NEO</h3><p>High-performance spot welding for body repair.</p><b>→</b></a>
      </div></div></section>
      <BrandMarquee lang="en" />
      <section class="home-support"><div class="container"><div class="section-head"><div><div class="label">Support for your operation</div><h2>Knowledge, service and coverage.</h2></div><p>Etapel supports your investment before, during and after installation.</p></div><div class="support-grid">
        <article><span>01</span><h3>Specialized training</h3><p>Our training center turns knowledge into productivity.</p><a href="/en/training">Discover CDTECH →</a></article>
        <article><span>02</span><h3>Technical service</h3><p>Installation, maintenance, repairs and support to keep your equipment productive.</p><a href="/en/after-sales">Discover our service →</a></article>
        <article><span>03</span><h3>Nationwide coverage</h3><p>Service from Mexico City, Veracruz and Monterrey, with distribution throughout Mexico.</p><a href="/en/contact">View contact and branches →</a></article>
      </div></div></section>
      <section><div class="container certification"><div><div class="label">Certified quality</div><h2>Our commitment is certified.</h2><p>We work with an integrated management system focused on quality, the environment and the safety of our team.</p><a class="btn orange" href="/en/about-us">Learn more about us</a></div><div class="certification-grid">{[['ISO 9001','Quality management'],['ISO 14001','Environmental management'],['ISO 45001','Occupational health and safety']].map(v=><article><i>✓</i><strong>{v[0]}</strong><span>{v[1]}</span></article>)}</div></div></section>
    </div>}
    {isProductLines && <><ProductFamilyMenu lang="en" /><div id="product-catalog"><ProductCatalog lang="en" /></div></>}
    {isContact && <section class="contact-details"><div class="container">
      <div class="contact-main">
        <div>
          <div class="office-grid"><article>Monterrey</article><article>Mexico City</article><article>Veracruz</article></div>
          <div class="contact-data"><h2>Contact details</h2><div class="contact-links"><div><small>Email</small><a href="mailto:ventas@etapel.com.mx">ventas@etapel.com.mx</a></div><div><small>Phone</small><a href="tel:+525556895055">55 5689 5055</a></div></div><a class="btn orange" href="https://wa.link/oowyzu">Contact us</a></div>
        </div>
        <div class="map-card"><img src="/images/mapa-etapel.webp" alt="Etapel offices in Mexico" loading="lazy" /></div>
      </div>
      <div class="contact-form" id="contact-form">
        <div><div class="label">Contact form</div><h2>Contact us, we are here to help</h2><p>Share your details and tell us what information you need.</p></div>
        <form class="en-form" action="https://formspree.io/f/xeewlkng" method="POST"><input name="name" placeholder="Name *" required /><input name="company" placeholder="Company" /><input type="tel" name="phone" placeholder="Phone" /><input type="email" name="email" placeholder="Email *" required /><select name="topic" required><option value="">Select the topic you need information about *</option><option>Special offers</option><option>Personal assistance</option><option>Complaints or suggestions</option></select><textarea name="message" placeholder="Optional message"></textarea><input type="hidden" name="_subject" value="New English website contact" /><button class="btn orange" type="submit">Send message</button></form>
      </div>
    </div></section>}
    {page === 'privacy-policy' && <section class="privacy-content"><article>
      <p>Etapel, located at California 167, Col. Parque San Andrés, Mexico City, C.P. 04040, Mexico, is responsible for collecting, using and protecting your personal data.</p>
      <p>Your personal information will be used to provide the services and products you have requested, inform you of changes to them and evaluate the quality of the service we provide.</p>
