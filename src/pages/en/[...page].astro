---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import { productFamilies } from '../../data/productLines';

export function getStaticPaths() {
  return [
    { params: { page: undefined } },
    { params: { page: 'product-lines' } },
    { params: { page: 'about-us' } },
    { params: { page: 'training' } },
    { params: { page: 'after-sales' } },
    { params: { page: 'contact' } },
    { params: { page: 'privacy-policy' } },
  ];
}

const page = Astro.params.page ?? '';
const validPages = ['', 'product-lines', 'about-us', 'training', 'after-sales', 'contact', 'privacy-policy'];
if (!validPages.includes(page)) return Astro.redirect('/en');

const pages = {
  '': {
    title: 'Etapel | Automotive solutions in Mexico',
    description: 'Automotive refinishing equipment, tools, training and technical support from Etapel.',
    eyebrow: 'Automotive solutions',
    heading: 'Technology, service and expertise for your business',
    intro: 'We help automotive professionals improve productivity with specialized equipment, reliable supplies and expert support.',
    image: '/images/hero-etapel.webp',
  },
  'product-lines': {
    title: 'Product Lines | Etapel',
    description: 'Explore Etapel product lines for automotive paint, preparation, welding, body repair, mechanics and compressed air.',
    eyebrow: 'Product catalog',
    heading: 'Solutions for every stage of automotive repair',
    intro: 'Explore our main equipment and supply families. Individual product specifications remain in the original Spanish catalog for now.',
    image: '/etapel-logo.svg',
  },
  'about-us': {
    title: 'About Us | Etapel',
    description: 'Learn about Etapel, a Mexican company providing automotive solutions and specialized services.',
    eyebrow: 'About Etapel',
    heading: 'More than a supplier, a strategic partner',
    intro: 'For more than three decades, we have imported, marketed and supported solutions that improve our customers’ productivity and profitability.',
    image: '/images/quienes-somos.webp',
  },
  training: {
    title: 'Training | Etapel',
    description: 'Specialized Etapel training for equipment, processes, safety and operational efficiency.',
    eyebrow: 'Learning system',
    heading: 'Specialized training focused on results',
    intro: 'We strengthen equipment use, operational efficiency and workplace safety through practical, expert-led training.',
    image: '/images/capacitacion-1.webp',
  },
  'after-sales': {
    title: 'After-Sales Service | Etapel',
    description: 'Etapel technical support, maintenance, repairs, installation and demonstrations.',
    eyebrow: 'Technical service',
    heading: 'Support that keeps your operation moving',
    intro: 'Our specialized team provides installation, maintenance, repairs and technical follow-up for your equipment and processes.',
    image: '/images/postventa.webp',
  },
  contact: {
    title: 'Contact Etapel | Sales and support',
    description: 'Contact Etapel for sales information, technical support and automotive solutions.',
    eyebrow: 'Talk to an expert',
    heading: 'We are here to help',
    intro: 'Contact our team for commercial assistance, follow-up and guidance on the right solution for your business.',
    image: '/etapel-logo.svg',
  },
  'privacy-policy': {
    title: 'Privacy Policy | Etapel',
    description: 'Etapel privacy policy regarding the collection, use and protection of personal data.',
    eyebrow: 'Legal information',
    heading: 'Privacy Policy',
    intro: 'How Etapel collects, uses and protects your personal information.',
    image: '/etapel-logo.svg',
  },
} as const;

const content = pages[page as keyof typeof pages];
const isContact = page === 'contact';
const isHome = page === '';
const isProductLines = page === 'product-lines';
const familyEnglish: Record<string, { short: string; title: string; description: string }> = {
  pintura: { short: 'Spray Guns & Paint', title: 'Paint and refinishing', description: 'Spray guns, paint systems, filtration, protection and finishing supplies.' },
  'cabinas-y-preparacion': { short: 'Booths & Preparation', title: 'Spray booths and preparation', description: 'Preparation, mixing and refinishing areas for professional workshops.' },
  'soldadura-y-enderezado': { short: 'Welding & Body Repair', title: 'Welding and structural repair', description: 'Equipment for welding, straightening and structural body repair.' },
  'mecanica-y-aire': { short: 'Mechanics & Air', title: 'Mechanics and compressed air', description: 'Compressed-air systems and complementary workshop equipment.' },
  consumibles: { short: 'Consumables', title: 'Workshop consumables', description: 'Abrasives, masking products, plastics, pads, compounds and paper.' },
};
---

<SiteLayout title={content.title} description={content.description} lang="en">
  <main>
    {isHome ? (
      <>
        <section class="hero">
          <div class="hero-slider" aria-hidden="true">
            <img class="hero-slide" src="/slider/jimmy-blackwell-ihlrq5uUsIk-unsplash.jpg" alt="" /><img class="hero-slide" src="/slider/whereslugo-tBaM1JuJCKA-unsplash.jpg" alt="" /><img class="hero-slide" src="/slider/vitali-adutskevich-gAm_dPRQqvQ-unsplash.jpg" alt="" /><img class="hero-slide" src="/slider/clarity-coat-rsaYn6mq2qo-unsplash.jpg" alt="" /><img class="hero-slide" src="/slider/fred-anyona-8dIQuvrcRKw-unsplash.jpg" alt="" /><img class="hero-slide" src="/slider/clarity-coat-qu9XY-kl1oU-unsplash.jpg" alt="" />
          </div>
          <div class="hero-inner">
            <div>
              <span class="eyebrow"><span class="dot"></span> Certified automotive technology</span>
              <h1>Premium solutions for high-performance body shops.</h1>
              <p>Equipment, paint, spray booths, welding, compressed air and specialized training for automotive professionals seeking standardized processes and professional results.</p>
              <div class="hero-actions"><a class="btn orange" href="/en/product-lines">View product catalog</a><a class="btn outline" href="/en/contact#contact-form">Talk to an advisor</a></div>
              <div class="metrics"><div class="metric"><strong>48</strong><span>World-leading product lines</span></div><div class="metric"><strong>360°</strong><span>Equipment, support and after-sales</span></div><div class="metric"><strong>CDMX</strong><span>Specialized technical service</span></div></div>
            </div>
            <div class="visual">
              <div class="machine-card">
                <div class="card-head"><div><span class="chip">Complete process</span><h2 class="machine-title">Professional paint, bodywork and equipment.</h2></div></div>
                <div class="spec-grid">
                  <div class="spec"><small>Family 01</small><b>Spray Guns & Paint</b><p>Spray guns, consumables and finishing systems.</p></div>
                  <div class="spec"><small>Family 02</small><b>Spray Booths</b><p>Preparation, mixing and refinishing areas.</p></div>
                  <div class="spec"><small>Family 03</small><b>Welding</b><p>Equipment for structural repair.</p></div>
                  <div class="spec"><small>Family 04</small><b>Mechanics</b><p>Compressed air and complementary equipment.</p></div>
                  <div class="spec featured"><small>Family 05</small><b>Consumables</b><p>Abrasives, masking, plastics, pads, compounds and paper.</p></div>
                </div>
                <div class="orange-rule"></div>
              </div>
              <div class="gys-card"><span class="kicker">Approvals / Partner</span><h3>GYS</h3><p>Solutions certified by international manufacturers for professional repair processes.</p><div class="mini"><span></span><span></span><span></span></div></div>
            </div>
          </div>
        </section>
        <div class="brands"><div class="brands-inner"><span>Brands and technologies</span><div class="brands-list"><span>SATA</span><span>GYS</span><span>3M</span><span>PPG</span><span>Farecla</span><span>Rupes</span><span>Polyvance</span></div></div></div>
      </>
    ) : isProductLines ? (
      <section class="page-hero">
        <div class="page-hero-inner">
          <div><span class="eyebrow"><span class="dot"></span> Product Lines</span><h1>Solutions organized by family for professional body shops.</h1><p>Browse the catalog by category, subfamily and product page through a clear, professional structure.</p><div class="hero-actions"><a class="btn orange" href="#product-catalog">View products</a><a class="btn outline" href="#families">View families</a></div></div>
          <div class="hero-panel"><div class="hero-panel-grid">{productFamilies.map((family) => <a class="hero-chip" href={family.href}>{familyEnglish[family.slug]?.short ?? family.shortTitle}</a>)}</div></div>
        </div>
      </section>
    ) : page === 'about-us' ? (
      <section class="about-page">
        <div class="container">
          <div class="about-hero">
            <div class="about-copy"><div class="label">About Us</div><h1>Etapel SA de CV.</h1><p>We are a Mexican company with a clear goal: to improve our customers’ profitability. For more than three decades, we have imported, marketed and provided services that not only keep our products working, but also increase user productivity.</p><p>We exclusively represent 48 leading global product lines, enabling us to provide high-quality solutions backed by our experience and commitment.</p></div>
            <div class="about-media"><img src="/images/quienes-grupo-cesvi.jpeg" alt="Etapel team" loading="eager" /></div>
          </div>
          <div class="about-cards"><article><h2>Vision</h2><p>To serve an increasing number of customers as a market leader by offering the best purchasing option and cost-benefit ratio through world-class technology, innovation and experience, while being the best organization for our employees.</p></article><article><h2>Mission</h2><p>To meet the industry’s product and service needs while fostering our philosophy and values, building valuable long-term relationships with customers, employees, suppliers, society, the environment and shareholders, and contributing to Mexico’s development.</p></article></div>
          <div class="about-policy"><article><h2>Policy</h2><p>ETAPEL S.A. DE C.V. sells paint, consumables, tools and major equipment, and provides maintenance and installation services.</p><p>We are committed to environmental, safety and quality standards, legal compliance, risk prevention, employee well-being, sustainable technologies and continuous improvement.</p><p>We protect the environment through preventive and corrective measures that reduce pollutant emissions, supported by training and follow-up for all employees.</p></article><div><img src="/images/quienes-etapel-equipo.jpg" alt="Etapel facilities and team" loading="lazy" /></div></div>
          <article class="about-offer"><h2>What we offer</h2><p>Our direct personnel and distributors form a highly professional, qualified and up-to-date team committed to excellent service.</p><p>We serve the automotive, bodywork, aeronautical paint, marine, transport, woodworking, construction and general industrial sectors.</p><div><span>Bodywork</span><span>Paint</span><span>Powder coating</span><span>Mechanics</span><span>Parking</span><span>Woodworking</span><span>Detailing</span><span>Construction & Industry</span></div></article>
        </div>
      </section>
    ) : page === 'training' ? (
      <section class="training-page">
        <div class="container">
          <div class="training-hero">
            <div class="training-copy"><div class="label">Learning system</div><h1>Training Services at Etapel.</h1><p>We strengthen proper equipment use, operational efficiency and workplace safety through results-focused training.</p><div class="training-actions"><a class="btn orange" href="https://wa.link/oowyzu">Click here to contact us</a><a class="btn outline-dark" href="/en/contact#contact-form">Go to contact</a></div></div>
            <div class="training-media"><img src="/images/capacitacion-1.webp" alt="Etapel training" loading="eager" /></div>
          </div>
          <div class="training-grid-full">
            <article><img src="/images/capacitacion-1.webp" alt="Specialized training" /><div><h2>1. Specialized Training</h2><p>Our experts train your personnel in the proper use of equipment, helping them maximize its potential, increase productivity and maintain workplace safety.</p></div></article>
            <article><img src="/images/capacitacion-2.webp" alt="Efficient cleaning" /><div><h2>2. Efficient Cleaning</h2><p>We teach best practices for equipment cleaning and maintenance. Proper cleaning extends service life and ensures optimal performance.</p></div></article>
            <article><img src="/images/capacitacion-3.webp" alt="Efficient workspace design" /><div><h2>3. Efficient Workspace Design</h2><p>When required, we create customized layouts to optimize workflow and maximize operational efficiency.</p></div></article>
            <article><img src="/images/capacitacion-4.webp" alt="Standardized processes" /><div><h2>4. Standardized Processes</h2><p>We help ensure your processes meet high quality and safety standards, improving operational reliability.</p></div></article>
            <article><img src="/images/capacitacion-5.webp" alt="Personnel safety" /><div><h2>5. Personnel Safety</h2><p>We assess and improve working conditions to provide a safe environment for your personnel.</p></div></article>
            <article><img src="/images/capacitacion-6.webp" alt="Opportunity identification" /><div><h2>6. Opportunity Identification</h2><p>We analyze your operations to identify opportunities and support informed decisions for efficient growth.</p></div></article>
          </div>
          <div class="training-cta"><h2>Our goal is to be your strategic partner on the path to business success.</h2><p>Contact us today to discover how Etapel can add outstanding value to your company. Together, we can achieve great things.</p><div class="training-actions"><a class="btn orange" href="https://wa.link/oowyzu">Click here to contact us</a><a class="btn outline-dark" href="/en/contact#contact-form">Contact form</a></div></div>
        </div>
      </section>
    ) : (
    <section class="en-hero">
      <div class="en-shell">
        <div class="en-copy">
          <div class="label">{content.eyebrow}</div>
          <h1>{content.heading}</h1>
          <p>{content.intro}</p>
          <div class="en-actions">
            <a class="btn orange" href={isContact ? 'mailto:ventas@etapel.com.mx' : '/en/contact'}>{isContact ? 'ventas@etapel.com.mx' : 'Talk to an expert'}</a>
            <a class="btn outline-dark" href={isHome ? '/en/product-lines' : 'https://wa.link/oowyzu'}>{isHome ? 'View product lines' : 'WhatsApp'}</a>
          </div>
        </div>
        <div class:list={['en-media', { 'logo-media': isContact }]}>
          <img src={content.image} alt={content.heading} loading="eager" />
          {isContact && <p>Exclusive nationwide supplier</p>}
        </div>
      </div>
    </section>
    )}

    {isHome && <section class="en-section"><div class="container"><div class="section-head"><div><div class="label">Featured product</div><h2>Have you discovered the SATAjet X 5500?</h2></div></div><div class="en-grid"><a href="/en/product-lines"><h3>Product lines</h3><p>Paint, preparation, welding, body repair, mechanics and compressed air.</p></a><a href="/en/training"><h3>Training</h3><p>Practical knowledge to improve quality, safety and productivity.</p></a><a href="/en/after-sales"><h3>After-sales</h3><p>Technical support throughout the service life of your equipment.</p></a></div></div></section>}
    {isProductLines && <><section id="families" class="en-section"><div class="container"><div class="section-head"><div><div class="label">Main families</div><h2>Clear access to every product category.</h2></div><p>Choose a family to explore the corresponding equipment and supplies.</p></div><div class="grid-families">{productFamilies.map((family) => { const translated = familyEnglish[family.slug]; return <article class="family-tile"><div class="family-copy"><div class="label">{translated?.short ?? family.shortTitle}</div><h3>{translated?.title ?? family.title}</h3><p>{translated?.description ?? family.menuDescription}</p><div style="margin-top:24px"><a class="btn outline-dark" href={family.href}>View category</a></div></div><div class="family-media"><img src={family.image} alt={translated?.title ?? family.title} loading="lazy" /></div></article> })}</div></div></section><div id="product-catalog"><ProductCatalog lang="en" /></div></>}
    {page === 'after-sales' && <section class="en-section"><div class="container"><div class="en-grid"><article><h3>Technical assessments</h3><p>On-site analysis and clear recommendations for your operation.</p></article><article><h3>Maintenance and repairs</h3><p>Specialized service to protect performance and equipment life.</p></article><article><h3>Installation and training</h3><p>Installation, removal, demonstrations and operator training.</p></article></div></div></section>}
    {isContact && <section class="contact-details"><div class="container">
      <div class="contact-main">
        <div>
          <div class="office-grid"><article>Monterrey</article><article>Mexico City</article><article>Veracruz</article></div>
          <div class="contact-data"><h2>Contact details</h2><div class="contact-links"><div><small>Email</small><a href="mailto:ventas@etapel.com.mx">ventas@etapel.com.mx</a></div><div><small>Phone</small><a href="tel:+525556895055">55 5689 5055</a></div></div><a class="btn orange" href="https://wa.link/oowyzu">Contact us</a></div>
        </div>
        <div class="map-card"><img src="/images/mapa-etapel.webp" alt="Etapel offices in Mexico" loading="lazy" /></div>
      </div>
      <div class="contact-form" id="contact-form">
        <div><div class="label">Contact form</div><h2>Contact us, we are here to help</h2><p>Share your details and tell us what information you need.</p></div>
        <form class="en-form" action="https://formspree.io/f/xeewlkng" method="POST"><input name="name" placeholder="Name *" required /><input name="company" placeholder="Company" /><input type="tel" name="phone" placeholder="Phone" /><input type="email" name="email" placeholder="Email *" required /><select name="topic" required><option value="">Select the topic you need information about *</option><option>Special offers</option><option>Personal assistance</option><option>Complaints or suggestions</option></select><textarea name="message" placeholder="Optional message"></textarea><input type="hidden" name="_subject" value="New English website contact" /><button class="btn orange" type="submit">Send message</button></form>
      </div>
    </div></section>}
    {page === 'privacy-policy' && <section class="privacy-content"><article>
      <p>Etapel, located at California 167, Col. Parque San Andrés, Mexico City, C.P. 04040, Mexico, is responsible for collecting, using and protecting your personal data.</p>
      <p>Your personal information will be used to provide the services and products you have requested, inform you of changes to them and evaluate the quality of the service we provide.</p>
      <p>For these purposes, we may collect your name, landline number, mobile number and email address. If invoicing is required, we may also request your legal business name, Mexican Federal Taxpayer Registry number (RFC), tax address, contact telephone number and the email address to which the information will be sent. None of this information is considered sensitive under Mexico’s Federal Law on the Protection of Personal Data Held by Private Parties.</p>
      <p>You have the right to access, correct and cancel your personal data, object to its processing or withdraw your consent. To exercise these rights, contact us at <a href="tel:+525556895055">55 5689 5055</a>, visit California 167, Col. Parque San Andrés, Mexico City, C.P. 04040, Mexico, or email <a href="mailto:ventas@etapel.com.mx">ventas@etapel.com.mx</a>.</p>
      <p>Your personal data may be processed only within Mexico by authorized Etapel personnel. Your information may not be shared with any other institution for any reason.</p>
    </article></section>}
  </main>
</SiteLayout>

<style>
  main{background:linear-gradient(180deg,#f6f8fc,#fff)}.hero{position:relative;overflow:hidden;padding:0;background:radial-gradient(circle at 78% 24%,rgba(245,130,32,.18),transparent 31%),linear-gradient(135deg,#070b2f 0%,#0b1145 48%,#050720 100%);color:#fff}.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(to bottom,#000,transparent 88%);opacity:.7}.hero:after{content:"";position:absolute;width:540px;height:540px;border:1px solid rgba(245,130,32,.24);right:-130px;top:50px;transform:rotate(22deg);opacity:.72}.hero-inner{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:86px 28px 92px;display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center}.eyebrow{display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.dot{width:8px;height:8px;background:var(--orange);box-shadow:0 0 0 6px rgba(245,130,32,.17)}.hero h1{font-size:clamp(42px,6vw,76px);line-height:.93;letter-spacing:-.075em;margin:26px 0 22px}.hero p{font-size:18px;line-height:1.7;color:#dbe4f2;margin:0}.hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:42px}.metric{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.07);padding:20px 18px}.metric strong{display:block;font-size:30px}.metric span{display:block;margin-top:5px;font-size:12px;color:#b7c3d8;font-weight:800;text-transform:uppercase}.visual{position:relative;min-height:720px}.machine-card{position:absolute;right:0;top:170px;width:min(560px,100%);min-height:500px;background:linear-gradient(145deg,#fff,#f4f7fb);box-shadow:var(--shadow);padding:28px;overflow:hidden}.card-head{border-bottom:1px solid var(--line);padding-bottom:20px}.chip{display:inline-flex;background:rgba(245,130,32,.12);color:var(--orange-dark);padding:8px 10px;font-size:11px;font-weight:950;text-transform:uppercase;letter-spacing:.12em}.machine-title{margin:14px 0 0;font-size:30px;line-height:1.03;letter-spacing:-.045em;color:var(--navy)}.spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:26px}.spec{background:#fff;border:1px solid var(--line);padding:18px;min-height:118px}.spec small{display:block;font-weight:900;font-size:11px;text-transform:uppercase;color:#7a8494}.spec b{display:block;margin-top:10px;font-size:22px;color:var(--navy)}.spec p{margin:6px 0 0;color:#667085;font-size:13px;line-height:1.45}.spec.featured{grid-column:1/-1;min-height:104px}.orange-rule{height:6px;width:110px;background:var(--orange);margin-top:26px}.gys-card{position:absolute;right:0;top:0;width:min(560px,100%);background:#fff;color:var(--navy);box-shadow:var(--shadow);border-left:8px solid var(--orange);padding:24px;z-index:4}.gys-card .kicker{font-weight:950;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark)}.gys-card h3{font-size:36px;line-height:.9;margin:12px 0 10px;color:var(--navy)}.gys-card p{font-size:14px;line-height:1.55;color:#4b5563}.mini{display:flex;gap:8px;margin-top:16px}.mini span{height:8px;width:38px;background:var(--orange)}.mini span:nth-child(2){background:var(--green)}.mini span:nth-child(3){background:var(--navy)}.brands{background:#fff;border-bottom:1px solid var(--line)}.brands-inner{max-width:1180px;margin:0 auto;padding:26px 28px;display:flex;align-items:center;gap:24px;justify-content:space-between;color:#7b8495;font-weight:900;text-transform:uppercase;font-size:13px}.brands-list{display:flex;gap:34px;flex-wrap:wrap;color:#101a5f;font-size:15px}.en-hero{padding:92px 28px}.en-shell{max-width:1180px;margin:auto;display:grid;grid-template-columns:.94fr 1.06fr;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);overflow:hidden}.en-copy{padding:56px;border-left:8px solid var(--orange)}.en-copy h1{color:var(--navy);font-size:clamp(42px,5vw,64px);line-height:.96;margin:0 0 20px}.en-copy p{color:#647083;font-size:17px;line-height:1.75}.en-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}.en-media{min-height:470px;background:#f6f8fc}.en-media img{width:100%;height:100%;object-fit:cover}.logo-media{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:50px}.logo-media img{width:min(320px,75%);height:auto;object-fit:contain}.logo-media p{color:#14609d;text-transform:uppercase;font-size:30px;text-align:center}.en-section{padding:70px 28px 86px}.en-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.en-grid article,.en-grid a{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:30px}.en-grid h3{color:var(--navy);font-size:28px;margin:0 0 14px}.en-grid p{color:#647083;line-height:1.7}.en-form{max-width:760px;margin:auto;display:grid;gap:12px;background:#fff;padding:34px;border:1px solid var(--line);box-shadow:var(--shadow-soft)}.en-form input,.en-form textarea{width:100%;border:1px solid var(--line);background:#f7f8fb;padding:15px;font:inherit}.en-form textarea{min-height:150px}@media(max-width:800px){.hero-inner,.en-shell,.en-grid{grid-template-columns:1fr}.visual{min-height:720px}.metrics{grid-template-columns:1fr}.en-copy{padding:32px}.en-media{min-height:320px}}
</style>
<style>
  .hero-slider{position:absolute;inset:0;z-index:0}.hero-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;animation:heroFade 36s infinite}.hero-slide:nth-child(2){animation-delay:6s}.hero-slide:nth-child(3){animation-delay:12s}.hero-slide:nth-child(4){animation-delay:18s}.hero-slide:nth-child(5){animation-delay:24s}.hero-slide:nth-child(6){animation-delay:30s}.hero-slider:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,11,47,.94),rgba(7,11,47,.64))}@keyframes heroFade{0%{opacity:0}3%{opacity:1}16.66%{opacity:1}19.66%{opacity:0}100%{opacity:0}}
