---
import BackToTop from '../components/BackToTop.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>¿Quiénes Somos? | Etapel SA de CV</title>
  <meta name="description" content="Etapel SA de CV: empresa mexicana dedicada a soluciones automotrices, pintura, consumibles, herramientas, equipos mayores, mantenimiento e instalación." />
  <style>
    :root{--navy:#070b2f;--navy-2:#0b1145;--ink:#111827;--line:#e8edf5;--soft:#f5f7fb;--orange:#f58220;--orange-dark:#d96e12;--green:#559a17;--shadow:0 26px 70px rgba(7,11,47,.18);--shadow-soft:0 16px 44px rgba(7,11,47,.1);--max:1180px}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}.nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px}.brand{min-width:190px}.brand img{width:168px}.menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;white-space:nowrap}.menu a:hover{color:var(--orange-dark)}.nav-actions{display:flex;align-items:center;gap:12px}.lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;transition:.2s ease}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}.btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}
    main{background:linear-gradient(180deg,#fff 0%,#f6f8fc 100%)}section{padding:92px 28px}.container{max-width:var(--max);margin:0 auto}.label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:12px}.about-section{padding:0 28px 92px;background:#07101e}.about-section .container{max-width:1440px}.about-hero{display:grid;grid-template-columns:1fr 1fr;min-height:570px;background:#07101e url('/hero2.webp') center/cover no-repeat;overflow:hidden}.about-copy{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center;padding:70px 8vw;background:linear-gradient(90deg,rgba(3,8,16,.96),rgba(3,8,16,.72),rgba(3,8,16,.2))}.about-copy .label{color:#fff}.about-copy h1{max-width:650px;font-size:clamp(42px,4.3vw,66px);line-height:1.02;letter-spacing:-.055em;text-transform:uppercase;margin:0 0 20px;color:#fff}.about-copy p{max-width:610px;color:#eef3fb;line-height:1.58;font-size:16px}.about-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:28px}.btn.ghost{border-color:rgba(255,255,255,.7);color:#fff;background:rgba(3,8,16,.3)}.about-media{position:relative;min-height:570px;background:transparent}.about-media::after{content:"Orgullosamente\A Mexicana  🇲🇽";white-space:pre;position:absolute;right:24px;bottom:22px;padding:10px 15px;border:1px solid rgba(255,255,255,.75);border-radius:20px;color:#fff;background:rgba(3,8,16,.48);font-size:11px;text-align:center}.about-content{padding-top:0}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:34px}.card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:30px}.card.wide{grid-column:1/-1}.card h2{margin:0 0 14px;color:var(--navy);font-size:34px;letter-spacing:-.05em}.card p{margin:0;color:#647083;line-height:1.75}.policy-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;margin-top:18px}.policy-img{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);overflow:hidden}.policy-img img{width:100%;height:100%;min-height:360px;object-fit:cover}.offer-list{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.offer-list span{background:#f7f8fb;border:1px solid var(--line);padding:13px 14px;color:#26314f;font-weight:850;font-size:13px}.footer{padding:58px 28px 28px;background:linear-gradient(145deg,#050720 0%,var(--navy) 58%,#0b1145 100%);color:#d8e0ef}.footer-shell{max-width:var(--max);margin:0 auto}.footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer img{width:150px;filter:brightness(0) invert(1)}.footer p{color:#aeb8cf;line-height:1.7}.footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer a{color:#c8d2e5}.footer a:hover{color:#fff}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;color:#aeb8cf;font-size:13px}.footer-bottom-links{display:flex;gap:18px;flex-wrap:wrap}.footer-keywords{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);font-size:11px;line-height:1.8;color:#8f9ab2;text-align:center}
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:38px}.section-head h2{font-size:clamp(34px,4.2vw,56px);line-height:.98;letter-spacing:-.065em;margin:0;color:var(--navy)}.section-head p{max-width:480px;color:#647083;line-height:1.7}.history-block{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);overflow:hidden}.timeline{display:grid;grid-template-columns:repeat(5,1fr);padding:30px 26px 26px}.milestone{position:relative;text-align:center;padding:0 16px}.milestone::after{content:"";position:absolute;top:20px;left:calc(50% + 28px);width:calc(100% - 56px);border-top:2px dotted #c7cfdd}.milestone:last-child::after{display:none}.milestone>span{position:absolute;z-index:2;top:5px;left:8px;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#2d59c8;color:#fff;font-weight:950;font-size:13px}.milestone-icon{position:relative;z-index:1;width:58px;height:58px;margin:0 auto 14px;border:1px solid #dbe2ef;border-radius:50%;background:#fff;display:grid;place-items:center;color:#2d59c8;font-size:25px;box-shadow:0 5px 18px rgba(45,89,200,.1)}.milestone h3{color:var(--navy);margin:0 0 10px;font-size:16px}.milestone p{margin:0;color:#647083;line-height:1.5;font-size:12px}.history-photos{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;background:#fff}.history-photos img{width:100%;height:190px;object-fit:cover}.history-photos img:nth-child(2){object-position:center 38%}.stats-band{background:var(--navy);color:#fff}.stats-shell{display:grid;grid-template-columns:2.25fr repeat(4,1fr);gap:6px;align-items:stretch;padding:34px!important}.stats-copy{padding:0 26px 0 0;align-self:center}.stats-copy .label{color:#4b72dc;margin-bottom:10px}.stats-copy h2{color:#fff;font-size:25px;line-height:1.2;letter-spacing:-.035em;margin:0 0 12px}.stats-copy p{margin:0;color:#cbd5e7;line-height:1.55;font-size:13px}.stat{min-height:170px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.025);padding:20px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}.stat i{font-style:normal;color:#cbd5e7;font-size:29px;line-height:1;margin-bottom:12px}.stat strong{font-size:31px;line-height:1;display:block;color:#fff}.stat span{color:#d8e0ef;display:block;margin-top:7px;line-height:1.35;font-size:13px}.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px}.principle{background:#f7f8fb;border:1px solid var(--line);padding:22px}.principle b{display:block;color:var(--navy);margin-bottom:8px}.principle p{font-size:14px!important}.values{grid-template-columns:repeat(5,1fr)}.closing-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.certs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px}.cert{border:1px solid var(--line);padding:18px;text-align:center}.cert i{display:grid;place-items:center;width:48px;height:48px;border:2px solid var(--green);color:var(--green);font-style:normal;font-weight:950;margin:0 auto 12px}.coverage img{width:100%;max-height:260px;object-fit:contain;margin-top:18px}
    @media(max-width:980px){.menu{display:none}.about-hero,.policy-grid,.closing-grid{grid-template-columns:1fr}.about-copy{min-height:520px}.about-media{min-height:520px}.cards,.footer-grid,.principles,.values{grid-template-columns:repeat(2,1fr)}.timeline{overflow-x:auto;grid-template-columns:repeat(5,210px)}.history-photos{grid-template-columns:repeat(5,210px);overflow-x:auto}.stats-shell{grid-template-columns:repeat(2,1fr)}.stats-copy{grid-column:1/-1}.about-copy{padding:48px}}@media(max-width:640px){.nav{height:auto;padding:18px;align-items:flex-start}.nav-actions .btn{display:none}.brand img{width:140px}.about-section{padding:0}.about-copy{min-height:500px;padding:38px 24px!important}.about-media{min-height:390px}.cards,.offer-list,.footer-grid,.principles,.values,.stats-shell,.certs{grid-template-columns:1fr}.section-head{display:block}.about-copy h1{font-size:38px}.footer-bottom{align-items:flex-start;flex-direction:column}}
    .mobile-menu{display:none}.mobile-menu summary{width:46px;height:46px;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;list-style:none;background:#fff}.mobile-menu summary::-webkit-details-marker{display:none}.hamburger,.hamburger:before,.hamburger:after{display:block;width:22px;height:2px;background:var(--navy);content:"";transition:.2s ease}.hamburger:before{transform:translateY(-7px)}.hamburger:after{transform:translateY(5px)}.mobile-menu[open] .hamburger{background:transparent}.mobile-menu[open] .hamburger:before{transform:translateY(2px) rotate(45deg)}.mobile-menu[open] .hamburger:after{transform:translateY(0) rotate(-45deg)}.mobile-panel{position:absolute;right:28px;top:calc(100% + 12px);width:min(88vw,360px);background:#fff;border:1px solid var(--line);box-shadow:0 22px 60px rgba(7,11,47,.18);padding:12px;display:grid;gap:4px}.mobile-panel a{padding:14px 16px;font-weight:850;color:#17203b}.mobile-panel a:hover{background:#f6f8fc;color:var(--orange-dark)}.mobile-panel .mobile-cta{margin-top:6px;background:var(--orange);color:#fff;text-align:center}@media(max-width:980px){.nav{position:relative}.nav-actions{display:none}.mobile-menu{display:block}}@media(max-width:640px){.nav{height:70px!important;padding:0 18px!important;align-items:center!important}.brand{min-width:0!important}.mobile-panel{right:18px}section{padding-left:20px!important;padding-right:20px!important}.field,.form-grid input,.form-grid select,.form-grid textarea{min-width:0;width:100%}.catalog-shell,.training-copy,.post-copy,.contact-copy,.about-copy,.product-copy{padding:24px!important}}
    .history-photo-placeholder{height:190px;display:grid;place-items:center;background:#e9edf4;color:#7b8597;font-size:18px;font-weight:900;letter-spacing:.12em}
    .cards{position:relative;grid-template-columns:1fr 1fr;padding:0 20%;background:linear-gradient(90deg,rgba(7,11,47,.28),transparent 22%,transparent 78%,rgba(7,11,47,.28)),url('/hero2.webp') center/cover no-repeat;gap:12px}.cards .card{min-height:190px;padding:28px 30px 25px 86px;box-shadow:none}.cards .card::before{position:absolute;margin-left:-58px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#315ed0;color:#fff;font-size:22px}.mission-card::before{content:'◎'}.vision-card::before{content:'◉'}.cards .card h2{font-size:19px;margin-bottom:10px}.cards .card p{font-size:12px;line-height:1.55}.policy-grid{grid-template-columns:1fr;margin-top:12px}.policy-card{display:grid;grid-template-columns:1.05fr 3fr;gap:30px;align-items:center;padding:32px}.policy-copy h2{font-size:30px}.policy-copy p{font-size:13px}.policy-card .principles{grid-template-columns:repeat(4,1fr);gap:0;margin:0}.policy-card .principle{min-height:170px;text-align:center;background:#fff;border:0;border-left:1px solid var(--line);padding:18px}.policy-card .principle i{display:grid;place-items:center;width:40px;height:40px;margin:0 auto 12px;border:2px solid #315ed0;border-radius:50%;color:#315ed0;font-style:normal;font-size:19px}.policy-card .principle b{font-size:14px}.policy-card .principle p{font-size:11px!important;line-height:1.5}.policy-img{display:none}
    @media(max-width:980px){.cards{padding:0;background:none}.policy-card{grid-template-columns:1fr}.policy-card .principles{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:640px){.cards{grid-template-columns:1fr}.cards .card{padding:28px 24px 28px 82px}.policy-card .principles{grid-template-columns:1fr}}
    .values-band{display:grid;grid-template-columns:210px 1fr;align-items:stretch;margin-top:18px;padding:0;box-shadow:none}.values-heading{display:flex;flex-direction:column;justify-content:center;padding:24px 20px 24px 28px}.values-heading .label,.closing-grid .label{color:#315ed0;font-size:10px;margin-bottom:8px}.values-heading h2{font-size:20px;line-height:1.08;letter-spacing:-.045em;margin:0}.values-band .values{gap:0;margin:0}.values-band .principle{min-height:144px;border:0;border-left:1px solid var(--line);background:#fff;padding:18px 14px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}.value-icon{width:32px;height:32px;margin-bottom:8px;color:#315ed0}.value-icon svg{width:100%;height:100%;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.values-band .principle b{font-size:13px;margin-bottom:7px}.values-band .principle p{max-width:130px;font-size:10px!important;line-height:1.4;color:#647083}
    .closing-grid{grid-template-columns:1fr 1.12fr;gap:0;margin-top:0;background:#fff;border:1px solid var(--line);border-top:0}.closing-grid>.card{min-height:290px;border:0;box-shadow:none;padding:28px 30px}.closing-grid>.card+article{border-left:1px solid var(--line)}.closing-grid h2{max-width:390px;font-size:25px;line-height:1.08;margin-bottom:8px}.closing-grid p{max-width:430px;font-size:11px;line-height:1.5}.certs{grid-template-columns:repeat(3,112px);gap:22px;margin-top:18px}.cert{border:0;padding:0}.cert i{width:62px;height:62px;border:3px solid currentColor;border-radius:50%;color:#315ed0;font-size:25px;margin-bottom:8px;box-shadow:inset 0 0 0 4px #fff,inset 0 0 0 6px currentColor}.cert:nth-child(2) i{color:#49a544}.cert:nth-child(3) i{color:#d52d3a}.cert b{display:block;color:var(--navy);font-size:11px}.cert small{display:block;margin-top:3px;color:#647083;font-size:8px;text-transform:uppercase}.coverage{display:grid;grid-template-columns:.88fr 1.12fr;grid-template-rows:auto 1fr;column-gap:18px}.coverage-copy{align-self:start}.coverage img{grid-column:2;grid-row:1/3;width:100%;height:235px;object-fit:contain;margin:0;align-self:center}.coverage-locations{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.coverage-locations span{font-size:8px;color:#5d6676}.coverage-locations span::before{content:'⌖';color:#315ed0;margin-right:3px}
    @media(max-width:980px){.values-band{grid-template-columns:1fr}.values-heading{padding:28px}.values-band .values{grid-template-columns:repeat(5,1fr)}.values-band .principle:first-child{border-left:0}.closing-grid{grid-template-columns:1fr}.closing-grid>.card+article{border-left:0;border-top:1px solid var(--line)}}
    @media(max-width:640px){.values-band .values{grid-template-columns:1fr 1fr}.values-band .principle{border-top:1px solid var(--line)}.closing-grid>.card{padding:26px 22px}.certs{grid-template-columns:repeat(3,1fr);gap:8px}.coverage{grid-template-columns:1fr}.coverage img{grid-column:1;grid-row:auto;height:230px;margin-top:18px}}
  </style>
</head>
<body id="top">
  <div class="topline"></div>
  <header class="site-header">
    <nav class="nav">
      <a class="brand" href="/"><img src="/etapel-logo.svg" alt="Etapel"></a>
      <div class="menu">
        <a href="/">Home</a><a href="/linea-de-producto">Línea de Producto</a><a href="/quienes-somos">¿Quiénes Somos?</a><a href="/capacitacion">Capacitación</a><a href="/postventa">Posventa</a><a href="/contacto">Contacto</a>
      </div>
      <div class="nav-actions"><a class="lang" href="/en/about-us" aria-label="Cambiar idioma a inglés">EN</a><a class="btn orange" href="/contacto#formulario-contacto">Solicitar información</a></div>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú"><span class="hamburger"></span></summary>
        <div class="mobile-panel">
          <a href="/">Home</a>
          <a href="/linea-de-producto">Línea de Producto</a>
          <a href="/quienes-somos">¿Quiénes Somos?</a>
          <a href="/capacitacion">Capacitación</a>
          <a href="/postventa">Posventa</a>
          <a href="/contacto">Contacto</a>
          <a href="/en/about-us" aria-label="Cambiar idioma a inglés">EN</a>
          <a class="mobile-cta" href="/contacto#formulario-contacto">Solicitar información</a>
        </div>
      </details>

    </nav>
  </header>

  <main>
    <section class="about-section">
      <div class="container">
        <div class="about-hero">
          <div class="about-copy">
            <h1>Más de tres décadas evolucionando con la industria mexicana.</h1>
            <p>Hemos crecido junto a las necesidades del sector automotriz e industrial de México, integrando tecnología, conocimiento y servicio para generar valor real en cada operación.</p>
            <div class="about-actions"><a class="btn orange" href="#historia">Conoce nuestra historia →</a><a class="btn ghost" href="/contacto">Contáctanos</a></div>
          </div>
          <div class="about-media" role="img" aria-label="Equipo Etapel devant ses installations"></div>
        </div>
      </div>
    </section>

    <section class="about-content">
      <div class="container">
        <div id="historia" class="section-head" style="margin-top:70px"><div><div class="label">Nuestra historia</div><h2>Tres décadas de crecimiento e innovación constante.</h2></div><p>Desde nuestros inicios hemos mantenido un compromiso firme con nuestros clientes y con la industria.</p></div>
        <div class="history-block">
          <div class="timeline"><article class="milestone"><span>1</span><div class="milestone-icon">⌂</div><h3>Nuestros inicios</h3><p>Nacimos para brindar soluciones técnicas y equipos de calidad al sector automotriz en México.</p></article><article class="milestone"><span>2</span><div class="milestone-icon">↗</div><h3>Crecimiento</h3><p>Ampliamos el portafolio y fortalecimos relaciones con marcas líderes.</p></article><article class="milestone"><span>3</span><div class="milestone-icon">⌖</div><h3>Expansión</h3><p>Llevamos experiencia a más regiones con soporte técnico especializado.</p></article><article class="milestone"><span>4</span><div class="milestone-icon">◇</div><h3>Nuevas líneas</h3><p>Integramos tecnología de vanguardia y nuevas soluciones.</p></article><article class="milestone"><span>5</span><div class="milestone-icon">⌁</div><h3>CDTECH y actualidad</h3><p>Impulsamos el conocimiento y seguimos evolucionando junto a la industria.</p></article></div>
          <div class="history-photos"><div class="history-photo-placeholder">FOTO 1</div><div class="history-photo-placeholder">FOTO 2</div><div class="history-photo-placeholder">FOTO 3</div><div class="history-photo-placeholder">FOTO 4</div><div class="history-photo-placeholder">FOTO 5</div></div>
        </div>

        <div class="stats-shell" style="margin-top:34px;background:var(--navy);padding:28px"><div class="stats-copy"><div class="label">Quiénes somos hoy</div><h2>Somos una empresa mexicana especializada en integrar tecnología, productos, conocimiento y servicio para mejorar operaciones automotrices e industriales.</h2><p>Nuestro propósito es ayudar a nuestros clientes a ser más productivos, seguros y competitivos mediante soluciones confiables, soporte experto y acompañamiento en cada etapa de su operación.</p></div><div class="stat"><i>▣</i><strong>+30</strong><span>años<br>de experiencia</span></div><div class="stat"><i>♙</i><strong>48+</strong><span>líneas<br>representadas</span></div><div class="stat"><i>⌂</i><strong>3</strong><span>sucursales<br>estratégicas</span></div><div class="stat"><i>⌖</i><strong>Cobertura<br>nacional</strong><span>en todo México</span></div></div>

        <div class="cards">
          <article class="card mission-card">
            <h2>Misión</h2>
            <p>Proveer soluciones integrales y confiables que combinen tecnología, conocimiento y servicio para optimizar los procesos de nuestros clientes y construir relaciones de largo plazo.</p>
          </article>
          <article class="card vision-card">
            <h2>Visión</h2>
            <p>Ser la empresa mexicana líder en soluciones tecnológicas e industriales, reconocida por nuestra innovación, calidad y compromiso con el desarrollo del país.</p>
          </article>
        </div>

        <div class="policy-grid">
          <article class="card policy-card">
            <div class="policy-copy"><div class="label">Nuestra política integral</div><h2>Nuestro compromiso con lo que importa.</h2><p>Trabajamos bajo un enfoque de gestión integral que asegura la calidad de nuestros procesos, la seguridad de las personas, el respeto al medio ambiente y la mejora continua.</p></div><div class="principles"><div class="principle"><i>⚙</i><b>Calidad</b><p>Cumplimos estándares para garantizar soluciones confiables.</p></div><div class="principle"><i>♢</i><b>Seguridad</b><p>Cuidamos la integridad de nuestro equipo y clientes.</p></div><div class="principle"><i>♧</i><b>Medio ambiente</b><p>Promovemos prácticas responsables.</p></div><div class="principle"><i>⌁</i><b>Mejora continua</b><p>Innovamos para superar expectativas.</p></div></div>
          </article>
          <div class="policy-img"><img src="/images/quienes-etapel-equipo.webp" alt="Instalaciones y equipo Etapel" loading="lazy"></div>
        </div>

        <article class="card wide values-band">
