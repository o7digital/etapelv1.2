---
import BackToTop from '../components/BackToTop.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>¿Quiénes Somos? | Etapel SA de CV</title>
  <meta name="description" content="Etapel SA de CV: empresa mexicana dedicada a soluciones automotrices, pintura, consumibles, herramientas, equipos mayores, mantenimiento e instalación." />
  <style>
    :root{--navy:#070b2f;--navy-2:#0b1145;--ink:#111827;--line:#e8edf5;--soft:#f5f7fb;--orange:#f58220;--orange-dark:#d96e12;--green:#559a17;--shadow:0 26px 70px rgba(7,11,47,.18);--shadow-soft:0 16px 44px rgba(7,11,47,.1);--max:1180px}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.topline{height:7px;background:linear-gradient(90deg,var(--green),var(--orange) 38%,var(--navy) 72%)}.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid rgba(7,11,47,.09);box-shadow:0 10px 28px rgba(7,11,47,.06)}.nav{max-width:var(--max);margin:0 auto;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:24px}.brand{min-width:190px}.brand img{width:168px}.menu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:700;color:#17203b;white-space:nowrap}.menu a:hover{color:var(--orange-dark)}.nav-actions{display:flex;align-items:center;gap:12px}.lang{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);font-weight:800;font-size:12px;color:var(--navy)}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid transparent;font-weight:850;font-size:14px;transition:.2s ease}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 14px 32px rgba(245,130,32,.28)}.btn.orange:hover{background:var(--orange-dark);transform:translateY(-1px)}
    main{background:linear-gradient(180deg,#fff 0%,#f6f8fc 100%)}section{padding:92px 28px}.container{max-width:var(--max);margin:0 auto}.label{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);margin-bottom:12px}.about-section{padding:0 28px 92px;background:#07101e}.about-section .container{max-width:1440px}.about-hero{display:grid;grid-template-columns:1fr 1fr;min-height:570px;background:#07101e;overflow:hidden}.about-copy{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center;padding:70px 8vw;background:linear-gradient(90deg,rgba(3,8,16,.98),rgba(3,8,16,.78)),url('/images/quienes-etapel-equipo.jpg') center/cover}.about-copy .label{color:#fff}.about-copy h1{max-width:650px;font-size:clamp(42px,4.3vw,66px);line-height:1.02;letter-spacing:-.055em;text-transform:uppercase;margin:0 0 20px;color:#fff}.about-copy p{max-width:610px;color:#eef3fb;line-height:1.58;font-size:16px}.about-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:28px}.btn.ghost{border-color:rgba(255,255,255,.7);color:#fff;background:rgba(3,8,16,.3)}.about-media{position:relative;min-height:570px;background:#101827}.about-media::after{content:"Orgullosamente\A Mexicana  🇲🇽";white-space:pre;position:absolute;right:24px;bottom:22px;padding:10px 15px;border:1px solid rgba(255,255,255,.75);border-radius:20px;color:#fff;background:rgba(3,8,16,.48);font-size:11px;text-align:center}.about-media img{width:100%;height:100%;object-fit:cover;object-position:center}.about-content{padding-top:0}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:34px}.card{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);padding:30px}.card.wide{grid-column:1/-1}.card h2{margin:0 0 14px;color:var(--navy);font-size:34px;letter-spacing:-.05em}.card p{margin:0;color:#647083;line-height:1.75}.policy-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;margin-top:18px}.policy-img{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);overflow:hidden}.policy-img img{width:100%;height:100%;min-height:360px;object-fit:cover}.offer-list{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.offer-list span{background:#f7f8fb;border:1px solid var(--line);padding:13px 14px;color:#26314f;font-weight:850;font-size:13px}.footer{padding:58px 28px 28px;background:linear-gradient(145deg,#050720 0%,var(--navy) 58%,#0b1145 100%);color:#d8e0ef}.footer-shell{max-width:var(--max);margin:0 auto}.footer-grid{display:grid;grid-template-columns:1.15fr .95fr .75fr .9fr;gap:36px}.footer img{width:150px;filter:brightness(0) invert(1)}.footer p{color:#aeb8cf;line-height:1.7}.footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:#fff;margin:0 0 18px}.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.footer a{color:#c8d2e5}.footer a:hover{color:#fff}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;color:#aeb8cf;font-size:13px}.footer-bottom-links{display:flex;gap:18px;flex-wrap:wrap}.footer-keywords{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);font-size:11px;line-height:1.8;color:#8f9ab2;text-align:center}
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:38px}.section-head h2{font-size:clamp(34px,4.2vw,56px);line-height:.98;letter-spacing:-.065em;margin:0;color:var(--navy)}.section-head p{max-width:480px;color:#647083;line-height:1.7}.history-block{background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-soft);overflow:hidden}.timeline{display:grid;grid-template-columns:repeat(5,1fr);padding:30px 26px 26px}.milestone{position:relative;text-align:center;padding:0 16px}.milestone::after{content:"";position:absolute;top:20px;left:calc(50% + 28px);width:calc(100% - 56px);border-top:2px dotted #c7cfdd}.milestone:last-child::after{display:none}.milestone>span{position:absolute;z-index:2;top:5px;left:8px;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#2d59c8;color:#fff;font-weight:950;font-size:13px}.milestone-icon{position:relative;z-index:1;width:58px;height:58px;margin:0 auto 14px;border:1px solid #dbe2ef;border-radius:50%;background:#fff;display:grid;place-items:center;color:#2d59c8;font-size:25px;box-shadow:0 5px 18px rgba(45,89,200,.1)}.milestone h3{color:var(--navy);margin:0 0 10px;font-size:16px}.milestone p{margin:0;color:#647083;line-height:1.5;font-size:12px}.history-photos{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;background:#fff}.history-photos img{width:100%;height:190px;object-fit:cover}.history-photos img:nth-child(2){object-position:center 38%}.stats-band{background:var(--navy);color:#fff}.stats-shell{display:grid;grid-template-columns:1.2fr repeat(4,1fr);gap:16px;align-items:stretch}.stats-copy h2{font-size:40px;line-height:1;letter-spacing:-.055em;margin:10px 0 14px}.stats-copy p{color:#cbd5e7;line-height:1.65}.stat{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);padding:24px}.stat strong{font-size:36px;display:block}.stat span{color:#b8c4d9;display:block;margin-top:8px;line-height:1.4}.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px}.principle{background:#f7f8fb;border:1px solid var(--line);padding:22px}.principle b{display:block;color:var(--navy);margin-bottom:8px}.principle p{font-size:14px!important}.values{grid-template-columns:repeat(5,1fr)}.closing-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.certs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px}.cert{border:1px solid var(--line);padding:18px;text-align:center}.cert i{display:grid;place-items:center;width:48px;height:48px;border:2px solid var(--green);color:var(--green);font-style:normal;font-weight:950;margin:0 auto 12px}.coverage img{width:100%;max-height:260px;object-fit:contain;margin-top:18px}
    @media(max-width:980px){.menu{display:none}.about-hero,.policy-grid,.closing-grid{grid-template-columns:1fr}.about-copy{min-height:520px}.about-media{min-height:520px}.cards,.footer-grid,.principles,.values{grid-template-columns:repeat(2,1fr)}.timeline{overflow-x:auto;grid-template-columns:repeat(5,210px)}.history-photos{grid-template-columns:repeat(5,210px);overflow-x:auto}.stats-shell{grid-template-columns:repeat(2,1fr)}.stats-copy{grid-column:1/-1}.about-copy{padding:48px}}@media(max-width:640px){.nav{height:auto;padding:18px;align-items:flex-start}.nav-actions .btn{display:none}.brand img{width:140px}.about-section{padding:0}.about-copy{min-height:500px;padding:38px 24px!important}.about-media{min-height:390px}.cards,.offer-list,.footer-grid,.principles,.values,.stats-shell,.certs{grid-template-columns:1fr}.section-head{display:block}.about-copy h1{font-size:38px}.footer-bottom{align-items:flex-start;flex-direction:column}}
    .mobile-menu{display:none}.mobile-menu summary{width:46px;height:46px;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;list-style:none;background:#fff}.mobile-menu summary::-webkit-details-marker{display:none}.hamburger,.hamburger:before,.hamburger:after{display:block;width:22px;height:2px;background:var(--navy);content:"";transition:.2s ease}.hamburger:before{transform:translateY(-7px)}.hamburger:after{transform:translateY(5px)}.mobile-menu[open] .hamburger{background:transparent}.mobile-menu[open] .hamburger:before{transform:translateY(2px) rotate(45deg)}.mobile-menu[open] .hamburger:after{transform:translateY(0) rotate(-45deg)}.mobile-panel{position:absolute;right:28px;top:calc(100% + 12px);width:min(88vw,360px);background:#fff;border:1px solid var(--line);box-shadow:0 22px 60px rgba(7,11,47,.18);padding:12px;display:grid;gap:4px}.mobile-panel a{padding:14px 16px;font-weight:850;color:#17203b}.mobile-panel a:hover{background:#f6f8fc;color:var(--orange-dark)}.mobile-panel .mobile-cta{margin-top:6px;background:var(--orange);color:#fff;text-align:center}@media(max-width:980px){.nav{position:relative}.nav-actions{display:none}.mobile-menu{display:block}}@media(max-width:640px){.nav{height:70px!important;padding:0 18px!important;align-items:center!important}.brand{min-width:0!important}.mobile-panel{right:18px}section{padding-left:20px!important;padding-right:20px!important}.field,.form-grid input,.form-grid select,.form-grid textarea{min-width:0;width:100%}.catalog-shell,.training-copy,.post-copy,.contact-copy,.about-copy,.product-copy{padding:24px!important}}
  </style>
</head>
<body id="top">
  <div class="topline"></div>
  <header class="site-header">
    <nav class="nav">
      <a class="brand" href="/"><img src="/etapel-logo.svg" alt="Etapel"></a>
      <div class="menu">
        <a href="/">Home</a><a href="/linea-de-producto">Línea de Producto</a><a href="/quienes-somos">¿Quiénes Somos?</a><a href="/capacitacion">Capacitación</a><a href="/postventa">Posventa</a><a href="/contacto">Contacto</a>
      </div>
      <div class="nav-actions"><a class="lang" href="/en/about-us" aria-label="Cambiar idioma a inglés">EN</a><a class="btn orange" href="/contacto#formulario-contacto">Solicitar información</a></div>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú"><span class="hamburger"></span></summary>
        <div class="mobile-panel">
          <a href="/">Home</a>
          <a href="/linea-de-producto">Línea de Producto</a>
          <a href="/quienes-somos">¿Quiénes Somos?</a>
          <a href="/capacitacion">Capacitación</a>
          <a href="/postventa">Posventa</a>
          <a href="/contacto">Contacto</a>
          <a href="/en/about-us" aria-label="Cambiar idioma a inglés">EN</a>
          <a class="mobile-cta" href="/contacto#formulario-contacto">Solicitar información</a>
        </div>
      </details>

    </nav>
  </header>

  <main>
    <section class="about-section">
      <div class="container">
        <div class="about-hero">
          <div class="about-copy">
            <h1>Más de tres décadas evolucionando con la industria mexicana.</h1>
            <p>Hemos crecido junto a las necesidades del sector automotriz e industrial de México, integrando tecnología, conocimiento y servicio para generar valor real en cada operación.</p>
            <div class="about-actions"><a class="btn orange" href="#historia">Conoce nuestra historia →</a><a class="btn ghost" href="/contacto">Contáctanos</a></div>
          </div>
          <div class="about-media"><img src="/images/quienes-grupo-cesvi.jpeg" alt="Equipo Etapel" loading="eager"></div>
        </div>
      </div>
    </section>

    <section class="about-content">
      <div class="container">
        <div id="historia" class="section-head" style="margin-top:70px"><div><div class="label">Nuestra historia</div><h2>Tres décadas de crecimiento e innovación constante.</h2></div><p>Desde nuestros inicios hemos mantenido un compromiso firme con nuestros clientes y con la industria.</p></div>
        <div class="history-block">
          <div class="timeline"><article class="milestone"><span>1</span><div class="milestone-icon">⌂</div><h3>Nuestros inicios</h3><p>Nacimos para brindar soluciones técnicas y equipos de calidad al sector automotriz en México.</p></article><article class="milestone"><span>2</span><div class="milestone-icon">↗</div><h3>Crecimiento</h3><p>Ampliamos el portafolio y fortalecimos relaciones con marcas líderes.</p></article><article class="milestone"><span>3</span><div class="milestone-icon">⌖</div><h3>Expansión</h3><p>Llevamos experiencia a más regiones con soporte técnico especializado.</p></article><article class="milestone"><span>4</span><div class="milestone-icon">◇</div><h3>Nuevas líneas</h3><p>Integramos tecnología de vanguardia y nuevas soluciones.</p></article><article class="milestone"><span>5</span><div class="milestone-icon">⌁</div><h3>CDTECH y actualidad</h3><p>Impulsamos el conocimiento y seguimos evolucionando junto a la industria.</p></article></div>
          <div class="history-photos"><img src="/images/postventa.webp" alt="Servicio técnico Etapel" loading="lazy"><img src="/images/contacto-etapel.webp" alt="Instalaciones Etapel" loading="lazy"><img src="/images/capacitacion-3.webp" alt="Capacitación Etapel" loading="lazy"><img src="/images/cabinas-preparacion.webp" alt="Tecnología de cabinas Etapel" loading="lazy"><img src="/images/quienes-etapel-equipo.jpg" alt="Equipo técnico Etapel" loading="lazy"></div>
        </div>

        <div class="stats-shell" style="margin-top:34px;background:var(--navy);padding:28px"><div class="stats-copy"><div class="label">Quiénes somos hoy</div><h2>Una empresa mexicana que integra tecnología, productos, conocimiento y servicio.</h2><p>Ayudamos a nuestros clientes a ser más productivos, seguros y competitivos.</p></div><div class="stat"><strong>+30</strong><span>Años de experiencia</span></div><div class="stat"><strong>48+</strong><span>Líneas representadas</span></div><div class="stat"><strong>3</strong><span>Sucursales estratégicas</span></div><div class="stat"><strong>MX</strong><span>Cobertura nacional</span></div></div>

        <div class="cards">
          <article class="card">
            <h2>Misión</h2>
            <p>Proveer soluciones integrales y confiables que combinen tecnología, conocimiento y servicio para optimizar los procesos de nuestros clientes y construir relaciones de largo plazo.</p>
          </article>
          <article class="card">
            <h2>Visión</h2>
            <p>Ser la empresa mexicana líder en soluciones tecnológicas e industriales, reconocida por nuestra innovación, calidad y compromiso con el desarrollo del país.</p>
          </article>
        </div>

        <div class="policy-grid">
          <article class="card">
            <div class="label">Nuestra política integral</div><h2>Nuestro compromiso con lo que importa.</h2><p>Trabajamos bajo un enfoque de gestión integral que asegura la calidad de nuestros procesos, la seguridad de las personas, el respeto al medio ambiente y la mejora continua.</p><div class="principles"><div class="principle"><b>Calidad</b><p>Cumplimos estándares para garantizar soluciones confiables.</p></div><div class="principle"><b>Seguridad</b><p>Cuidamos la integridad de nuestro equipo y clientes.</p></div><div class="principle"><b>Medio ambiente</b><p>Promovemos prácticas responsables.</p></div><div class="principle"><b>Mejora continua</b><p>Innovamos para superar expectativas.</p></div></div>
          </article>
          <div class="policy-img"><img src="/images/quienes-etapel-equipo.jpg" alt="Instalaciones y equipo Etapel" loading="lazy"></div>
        </div>

        <article class="card wide" style="margin-top:18px">
          <div class="label">Nuestros valores</div><h2>Cómo pensamos, cómo actuamos.</h2><div class="principles values"><div class="principle"><b>Calidad</b><p>Hacemos las cosas bien desde el primer contacto.</p></div><div class="principle"><b>Innovación</b><p>Buscamos tecnologías para ofrecer mejores soluciones.</p></div><div class="principle"><b>Servicio</b><p>Escuchamos, entendemos y acompañamos.</p></div><div class="principle"><b>Conocimiento</b><p>Compartimos experiencia y capacitamos.</p></div><div class="principle"><b>Compromiso</b><p>Asumimos cada reto como propio.</p></div></div>
        </article>

        <div class="closing-grid"><article class="card"><div class="label">Calidad certificada</div><h2>Gestión con estándares internacionales.</h2><p>Nuestro sistema de gestión integral está orientado a estándares de calidad, ambiente y seguridad.</p><div class="certs"><div class="cert"><i>✓</i><b>ISO 9001</b></div><div class="cert"><i>✓</i><b>ISO 14001</b></div><div class="cert"><i>✓</i><b>ISO 45001</b></div></div></article><article class="card coverage"><div class="label">Presencia nacional</div><h2>Una empresa mexicana con alcance nacional.</h2><p>Atendemos desde CDMX, Monterrey y Veracruz, con distribución en toda la República Mexicana.</p><img src="/images/mapa-etapel.webp" alt="Cobertura nacional Etapel" loading="lazy"></article></div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-shell">
      <div class="footer-grid">
        <div>
          <img src="/etapel-logo.svg" alt="Etapel" loading="lazy">
          <p>En Etapel, no somos solo proveedores, somos socios en el crecimiento de tu negocio.</p>
          <p>Descubre cómo podemos ayudarte a alcanzar nuevos niveles de éxito.</p>
        </div>
        <div>
          <h3>Línea de producto</h3>
          <ul>
            <li><a href="/linea-de-producto">Pintura</a></li>
            <li><a href="/linea-de-producto">Cabinas y Preparación</a></li>
            <li><a href="/linea-de-producto">Soldadura y Enderezado</a></li>
            <li><a href="/linea-de-producto">Mecánica y Aire</a></li>
          </ul>
        </div>
        <div>
          <h3>Servicios</h3>
          <ul>
            <li><a href="/capacitacion">Capacitación</a></li>
            <li><a href="/postventa">Posventa</a></li>
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <ul>
            <li><a href="mailto:ventas@etapel.com.mx">ventas@etapel.com.mx</a></li>
            <li><a href="tel:+525556895055">55 5689 5055</a></li>
            <li><a href="https://wa.link/oowyzu" target="_blank" rel="noreferrer">WhatsApp</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Copyright © 2026 Etapel. Todos los derechos reservados.</p>
        <div class="footer-bottom-links">
          <a href="/contacto">¿Necesitas ayuda? ¡Contáctanos!</a>
          <a href="/aviso-de-privacidad">Aviso de Privacidad</a>
          <a href="/en/about-us">English version</a>
        </div>
      </div>
      <div class="footer-keywords">
        quienes somos Etapel · Etapel SA de CV · proveedor automotriz CDMX · soluciones automotrices CDMX · equipo para taller CDMX · pintura automotriz CDMX
      </div>
    </div>
  </footer>
  <BackToTop />
</body>
</html>
